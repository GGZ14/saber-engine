// FN50: the MTP experts' MIXED table (Qwen's first-party fp8 routed experts + the bf16 shared
// expert). Each grouped GEMM is two launches over the same route tiles; the tile's scale pointer
// `xptr[2e + 1]` says which launch owns it (0 = bf16, the shared expert):
//   fn_moe_a8w8_bs128_mx_g{1,0}     FN6's W8A8 body, bf16 tiles exit
//   fn_moe_bgemm_sk_m16_mx_g{1,0}   FN6's bf16 split-K body, fp8 tiles exit
// One inserted line per body; a computed tile is the shipped symbol's bytes.
#include <hip/hip_runtime.h>
#include <hip/hip_bf16.h>
#include <stdint.h>

typedef __bf16 bf16x8 __attribute__((ext_vector_type(8)));
typedef float floatx8 __attribute__((ext_vector_type(8)));
__device__ __forceinline__ floatx8 vg_wmma(bf16x8 a, bf16x8 b, floatx8 c) {
  return __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32_gfx12(a, b, c);
}
#define FB_NW 4
#define FB_UNR 8

typedef unsigned int uint2_t __attribute__((ext_vector_type(2)));
typedef unsigned int uint4_t __attribute__((ext_vector_type(4)));
#define DG_BM   16
#define DG_BN  128
#define DG_BK  128
#define DG_NW    4
#define DG_NT  (DG_NW * 32)
__device__ __forceinline__ floatx8 dg_wmma(uint2_t a, uint2_t b, floatx8 c) {
  return __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(a, b, c);
}
__device__ __forceinline__ int dg_acc_row(int lane, int e) { return (lane >> 4) * 8 + e; }
__device__ __forceinline__ void dg_store_acc(const floatx8 &acc, __bf16 *__restrict__ c,
                                             int n0, int m0, int M, int N, long ldc, int lane) {
  const int col = n0 + (lane & 15);
  if (col >= N) return;
#pragma unroll
  for (int e = 0; e < 8; ++e) {
    const int row = m0 + dg_acc_row(lane, e);
    if (row < M) c[(long)row * ldc + col] = (__bf16)acc[e];
  }
}

// ============================== bf16 grouped, from fn_bgemm_sk_body
template <int MROWS, bool GATHER>
__device__ __forceinline__ void fn_moe_bgemm_sk_body(
    const __bf16 *__restrict__ a, const unsigned long long *__restrict__ xptr,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok,
    const int *__restrict__ meta, float *__restrict__ part, int *__restrict__ cnt,
    __bf16 *__restrict__ c, int n, int k, int rows_cap) {
  // ---- the tile (FN6, FN4's law): which expert, which rows ------------------------------------
  // (the dense body's own `tile` below is its arrival-counter index, blockIdx.y * gridDim.x +
  // blockIdx.x -- with blockIdx.y = the route tile it is already one counter per (tile, n-block))
  const int gt = (int)blockIdx.y;
  if (gt >= meta[0]) return;
  const int texp = tile_expert[gt], row0 = tile_row0[gt], m = tile_rows[gt];
  const __bf16 *__restrict__ w = (const __bf16 *)(uintptr_t)xptr[2 * (size_t)texp];
  if (xptr[2 * (size_t)texp + 1] != 0) return;   // FN50: an fp8 tile (the a8w8 mx launch's)
  constexpr int MF = MROWS / 16;
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int n0 = ((int)blockIdx.x * FB_NW + wave) * 16;
  const int m0 = 0;
  const int sp = (int)blockIdx.z, nsp = (int)gridDim.z;
  const int kw = k / nsp, kb = sp * kw;
  const int row = lane & 15, kh = (lane >> 4) * 8;
  __shared__ int s_last;
  const bool live = n0 < n;
  const __bf16 *ap[MF];
#pragma unroll
  for (int mf = 0; mf < MF; ++mf) ap[mf] = a + (long)(GATHER ? row_tok[row0 + min(m0 + mf * 16 + row, m - 1)]
                                         : row0 + min(m0 + mf * 16 + row, m - 1)) * k + kb + kh;
  const __bf16 *wp = w + (long)min(n0 + row, n - 1) * k + kb + kh;
  floatx8 acc[MF];
#pragma unroll
  for (int mf = 0; mf < MF; ++mf)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[mf][e] = 0.f;
  const int ksteps = live ? kw / 16 : 0;
  int ks = 0;
  for (; ks + FB_UNR <= ksteps; ks += FB_UNR) {
    bf16x8 af[MF][FB_UNR], wf[FB_UNR];
#pragma unroll
    for (int u = 0; u < FB_UNR; ++u) {
#pragma unroll
      for (int mf = 0; mf < MF; ++mf) af[mf][u] = *(const bf16x8 *)(ap[mf] + (ks + u) * 16);
      wf[u] = *(const bf16x8 *)(wp + (ks + u) * 16);
    }
#pragma unroll
    for (int u = 0; u < FB_UNR; ++u)
#pragma unroll
      for (int mf = 0; mf < MF; ++mf) acc[mf] = vg_wmma(af[mf][u], wf[u], acc[mf]);
  }
  for (; ks < ksteps; ++ks) {
    const bf16x8 wv = *(const bf16x8 *)(wp + ks * 16);
#pragma unroll
    for (int mf = 0; mf < MF; ++mf)
      acc[mf] = vg_wmma(*(const bf16x8 *)(ap[mf] + ks * 16), wv, acc[mf]);
  }
  const int col = n0 + (lane & 15);
  if (nsp == 1) {                                 // one slice: the band itself, no partials
    if (!live || col >= n) return;
#pragma unroll
    for (int mf = 0; mf < MF; ++mf)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int r = m0 + mf * 16 + (lane >> 4) * 8 + e;
        if (r < m) c[(long)(row0 + r) * n + col] = (__bf16)acc[mf][e];
      }
    return;
  }
  if (live && col < n) {
#pragma unroll
    for (int mf = 0; mf < MF; ++mf)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int r = m0 + mf * 16 + (lane >> 4) * 8 + e;
        if (r < m) part[((long)sp * rows_cap + row0 + r) * n + col] = acc[mf][e];
      }
  }
  __syncthreads();
  const int tile = (int)blockIdx.y * (int)gridDim.x + (int)blockIdx.x;
  if (tid == 0) {
    __threadfence();
    s_last = atomicAdd(&cnt[tile], 1) == nsp - 1;
  }
  __syncthreads();
  if (!s_last) return;
  if (tid == 0) cnt[tile] = 0;
  __threadfence();
  const int nb = (int)blockIdx.x * FB_NW * 16;
  const int ncols = min(FB_NW * 16, n - nb), nrows = min(MROWS, m - m0);
  for (int idx = tid; idx < nrows * ncols; idx += FB_NW * 32) {
    const int rl = idx / ncols, cc = nb + (idx - rl * ncols), r = m0 + rl;
    float v = part[(long)(row0 + r) * n + cc];
    for (int p = 1; p < nsp; ++p) v = v + part[((long)p * rows_cap + row0 + r) * n + cc];
    c[(long)(row0 + r) * n + cc] = (__bf16)v;
  }
}

extern "C" __global__ __launch_bounds__(FB_NW * 32) void fn_moe_bgemm_sk_m16_mx_g1(
    const __bf16 *__restrict__ a, const unsigned long long *__restrict__ xptr,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok, const int *__restrict__ meta,
    float *__restrict__ part, int *__restrict__ cnt, __bf16 *__restrict__ c, int n, int k,
    int rows_cap) {
  fn_moe_bgemm_sk_body<16, true>(a, xptr, tile_expert, tile_row0, tile_rows,
