    __bf16 *__restrict__ out, int *__restrict__ sync, int T, int Pmax, int tc,
    const float *__restrict__ tsh) {
  macfn7_back_impl<4, 2, false, -1>(A, As, xgu, xdn, tile_expert, tile_row0, tile_rows, row_tok, meta, Pgu, Pdn, cgu, cdn, GU, Q, QS, Y,
      topk_w, route_pos, wsg, bi, sg, out, sync, T, Pmax, tc, tsh, FarArgs{});
}

