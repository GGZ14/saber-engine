// GENERATED by tools/gen_fn151_nvfp4p1.py from moe_grouped_far.hip -- do not edit by hand.
// FN151: FN148's NVFP4 form (b) in the served `_p1` (PFD 1) class -- see the generator's docstring.
// The text up to `fn151_x_impl` is moe_grouped_far.hip's (helpers, verbatim; FN137b's header kept):
// (was) GENERATED by tools/gen_fn137b_far.py -- do not edit by hand, re-run the generator.
// FN137 Phase B (`--fn-moe-ar-push on`): the half-width fused back half with the MoE-out
// all-reduce fused into its combine slices. The text up to the FN137 marker below is
// `moe_grouped_tp2.hip` up to its first kernel wrapper, verbatim (generated by
// tools/gen_moe_grouped.py), so every helper lowers from the shipped text.
// GENERATED by tools/gen_moe_grouped.py -- do not edit by hand, re-run the deriver.
//
// FN80b-1: the TP=2 HALF-WIDTH expert cells (code object `moe_grouped_tp2`): the down half's
// grouped GEMM at DBK 64 (K 320) and the half-width fused back half. Everything below the
// wrappers is `moe_grouped`'s derived text (FN4 / FN26), unchanged; the half-width back half is
// FN26's at INTER 320 by anchored substitution.
//
// Flash-Next's grouped MXFP4 W4A8 GEMM (workstream FN4) and the expert-major silu-quant producer.
// The GEMM half is DERIVED MECHANICALLY from `mxfp4_gemm_decode.hip`'s own impl (the certified
// split-K decode body): renamed, the merged-linear partition select replaced by the tile lookup,
// the A row, the output row, the partial slab and the arrival counter read through the tile.
// Every line that decides a byte -- W staging, the MX fold, the WMMA loop, the slab partition, the
// fused reduce's order, the `acc * rf * As` epilogue -- is the decode kernel's, character for
// character, so a grouped row IS the dense kernel's row on that expert (the byte oracle,
// tools/capture/fn4/). The producer half is `silu_mul_quant`'s committed impl with its row an
// argument.
//
// The tile law (docs/EXEC.md section 11): the router/sort kernel (`moe_route.hip`) writes the
// routes expert-major, each expert's segment padded to 16 rows (a 16-row block owns ONE expert),
// and cuts each segment into tiles of up to 16*DTM rows. Tile t = (tile_expert[t], tile_row0[t],
// tile_rows[t] live rows); `meta[0]` = the live tile count (a static grid, the tail exits).
// `xptr[3*e + {0,1,2}]` = expert e's `w`, `ws`, `wref` device addresses (an EP rank's local
// experts, then the shared expert; the tier owns the table and may point a slot anywhere).
#include <hip/hip_runtime.h>
#include <hip/hip_bf16.h>
#include "mxfp4_common.h"

#define DEC_DWN 8   // waves per decode block; the N tile is DEC_DWN*16 = 128 wide
#define DEC_MTILE 16
#define DEC_PAD 8
static __device__ __forceinline__ unsigned int wq_dec(uint2_t v, int q) { return q ? v[1] : v[0]; }
template <bool NT, typename T>
static __device__ __forceinline__ T ld_w(const T *p) {
  if constexpr (NT) return __builtin_nontemporal_load(p);
  else return *p;
}

template <int DWN, int DBK, int DKS, int DTM, bool WPERM, bool GATHER, bool DIRECT = true,
          bool NT = false>
__device__ __forceinline__ void moe_grouped_w4a8_impl(
    const unsigned char *__restrict__ A, const unsigned long long *__restrict__ xptr,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok,
    const int *__restrict__ meta,
    const float *__restrict__ As, float *__restrict__ P, int *__restrict__ cnt,
    __bf16 *__restrict__ C, int N, int K, int Pmax) {
  constexpr int BND = DWN * 16;
  constexpr int DASTR = DBK + DEC_PAD, DWSTR = DBK + DEC_PAD;
  constexpr int DNTHREADS = DWN * 32;
  __shared__ unsigned char sA[DEC_MTILE * DTM * DASTR];
  __shared__ unsigned char sW[BND * DWSTR];
  __shared__ int s_last;
  __shared__ int s_arow[DEC_MTILE * DTM];

  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int col = lane & 15, kb8 = (lane >> 4) * 8;
  const int n0 = blockIdx.x * BND;
  const int ks = blockIdx.z;
  // ---- the tile (FN4): which expert, which rows. A tile past the live count exits whole (every
  // split of it alike, so its arrival counter is never touched).
  const int tile = blockIdx.y;
  if (tile >= meta[0]) return;
  const int texp = tile_expert[tile], row0 = tile_row0[tile];
  const int M = tile_rows[tile];
  const unsigned char *__restrict__ W =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 0];
  const unsigned char *__restrict__ Ws =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 1];
  const unsigned char *__restrict__ Wref =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 2];
  // The A row of tile row m: GATHER (gate_up) reads the token the route came from, compact (down)
  // reads the expert-major row itself. Clamped rows (m >= M) are never read: stage_a clamps to
  // M - 1 exactly as the dense kernel does.
  for (int r = tid; r < DEC_MTILE * DTM; r += DNTHREADS) {
    const int rr = r < M - 1 ? r : M - 1;
    s_arow[r] = GATHER ? row_tok[row0 + rr] : row0 + rr;
  }
  __syncthreads();

  const int slabs = (K + DBK - 1) / DBK;
  const int spb = (slabs + DKS - 1) / DKS;
  const int s_lo = ks * spb, s_hi = min(slabs, s_lo + spb);

  floatx8 acc[DTM];
#pragma unroll
  for (int i = 0; i < DTM; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0.f;

  // ---- per-slab pieces, shared by the three slab loops below ----
  constexpr int NITA = (DEC_MTILE * DTM * DBK + DNTHREADS * 16 - 1) / (DNTHREADS * 16);
  const unsigned char *arow_base[NITA];
#pragma unroll
  for (int i = 0; i < NITA; ++i) {
    const int idx = i * DNTHREADS * 16 + tid * 16;
    const int r = idx < DEC_MTILE * DTM * DBK ? idx / DBK : 0;
    const int rc = r < M - 1 ? r : M - 1;                  // clamp, never predicate
    arow_base[i] = A + (size_t)s_arow[rc] * K;
  }
  auto stage_a = [&](int k0) {
#pragma unroll
    for (int off = 0; off < DEC_MTILE * DTM * DBK; off += DNTHREADS * 16) {
      const int idx = off + tid * 16;
      if (idx < DEC_MTILE * DTM * DBK) {
        const int r = idx / DBK, c = idx % DBK;
        const int rc = r < M - 1 ? r : M - 1;                  // clamp, never predicate
        *(uint4_t *)(&sA[r * DASTR + c]) = *(const uint4_t *)(arow_base[off / (DNTHREADS * 16)] + k0 + c);
      }
    }
  };
  // Row-order (checkpoint layout) W staging from a packed 8-byte word per (iteration, thread).
  // getw(it, gc, c) supplies the word so the plain and line-group loops share the fold.
  constexpr int NITW = BND * DBK / 2 / (DNTHREADS * 8);
  auto stage_w_row = [&](int k0, auto &&getw) {
#pragma unroll
    for (int it = 0; it < NITW; ++it) {
      const int idx = it * DNTHREADS * 8 + tid * 8;
      const int r = idx / (DBK / 2), c = idx % (DBK / 2), gn = n0 + r;
      const int gc = gn < N - 1 ? gn : N - 1;                  // clamp, never predicate
      const unsigned long long packed = getw(it, gc, c);
      const int blk = (k0 + c * 2) / 32;
      int dsh = (int)Wref[gc] - (int)Ws[(size_t)blk * N + gc];
      dsh = dsh < 0 ? 0 : (dsh > 15 ? 15 : dsh);
      const unsigned int t0 = kMag[dsh][0], t1 = kMag[dsh][1];
      unsigned int outw[4];
#pragma unroll
      for (int h = 0; h < 2; ++h) {
        const unsigned int wv = (unsigned int)(packed >> (32 * h));
        const unsigned int ev = wv & 0x0F0F0F0Fu;
        const unsigned int od = (wv >> 4) & 0x0F0F0F0Fu;
        const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u)
                              | ((ev & 0x08080808u) << 4);
        const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u)
                              | ((od & 0x08080808u) << 4);
        outw[2 * h]     = __builtin_amdgcn_perm(bo, be, 0x05010400u);
        outw[2 * h + 1] = __builtin_amdgcn_perm(bo, be, 0x07030602u);
      }
      *(uint4_t *)(&sW[r * DWSTR + c * 2]) = uint4_t{outw[0], outw[1], outw[2], outw[3]};
    }
  };
  auto stage_w_wperm = [&](int k0) {
    if constexpr (WPERM) {
      // Fragment order, as in the folded kernel: consecutive threads take consecutive uint32, so
      // a wave's weight read is 128 contiguous bytes instead of sixteen rows K/2 bytes apart.
      // TWO lane slots per thread (an 8 B request), the width the int4 twin measured optimal
      // (4 B was 11% slower there; 16 B identical). Adjacent slots are adjacent rows at the same
      // k, exactly as in the folded kernel above.
      constexpr int KSTEPS_T = DBK / 16, NTILES_T = BND / 16;
      const unsigned int *__restrict__ Wp = (const unsigned int *)W;
      const int ksteps_g = K / 16, kstep0 = k0 / 16;
#pragma unroll
      for (int off = 0; off < NTILES_T * KSTEPS_T * 32; off += DNTHREADS * 2) {
        const int sl = off + tid * 2;                   // first of the pair; always even
        const int lane_ = sl & 31, rest = sl >> 5;
        const int kst = rest % KSTEPS_T, ntl = rest / KSTEPS_T;
        const int r = ntl * 16 + (lane_ & 15), kloc = kst * 16 + (lane_ >> 4) * 8;
        const int gn = n0 + r;
        // Clamp, never predicate; gn is always even here and N % 16 == 0 under WPERM, so
        // clamping to the last even row keeps the uint2 read 8-byte aligned and gc + 1 in
        // bounds; the fragment address is recomputed from the clamped row.
        const int gc = gn < N - 2 ? gn : N - 2;
        const int lanec = (lane_ & 16) | (gc & 15);
        const uint2_t wv = ld_w<NT>(
            (const uint2_t *)&Wp[((size_t)(gc >> 4) * ksteps_g + kstep0 + kst) * 32 + lanec]);
        const int blk = (k0 + kst * 16) / 32;
#pragma unroll
        for (int q = 0; q < 2; ++q) {
          int d = (int)Wref[gc + q] - (int)Ws[(size_t)blk * N + gc + q];
          d = d < 0 ? 0 : (d > 15 ? 15 : d);
          const unsigned int t0 = kMag[d][0], t1 = kMag[d][1];
          const unsigned int ev = wq_dec(wv, q) & 0x0F0F0F0Fu;
          const unsigned int od = (wq_dec(wv, q) >> 4) & 0x0F0F0F0Fu;
          const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u)
                                | ((ev & 0x08080808u) << 4);
          const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u)
                                | ((od & 0x08080808u) << 4);
          *(uint2_t *)(&sW[(r + q) * DWSTR + kloc]) =
              uint2_t{__builtin_amdgcn_perm(bo, be, 0x05010400u),
                      __builtin_amdgcn_perm(bo, be, 0x07030602u)};
        }
      }
    }
  };
  auto mma_slab = [&]() {
    __syncthreads();
#pragma unroll
    for (int step = 0; step < DBK / 16; ++step) {
      const int kk = step * 16 + kb8;
      int2_t af[DTM], wf;
#pragma unroll
      for (int i = 0; i < DTM; ++i) {
        const unsigned char *pa = &sA[(i * 16 + col) * DASTR + kk];
        af[i][0] = *(const int *)pa; af[i][1] = *(const int *)(pa + 4);
      }
      const unsigned char *pw = &sW[(wave * 16 + col) * DWSTR + kk];
      wf[0] = *(const int *)pw; wf[1] = *(const int *)(pw + 4);
#pragma unroll
      for (int i = 0; i < DTM; ++i)
        acc[i] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(af[i], wf, acc[i]);
    }
    __syncthreads();
  };

  if constexpr (WPERM) {
    for (int s = s_lo; s < s_hi; ++s) {
      const int k0 = s * DBK;
      stage_a(k0);
      stage_w_wperm(k0);
      mma_slab();
    }
  } else {
    for (int s = s_lo; s < s_hi; ++s) {
      const int k0 = s * DBK;
      stage_a(k0);
      stage_w_row(k0, [&](int, int gc, int c) {
        return ld_w<NT>((const unsigned long long *)(W + ((size_t)gc * K + k0) / 2 + c));
      });
      mma_slab();
    }
  }

  const int n = n0 + wave * 16 + col;

  // At DKS==1 the accumulator already holds the whole K range, so the partial buffer, the
  // threadfence, the atomic and the reduction pass are all pure overhead -- and that overhead is
  // not small. Partial traffic is DKS*M*N floats: constant in the weight stream but LINEAR IN M,
  // 11.1 MB against gate_up's 44.6 MB of weights at M=40 and 17.8 MB at M=64. Picking DKS by shape
  // and by M is the launcher's job (split_k_for below); this is the path that makes DKS==1 free.
  // Bit-identical to the DKS==1 reduction path, which summed a single term -- the DIRECT=false
  // instantiation exists so that equivalence can be tested rather than asserted.
  if constexpr (DKS == 1 && DIRECT) {
    if (n < N) {
      const float rf = __int_as_float((int)Wref[n] << 23);
#pragma unroll
      for (int i = 0; i < DTM; ++i)
#pragma unroll
        for (int e = 0; e < 8; ++e) {
          const int m = i * 16 + kb8 + e;
          if (m < M) C[(size_t)(row0 + m) * N + n] = (__bf16)(acc[i][e] * rf * As[s_arow[m]]);
        }
    }
    return;
  }

  if (n < N) {
#pragma unroll
    for (int i = 0; i < DTM; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int m = i * 16 + kb8 + e;
        if (m < M) P[((size_t)ks * Pmax + row0 + m) * N + n] = acc[i][e];
      }
  }

  // Fused reduction. The DKS blocks covering one n-range race on an atomic counter and whoever
  // arrives last reduces in place, so there is no second kernel launch -- 13,376 of them per
  // decode run in the profile, at a 4.5 us mean host gap. It is also faster in pure kernel time
  // (-5.5% on gate_up to -29% on gdn.out) because the partials are still in cache when the
  // reduction reads them. The last block resets the counter, leaving it zeroed for the next
  // launch; launches on one stream are serialised, so no separate clearing pass is needed.
  __syncthreads();
  if (tid == 0) {
    __threadfence();
    s_last = (atomicAdd(&cnt[(size_t)tile * gridDim.x + blockIdx.x], 1) == DKS - 1);
  }
  __syncthreads();
  if (!s_last) return;
  if (tid == 0) cnt[(size_t)tile * gridDim.x + blockIdx.x] = 0;

  const int nhi = min(n0 + BND, N);
  for (int nn = n0 + tid; nn < nhi; nn += DNTHREADS) {
    const float rf = __int_as_float((int)Wref[nn] << 23);
    for (int m = 0; m < M; ++m) {
      float sum = 0.f;
      for (int k = 0; k < DKS; ++k) sum += P[((size_t)k * Pmax + row0 + m) * N + nn];
      C[(size_t)(row0 + m) * N + nn] = (__bf16)(sum * rf * As[s_arow[m]]);
    }
  }
}




// ---------------------------------------------------------------- the producer's preamble
#define ARNQ_T 256
typedef unsigned int uint32_tt;
union ArnqVec8 { uint4 u4; __bf16 h[8]; };


// ================================================================ FN26: the decode TRAIN
// DERIVED by tools/gen_moe_grouped.py `derive_train` (workstream FN26). (1) the grouped impl with
// the workgroup's coordinates as arguments, its LDS from an arena, and (PFD 1) the slab loop
// double-buffered in registers -- same slabs, same fold, same LDS images, same WMMA chain, same
// split-K reduce, so the same bytes as the shipped cells; (2) the MoE block's back half (shared
// gate GEMV, gate_up, silu-quant, down, combine) as ONE launch chained by device counters.
template <int DWN, int DTM>
__host__ __device__ constexpr int mx_lds_bytes() {
  return DEC_MTILE * DTM * (128 + DEC_PAD) + DWN * 16 * (128 + DEC_PAD) + 4 * DEC_MTILE * DTM + 16;
}
struct mx_nowait {
  __device__ __forceinline__ void operator()() const {}
};
struct mx_nobar {
  __device__ __forceinline__ void operator()() const {}
};
// FN84 (D): does a wait hook ask the PFD 1 loop to stream slab s_lo + 1's W words before it waits
// (FN84's `mo_wait<true>` of a RAM tile's down workgroup)? Every shipped hook: no (constant false,
// the shipped loop's code).
template <typename F>
static __device__ __forceinline__ constexpr bool mx_pre2(const F &) { return false; }
// FN31 (PFD 2): a GLOBAL load (a flat one also counts on DScnt) and an LDS-scope barrier (a
// `__syncthreads()` is a workgroup release fence = `s_wait_loadcnt 0` on gfx12 WGP mode).
template <bool NT, typename T>
static __device__ __forceinline__ T mx_ldg(const T *p) {
  const __attribute__((address_space(1))) T *g = (const __attribute__((address_space(1))) T *)p;
  if constexpr (NT) return __builtin_nontemporal_load(g);
  else return *g;
}
static __device__ __forceinline__ void mx_lds_barrier() {
  __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
  __builtin_amdgcn_s_barrier();
  __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
}


// ---------------------------------------------------------------- FN151
template <int V> struct fn151_ic { static constexpr int value = V; };
template <int DBK, int DTM>
__host__ __device__ constexpr int fn151_lds_bytes() {
  return DEC_MTILE * DTM * (DBK + DEC_PAD) + DEC_DWN * 16 * (DBK + DEC_PAD) + 4 * DEC_MTILE * DTM + 16;
}
template <int SC, int DWN, int DBK, int DKS, int DTM, bool WPERM, bool GATHER, bool DIRECT,
          bool NT, int PFD, typename WaitF>
__device__ __forceinline__ void fn151_x_impl(
    const unsigned char *__restrict__ A, const unsigned long long *__restrict__ xptr,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok,
    const int *__restrict__ meta,
    const float *__restrict__ As, float *__restrict__ P, int *__restrict__ cnt,
    __bf16 *__restrict__ C, int N, int K, int Pmax, int gsplit, unsigned char *__restrict__ smem,
    const int vbx, const int vby, const int vbz, const int vgx, WaitF &&wait) {
  constexpr int BND = DWN * 16;
  constexpr int DASTR = DBK + DEC_PAD, DWSTR = DBK + DEC_PAD;
  constexpr int DNTHREADS = DWN * 32;
  unsigned char *const sA = smem;
  unsigned char *const sW = smem + DEC_MTILE * DTM * DASTR;
  int *const s_arow = (int *)(smem + DEC_MTILE * DTM * DASTR + BND * DWSTR);
  int &s_last = *(int *)(smem + DEC_MTILE * DTM * DASTR + BND * DWSTR + 4 * DEC_MTILE * DTM);

  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int col = lane & 15, kb8 = (lane >> 4) * 8;
  const int n0 = vbx * BND;
  const int ks = vbz;
  // ---- the tile (FN4): which expert, which rows. A tile past the live count exits whole (every
  // split of it alike, so its arrival counter is never touched).
  const int tile = vby;
  if (tile >= meta[0]) return;
  const int texp = tile_expert[tile], row0 = tile_row0[tile];
  const int M = tile_rows[tile];
  const unsigned char *__restrict__ W =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 0];
  const unsigned char *__restrict__ Ws =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 1];
  const float *__restrict__ Gs = (const float *)(uintptr_t)xptr[3 * (size_t)texp + 2];
  // The A row of tile row m: GATHER (gate_up) reads the token the route came from, compact (down)
  // reads the expert-major row itself. Clamped rows (m >= M) are never read: stage_a clamps to
  // M - 1 exactly as the dense kernel does.
  for (int r = tid; r < DEC_MTILE * DTM; r += DNTHREADS) {
    const int rr = r < M - 1 ? r : M - 1;
    s_arow[r] = GATHER ? row_tok[row0 + rr] : row0 + rr;
  }
  __syncthreads();

  const int slabs = (K + DBK - 1) / DBK;
  const int spb = (slabs + DKS - 1) / DKS;
  const int s_lo = ks * spb, s_hi = min(slabs, s_lo + spb);

  floatx8 acc[DTM];
#pragma unroll
  for (int i = 0; i < DTM; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0.f;

  // ---- per-slab pieces, shared by the three slab loops below ----
  constexpr int NITA = (DEC_MTILE * DTM * DBK + DNTHREADS * 16 - 1) / (DNTHREADS * 16);
  const unsigned char *arow_base[NITA];
#pragma unroll
  for (int i = 0; i < NITA; ++i) {
    const int idx = i * DNTHREADS * 16 + tid * 16;
    const int r = idx < DEC_MTILE * DTM * DBK ? idx / DBK : 0;
    const int rc = r < M - 1 ? r : M - 1;                  // clamp, never predicate
    arow_base[i] = A + (size_t)s_arow[rc] * K;
  }
  static_assert(WPERM && PFD == 1, "FN151: the _p1 (WPERM, PFD 1) body only");
  constexpr int KSTEPS_P = DBK / 16, NTILES_P = BND / 16;
  constexpr int NWI = NTILES_P * KSTEPS_P * 32 / (DNTHREADS * 2);
  static_assert(NWI * DNTHREADS * 2 == NTILES_P * KSTEPS_P * 32, "WPERM slot pairs tile the block");
  static_assert(KSTEPS_P == 4 || KSTEPS_P == 8, "FN151: bk 64 / 128");
  // FN151: the slab's E4M3 g16 scale bytes, [BND rows][KSTEPS_P groups] (SC bit 1 clear).
  __shared__ __attribute__((aligned(8))) unsigned char s_sc151[BND * KSTEPS_P];
  const unsigned int *__restrict__ Wp = (const unsigned int *)W;
  const int ksteps_g = K / 16;
  const int ncol = n0 + wave * 16 + col < N - 1 ? n0 + wave * 16 + col : N - 1;
  auto pf_load_w = [&](int k0, uint2_t (&wv)[NWI], unsigned int (&ws2)[NWI]) {
    const int kstep0 = k0 / 16;
#pragma unroll
    for (int it = 0; it < NWI; ++it) {
      const int sl = it * DNTHREADS * 2 + tid * 2;
      const int lane_ = sl & 31, rest = sl >> 5;
      const int kst = rest % KSTEPS_P, ntl = rest / KSTEPS_P;
      const int r = ntl * 16 + (lane_ & 15);
      const int gn = n0 + r;
      const int gc = gn < N - 2 ? gn : N - 2;
      const int lanec = (lane_ & 16) | (gc & 15);
      const uint2_t *pw_ = (const uint2_t *)&Wp[((size_t)(gc >> 4) * ksteps_g + kstep0 + kst) * 32 + lanec];
      const unsigned short *ps_ = (const unsigned short *)&Ws[(size_t)(kstep0 + kst) * N + gc];
      if constexpr ((SC & 4) != 0) {   // global (address-space-1) loads: LOADcnt only, never DScnt
        wv[it] = mx_ldg<NT>(pw_);
        if constexpr ((SC & 2) == 0) ws2[it] = (unsigned int)mx_ldg<false>(ps_);
      } else {
        wv[it] = ld_w<NT>(pw_);
        if constexpr ((SC & 2) == 0) ws2[it] = (unsigned int)*ps_;
      }
    }
  };
  auto pf_load_s = [&](int k0, unsigned int (&sr)[KSTEPS_P / 4]) {
    if constexpr ((SC & 2) != 0) {
      const int kstep0 = k0 / 16;
#pragma unroll
      for (int j = 0; j < KSTEPS_P / 4; ++j) {
        unsigned int v = 0;
#pragma unroll
        for (int b = 0; b < 4; ++b)
          v |= (unsigned int)((SC & 4) != 0 ? mx_ldg<false>(&Ws[(size_t)(kstep0 + 4 * j + b) * N + ncol])
                                            : Ws[(size_t)(kstep0 + 4 * j + b) * N + ncol]) << (8 * b);
        sr[j] = v;
      }
    }
  };
  auto pf_load_a = [&](int k0, uint4_t (&av)[NITA]) {
#pragma unroll
    for (int i = 0; i < NITA; ++i) {
      const int idx = i * DNTHREADS * 16 + tid * 16;
      if constexpr ((SC & 4) != 0)   // unpredicated (arow_base of a spare slot = row 0): no execz join
        av[i] = mx_ldg<false>((const uint4_t *)(arow_base[i] + k0 + idx % DBK));
      else if (idx < DEC_MTILE * DTM * DBK) av[i] = *(const uint4_t *)(arow_base[i] + k0 + idx % DBK);
    }
  };
  // SC bit 2: the slab barriers are LDS-scope (FN31's PFD 2 barrier: no release drain of the prefetch)
  auto bar = [&]() {
    if constexpr ((SC & 4) != 0) mx_lds_barrier();
    else __syncthreads();
  };
  auto pf_put = [&](const uint2_t (&wv)[NWI], const unsigned int (&ws2)[NWI],
                    const uint4_t (&av)[NITA]) {
#pragma unroll
    for (int i = 0; i < NITA; ++i) {
      const int idx = i * DNTHREADS * 16 + tid * 16;
      if (idx < DEC_MTILE * DTM * DBK) {
        const int r = idx / DBK, c = idx % DBK;
        *(uint4_t *)(&sA[r * DASTR + c]) = av[i];
      }
    }
    // the plain e2m1 magnitudes as e4m3 bytes (the d = 0 row of the fold table): constant, no table read
    const unsigned int t0 = 0x3c383000u, t1 = 0x4c484440u;
#pragma unroll
    for (int it = 0; it < NWI; ++it) {
      const int sl = it * DNTHREADS * 2 + tid * 2;
      const int lane_ = sl & 31, rest = sl >> 5;
      const int kst = rest % KSTEPS_P, ntl = rest / KSTEPS_P;
      const int r = ntl * 16 + (lane_ & 15), kloc = kst * 16 + (lane_ >> 4) * 8;
#pragma unroll
      for (int q = 0; q < 2; ++q) {
        const unsigned int ev = wq_dec(wv[it], q) & 0x0F0F0F0Fu;
        const unsigned int od = (wq_dec(wv[it], q) >> 4) & 0x0F0F0F0Fu;
        const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u)
                              | ((ev & 0x08080808u) << 4);
        const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u)
                              | ((od & 0x08080808u) << 4);
        *(uint2_t *)(&sW[(r + q) * DWSTR + kloc]) =
            uint2_t{__builtin_amdgcn_perm(bo, be, 0x05010400u),
                    __builtin_amdgcn_perm(bo, be, 0x07030602u)};
      }
      if constexpr ((SC & 2) == 0) {
        if ((lane_ & 16) == 0) {   // the k-half 0 slot of a (row pair, group) writes its two scale bytes
          s_sc151[r * KSTEPS_P + kst] = (unsigned char)(ws2[it] & 0xFFu);
          s_sc151[(r + 1) * KSTEPS_P + kst] = (unsigned char)((ws2[it] >> 8) & 0xFFu);
        }
      }
    }
  };
  // One slab: NE live accumulator elements (the ladder; NE == 8 = FN148's chain op for op).
  auto mma_slab = [&](auto ne_c, const unsigned int (&sr)[KSTEPS_P / 4]) {
    constexpr int NE = decltype(ne_c)::value;
    constexpr int NT_ = NE == 8 ? DTM : 1;   // NE < 8 => M <= 4: the tiles i >= 1 are wholly dead
    bar();
    unsigned int scw[KSTEPS_P / 4];
    if constexpr ((SC & 2) == 0) {
      if constexpr (KSTEPS_P == 8) {
        const uint2_t v = *(const uint2_t *)&s_sc151[(wave * 16 + col) * 8];
        scw[0] = v[0];
        scw[1] = v[1];
      } else {
        scw[0] = *(const unsigned int *)&s_sc151[(wave * 16 + col) * 4];
      }
    } else {
#pragma unroll
      for (int j = 0; j < KSTEPS_P / 4; ++j) scw[j] = sr[j];
    }
#pragma unroll
    for (int step = 0; step < DBK / 16; ++step) {
      const int kk = step * 16 + kb8;
      int2_t af[DTM], wf;
#pragma unroll
      for (int i = 0; i < NT_; ++i) {
        const unsigned char *pa = &sA[(i * 16 + col) * DASTR + kk];
        af[i][0] = *(const int *)pa; af[i][1] = *(const int *)(pa + 4);
      }
      const unsigned char *pw = &sW[(wave * 16 + col) * DWSTR + kk];
      wf[0] = *(const int *)pw; wf[1] = *(const int *)(pw + 4);
      const float scv = __builtin_amdgcn_cvt_f32_fp8((int)(scw[step >> 2] >> (8 * (step & 3))), 0);
      const floatx8 z = {0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f};
#pragma unroll
      for (int i = 0; i < NT_; ++i) {
        const floatx8 t = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(af[i], wf, z);
#pragma unroll
        for (int e = 0; e < NE; ++e) acc[i][e] = __builtin_fmaf(t[e], scv, acc[i][e]);
      }
    }
    bar();
  };
  auto run = [&](auto ne_c) {
    uint2_t wv0[NWI], wv1[NWI];
    unsigned int ws0[NWI], ws1[NWI];
    unsigned int sr0[KSTEPS_P / 4], sr1[KSTEPS_P / 4];
    uint4_t av0[NITA], av1[NITA];
#pragma unroll
    for (int i = 0; i < NITA; ++i) {
      av0[i] = uint4_t{0u, 0u, 0u, 0u};
      av1[i] = av0[i];
    }
#pragma unroll
    for (int j = 0; j < KSTEPS_P / 4; ++j) sr0[j] = sr1[j] = 0u;
#pragma unroll
    for (int it = 0; it < NWI; ++it) ws0[it] = ws1[it] = 0u;
    if (s_lo < s_hi) { pf_load_w(s_lo * DBK, wv0, ws0); pf_load_s(s_lo * DBK, sr0); }
    const bool pre2 = mx_pre2(wait) && s_lo + 1 < s_hi;
    if (pre2) { pf_load_w((s_lo + 1) * DBK, wv1, ws1); pf_load_s((s_lo + 1) * DBK, sr1); }
    wait();
    if (s_lo < s_hi) pf_load_a(s_lo * DBK, av0);
    for (int s = s_lo; s < s_hi; s += 2) {
      const bool m1 = s + 1 < s_hi;
      if (m1) {
        if (!pre2 || s != s_lo) { pf_load_w((s + 1) * DBK, wv1, ws1); pf_load_s((s + 1) * DBK, sr1); }
        pf_load_a((s + 1) * DBK, av1);
      }
      pf_put(wv0, ws0, av0);
      mma_slab(ne_c, sr0);
      if (!m1) break;
      if (s + 2 < s_hi) {
        pf_load_w((s + 2) * DBK, wv0, ws0);
        pf_load_s((s + 2) * DBK, sr0);
        pf_load_a((s + 2) * DBK, av0);
      }
      pf_put(wv1, ws1, av1);
      mma_slab(ne_c, sr1);
    }
  };
  if constexpr ((SC & 1) != 0) {
    if (M <= 1) run(fn151_ic<1>{});
    else if (M <= 2) run(fn151_ic<2>{});
    else if (M <= 4) run(fn151_ic<4>{});
    else run(fn151_ic<8>{});
  } else {
    run(fn151_ic<8>{});
  }
  const int n = n0 + wave * 16 + col;

  // At DKS==1 the accumulator already holds the whole K range, so the partial buffer, the
  // threadfence, the atomic and the reduction pass are all pure overhead -- and that overhead is
  // not small. Partial traffic is DKS*M*N floats: constant in the weight stream but LINEAR IN M,
  // 11.1 MB against gate_up's 44.6 MB of weights at M=40 and 17.8 MB at M=64. Picking DKS by shape
  // and by M is the launcher's job (split_k_for below); this is the path that makes DKS==1 free.
  // Bit-identical to the DKS==1 reduction path, which summed a single term -- the DIRECT=false
  // instantiation exists so that equivalence can be tested rather than asserted.
  if constexpr (DKS == 1 && DIRECT) {
    if (n < N) {
      const float rf = Gs[n < gsplit ? 0 : 1];
#pragma unroll
      for (int i = 0; i < DTM; ++i)
#pragma unroll
        for (int e = 0; e < 8; ++e) {
          const int m = i * 16 + kb8 + e;
          if (m < M) C[(size_t)(row0 + m) * N + n] = (__bf16)(acc[i][e] * rf * As[s_arow[m]]);
        }
    }
    return;
  }

  if (n < N) {
#pragma unroll
    for (int i = 0; i < DTM; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int m = i * 16 + kb8 + e;
        if (m < M) P[((size_t)ks * Pmax + row0 + m) * N + n] = acc[i][e];
      }
  }

  // Fused reduction. The DKS blocks covering one n-range race on an atomic counter and whoever
  // arrives last reduces in place, so there is no second kernel launch -- 13,376 of them per
  // decode run in the profile, at a 4.5 us mean host gap. It is also faster in pure kernel time
  // (-5.5% on gate_up to -29% on gdn.out) because the partials are still in cache when the
  // reduction reads them. The last block resets the counter, leaving it zeroed for the next
  // launch; launches on one stream are serialised, so no separate clearing pass is needed.
  __syncthreads();
  if (tid == 0) {
    __threadfence();
    s_last = (atomicAdd(&cnt[(size_t)tile * vgx + vbx], 1) == DKS - 1);
  }
  __syncthreads();
  if (!s_last) return;
  if (tid == 0) cnt[(size_t)tile * vgx + vbx] = 0;

  const int nhi = min(n0 + BND, N);
  for (int nn = n0 + tid; nn < nhi; nn += DNTHREADS) {
    const float rf = Gs[nn < gsplit ? 0 : 1];
    for (int m = 0; m < M; ++m) {
      float sum = 0.f;
      for (int k = 0; k < DKS; ++k) sum += P[((size_t)k * Pmax + row0 + m) * N + nn];
      C[(size_t)(row0 + m) * N + nn] = (__bf16)(sum * rf * As[s_arow[m]]);
    }
  }
}

// ---------------------------------------------------------------- FN151: the grouped cells
extern "C" __global__ __launch_bounds__(256) void fn151_w4a8b_bk128_ks1_tm1_g1(
    const unsigned char *__restrict__ A, const unsigned long long *__restrict__ xptr,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok,
    const int *__restrict__ meta, const float *__restrict__ As, float *__restrict__ P,
    int *__restrict__ cnt, __bf16 *__restrict__ C, int N, int K, int Pmax, int gsplit) {
  __shared__ __attribute__((aligned(16))) unsigned char smem[fn151_lds_bytes<128, 1>()];
  fn151_x_impl<1, DEC_DWN, 128, 1, 1, true, true, true, true, 1>(
      A, xptr, tile_expert, tile_row0, tile_rows, row_tok, meta, As, P, cnt, C, N, K, Pmax, gsplit, smem,
      (int)blockIdx.x, (int)blockIdx.y, (int)blockIdx.z, (int)gridDim.x, mx_nowait{});
}
