static __device__ __forceinline__ float fn148_e4m3_f32(unsigned char b) {
  return __uint_as_float(kFn148E4m3[b]);
}
// The forms' convert: v_cvt_f32_fp8 (exact for every OCP e4m3 byte; the byte law vs the table-built twin checks it).
static __device__ __forceinline__ float fn148_e4m3_hw(unsigned char b) {
  return __builtin_amdgcn_cvt_f32_fp8((int)b, 0);
}
// The per-row shift r of FORM (c): the largest r with 6 * E4M3(mb) * 2^r <= 448 (mb = the max scale byte,
// sign masked); 0 for an all-zero row. Exact: the f32 exponent then one compare of an exact power-of-two scaling.
static __device__ __forceinline__ int fn148_row_shift(int mb) {
  const float v = 6.f * fn148_e4m3_f32((unsigned char)mb);
  if (!(v > 0.f)) return 0;
  int r = 8 - (int)((__float_as_uint(v) >> 23) & 0xFF) + 127;   // v is a normal f32 (>= 6 * 2^-9)
  if (__builtin_ldexpf(v, r) > 448.f) r -= 1;
  return r;
}
static __device__ __forceinline__ int fn148_ri(int r, int bnd) { return r < 0 ? 0 : (r >= bnd ? bnd - 1 : r); }
// The 8 magnitude bytes of a (row, 16-k group): FORM 1 = the plain e2m1 codes (kMag[0]); FORM 2 =
// e4m3_rne(m_i * E4M3(s) * 2^r) by the hardware convert (exact products: m_i * s has <= 5 significant bits).
template <int FORM>
static __device__ __forceinline__ void fn148_table(unsigned char sb, int r, unsigned int &t0, unsigned int &t1) {
  if constexpr (FORM == 1) {
    t0 = kMag[0][0];
    t1 = kMag[0][1];
  } else {
    const float s = __builtin_ldexpf(fn148_e4m3_hw(sb), r);
    int w0 = __builtin_amdgcn_cvt_pk_fp8_f32(0.f, 0.5f * s, 0, false);
    w0 = __builtin_amdgcn_cvt_pk_fp8_f32(s, 1.5f * s, w0, true);
    int w1 = __builtin_amdgcn_cvt_pk_fp8_f32(2.f * s, 3.f * s, 0, false);
    w1 = __builtin_amdgcn_cvt_pk_fp8_f32(4.f * s, 6.f * s, w1, true);
    t0 = (unsigned int)w0;
    t1 = (unsigned int)w1;
  }
}
// FORM 2 undoes its row shift (an exact power of two) before the global / the partial.
template <int FORM>
static __device__ __forceinline__ float fn148_pre(float v, const int *s_rsh, int r, int bnd) {
  if constexpr (FORM == 2) return __builtin_ldexpf(v, -s_rsh[fn148_ri(r, bnd)]);
  else return v;
}

static __device__ __forceinline__ unsigned int wq_dec(uint2_t v, int q) { return q ? v[1] : v[0]; }
template <bool NT, typename T>
static __device__ __forceinline__ T ld_w(const T *p) {
  if constexpr (NT) return __builtin_nontemporal_load(p);
  else return *p;
}

template <int FORM, int DWN, int DBK, int DKS, int DTM, bool WPERM, bool GATHER, bool DIRECT = true,
          bool NT = false>
__device__ __forceinline__ void fn148_nvfp4_impl(
    const unsigned char *__restrict__ A, const unsigned long long *__restrict__ xptr,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok,
    const int *__restrict__ meta,
    const float *__restrict__ As, float *__restrict__ P, int *__restrict__ cnt,
    __bf16 *__restrict__ C, int N, int K, int Pmax, int gsplit) {
  static_assert(WPERM, "FN148: the v2 record's w is in permute_w order");
  static_assert(FORM == 1 || FORM == 2, "FN148: FORM 1 = (b), 2 = (c)");
  constexpr int BND = DWN * 16;
  constexpr int DASTR = DBK + DEC_PAD, DWSTR = DBK + DEC_PAD;
  constexpr int DNTHREADS = DWN * 32;
  __shared__ unsigned char sA[DEC_MTILE * DTM * DASTR];
  __shared__ unsigned char sW[BND * DWSTR];
  __shared__ int s_last;
  __shared__ int s_arow[DEC_MTILE * DTM];

  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int col = lane & 15, kb8 = (lane >> 4) * 8;
  const int n0 = blockIdx.x * BND;
  const int ks = blockIdx.z;
  // ---- the tile (FN4): which expert, which rows. A tile past the live count exits whole (every
  // split of it alike, so its arrival counter is never touched).
  const int tile = blockIdx.y;
  if (tile >= meta[0]) return;
  const int texp = tile_expert[tile], row0 = tile_row0[tile];
  const int M = tile_rows[tile];
  const unsigned char *__restrict__ W =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 0];
  const unsigned char *__restrict__ Ws =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 1];
  const float *__restrict__ Gs = (const float *)(uintptr_t)xptr[3 * (size_t)texp + 2];
  // The A row of tile row m: GATHER (gate_up) reads the token the route came from, compact (down)
  // reads the expert-major row itself. Clamped rows (m >= M) are never read: stage_a clamps to
  // M - 1 exactly as the dense kernel does.
  for (int r = tid; r < DEC_MTILE * DTM; r += DNTHREADS) {
    const int rr = r < M - 1 ? r : M - 1;
    s_arow[r] = GATHER ? row_tok[row0 + rr] : row0 + rr;
  }
  __syncthreads();

  const int slabs = (K + DBK - 1) / DBK;
  const int spb = (slabs + DKS - 1) / DKS;
  const int s_lo = ks * spb, s_hi = min(slabs, s_lo + spb);
  __shared__ int s_rsh[BND];   // FORM 2: the split's per-row shift r
  if constexpr (FORM == 2) {
    static_assert(DNTHREADS % (BND / 4) == 0, "FN148: the shift pass's thread map");
    const int g_lo = s_lo * (DBK / 16), g_hi = min(K / 16, s_hi * (DBK / 16));
    const int c4 = (tid % (BND / 4)) * 4, gq = tid / (BND / 4);   // 4 rows a thread, 8 groups a pass
    const int nr4 = n0 + c4 < N - 4 ? n0 + c4 : N - 4;              // N % 4 == 0 (u32 aligned)
    unsigned int m0 = 0, m1 = 0, m2 = 0, m3 = 0;
#pragma unroll 4
    for (int g = g_lo + gq; g < g_hi; g += DNTHREADS / (BND / 4)) {
      const unsigned int w = *(const unsigned int *)&Ws[(size_t)g * N + nr4];
      m0 = max(m0, w & 0x7Fu); m1 = max(m1, (w >> 8) & 0x7Fu);
      m2 = max(m2, (w >> 16) & 0x7Fu); m3 = max(m3, (w >> 24) & 0x7Fu);
    }
    // the 8-way max goes through sW (free until the first W stage, behind the barriers below)
    static_assert((DNTHREADS / (BND / 4)) * BND <= BND * DWSTR, "FN148: the max scratch fits sW");
    unsigned char *s_mx = sW;
    s_mx[gq * BND + c4] = (unsigned char)m0; s_mx[gq * BND + c4 + 1] = (unsigned char)m1;
    s_mx[gq * BND + c4 + 2] = (unsigned char)m2; s_mx[gq * BND + c4 + 3] = (unsigned char)m3;
    __syncthreads();
    int r = 0;
    if (tid < BND) {
      unsigned int mb = 0;
#pragma unroll
      for (int j = 0; j < DNTHREADS / (BND / 4); ++j) mb = max(mb, (unsigned int)s_mx[j * BND + tid]);
      r = fn148_row_shift((int)mb);
    }
    __syncthreads();
    if (tid < BND) s_rsh[tid] = r;
    __syncthreads();
  }

  floatx8 acc[DTM];
#pragma unroll
  for (int i = 0; i < DTM; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0.f;

  // ---- per-slab pieces, shared by the three slab loops below ----
  constexpr int NITA = (DEC_MTILE * DTM * DBK + DNTHREADS * 16 - 1) / (DNTHREADS * 16);
  const unsigned char *arow_base[NITA];
#pragma unroll
  for (int i = 0; i < NITA; ++i) {
    const int idx = i * DNTHREADS * 16 + tid * 16;
    const int r = idx < DEC_MTILE * DTM * DBK ? idx / DBK : 0;
    const int rc = r < M - 1 ? r : M - 1;                  // clamp, never predicate
    arow_base[i] = A + (size_t)s_arow[rc] * K;
  }
  auto stage_a = [&](int k0) {
#pragma unroll
    for (int off = 0; off < DEC_MTILE * DTM * DBK; off += DNTHREADS * 16) {
      const int idx = off + tid * 16;
      if (idx < DEC_MTILE * DTM * DBK) {
        const int r = idx / DBK, c = idx % DBK;
        const int rc = r < M - 1 ? r : M - 1;                  // clamp, never predicate
        *(uint4_t *)(&sA[r * DASTR + c]) = *(const uint4_t *)(arow_base[off / (DNTHREADS * 16)] + k0 + c);
      }
    }
  };
  auto stage_w_wperm = [&](int k0) {
    if constexpr (WPERM) {
      // Fragment order, as in the folded kernel: consecutive threads take consecutive uint32, so
      // a wave's weight read is 128 contiguous bytes instead of sixteen rows K/2 bytes apart.
      // TWO lane slots per thread (an 8 B request), the width the int4 twin measured optimal
      // (4 B was 11% slower there; 16 B identical). Adjacent slots are adjacent rows at the same
      // k, exactly as in the folded kernel above.
      constexpr int KSTEPS_T = DBK / 16, NTILES_T = BND / 16;
      const unsigned int *__restrict__ Wp = (const unsigned int *)W;
      const int ksteps_g = K / 16, kstep0 = k0 / 16;
#pragma unroll
      for (int off = 0; off < NTILES_T * KSTEPS_T * 32; off += DNTHREADS * 2) {
        const int sl = off + tid * 2;                   // first of the pair; always even
        const int lane_ = sl & 31, rest = sl >> 5;
        const int kst = rest % KSTEPS_T, ntl = rest / KSTEPS_T;
        const int r = ntl * 16 + (lane_ & 15), kloc = kst * 16 + (lane_ >> 4) * 8;
        const int gn = n0 + r;
        // Clamp, never predicate; gn is always even here and N % 16 == 0 under WPERM, so
        // clamping to the last even row keeps the uint2 read 8-byte aligned and gc + 1 in
        // bounds; the fragment address is recomputed from the clamped row.
        const int gc = gn < N - 2 ? gn : N - 2;
        const int lanec = (lane_ & 16) | (gc & 15);
        const uint2_t wv = ld_w<NT>(
            (const uint2_t *)&Wp[((size_t)(gc >> 4) * ksteps_g + kstep0 + kst) * 32 + lanec]);
        const int grp = kstep0 + kst;   // the NVFP4 16-k group
#pragma unroll
        for (int q = 0; q < 2; ++q) {
          unsigned int t0, t1;
          fn148_table<FORM>(Ws[(size_t)grp * N + gc + q], s_rsh[fn148_ri(gc + q - n0, BND)], t0, t1);
          const unsigned int ev = wq_dec(wv, q) & 0x0F0F0F0Fu;
          const unsigned int od = (wq_dec(wv, q) >> 4) & 0x0F0F0F0Fu;
          const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u)
                                | ((ev & 0x08080808u) << 4);
          const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u)
                                | ((od & 0x08080808u) << 4);
          *(uint2_t *)(&sW[(r + q) * DWSTR + kloc]) =
              uint2_t{__builtin_amdgcn_perm(bo, be, 0x05010400u),
                      __builtin_amdgcn_perm(bo, be, 0x07030602u)};
        }
      }
    }
  };
  const int ncol = n0 + wave * 16 + col < N - 1 ? n0 + wave * 16 + col : N - 1;
  auto mma_slab = [&](int k0) {
    float scv[DBK / 16];
    if constexpr (FORM == 1) {
#pragma unroll
      for (int step = 0; step < DBK / 16; ++step)
        scv[step] = fn148_e4m3_hw(Ws[(size_t)(k0 / 16 + step) * N + ncol]);
    }
    __syncthreads();
#pragma unroll
    for (int step = 0; step < DBK / 16; ++step) {
      const int kk = step * 16 + kb8;
      int2_t af[DTM], wf;
#pragma unroll
      for (int i = 0; i < DTM; ++i) {
        const unsigned char *pa = &sA[(i * 16 + col) * DASTR + kk];
        af[i][0] = *(const int *)pa; af[i][1] = *(const int *)(pa + 4);
      }
      const unsigned char *pw = &sW[(wave * 16 + col) * DWSTR + kk];
      wf[0] = *(const int *)pw; wf[1] = *(const int *)(pw + 4);
      if constexpr (FORM == 1) {
        const floatx8 z = {0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f};
#pragma unroll
        for (int i = 0; i < DTM; ++i) {
          const floatx8 t = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(af[i], wf, z);
#pragma unroll
          for (int e = 0; e < 8; ++e) acc[i][e] = __builtin_fmaf(t[e], scv[step], acc[i][e]);
        }
      } else {
#pragma unroll
      for (int i = 0; i < DTM; ++i)
        acc[i] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(af[i], wf, acc[i]);
      }
    }
    __syncthreads();
  };

  if constexpr (WPERM) {
    for (int s = s_lo; s < s_hi; ++s) {
      const int k0 = s * DBK;
      stage_a(k0);
      stage_w_wperm(k0);
      mma_slab(k0);
    }
  }

  const int n = n0 + wave * 16 + col;

  // At DKS==1 the accumulator already holds the whole K range, so the partial buffer, the
  // threadfence, the atomic and the reduction pass are all pure overhead -- and that overhead is
  // not small. Partial traffic is DKS*M*N floats: constant in the weight stream but LINEAR IN M,
  // 11.1 MB against gate_up's 44.6 MB of weights at M=40 and 17.8 MB at M=64. Picking DKS by shape
  // and by M is the launcher's job (split_k_for below); this is the path that makes DKS==1 free.
  // Bit-identical to the DKS==1 reduction path, which summed a single term -- the DIRECT=false
  // instantiation exists so that equivalence can be tested rather than asserted.
  if constexpr (DKS == 1 && DIRECT) {
    if (n < N) {
      const float rf = Gs[n < gsplit ? 0 : 1];
#pragma unroll
      for (int i = 0; i < DTM; ++i)
#pragma unroll
        for (int e = 0; e < 8; ++e) {
          const int m = i * 16 + kb8 + e;
          if (m < M) C[(size_t)(row0 + m) * N + n] = (__bf16)(fn148_pre<FORM>(acc[i][e], s_rsh, n - n0, BND) * rf * As[s_arow[m]]);
        }
    }
    return;
  }

  if (n < N) {
#pragma unroll
    for (int i = 0; i < DTM; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int m = i * 16 + kb8 + e;
        if (m < M) P[((size_t)ks * Pmax + row0 + m) * N + n] = fn148_pre<FORM>(acc[i][e], s_rsh, n - n0, BND);
      }
  }

  // Fused reduction. The DKS blocks covering one n-range race on an atomic counter and whoever
  // arrives last reduces in place, so there is no second kernel launch -- 13,376 of them per
  // decode run in the profile, at a 4.5 us mean host gap. It is also faster in pure kernel time
  // (-5.5% on gate_up to -29% on gdn.out) because the partials are still in cache when the
  // reduction reads them. The last block resets the counter, leaving it zeroed for the next
  // launch; launches on one stream are serialised, so no separate clearing pass is needed.
  __syncthreads();
  if (tid == 0) {
    __threadfence();
    s_last = (atomicAdd(&cnt[(size_t)tile * gridDim.x + blockIdx.x], 1) == DKS - 1);
  }
  __syncthreads();
  if (!s_last) return;
  if (tid == 0) cnt[(size_t)tile * gridDim.x + blockIdx.x] = 0;

  const int nhi = min(n0 + BND, N);
  for (int nn = n0 + tid; nn < nhi; nn += DNTHREADS) {
    const float rf = Gs[nn < gsplit ? 0 : 1];
    for (int m = 0; m < M; ++m) {
      float sum = 0.f;
      for (int k = 0; k < DKS; ++k) sum += P[((size_t)k * Pmax + row0 + m) * N + nn];
      C[(size_t)(row0 + m) * N + nn] = (__bf16)(sum * rf * As[s_arow[m]]);
    }
  }
}

// ---------------------------------------------------------------- THE ORACLE (exact fp32 dequant, W4A16)
// C[row0 + m, n] = bf16( sum_k A[arow(m), k] * ((e2m1(code(n, k)) * E4M3(ws[k/16, n])) * gs[n >= gsplit]) ),
// K in order, every product and sum its own IEEE op (the object builds with -ffp-contract=off).
__device__ __constant__ float kFn148E2M1[16] = {0.f,  0.5f,  1.f,  1.5f,  2.f,  3.f,  4.f,  6.f,
                                                -0.f, -0.5f, -1.f, -1.5f, -2.f, -3.f, -4.f, -6.f};
template <bool GATHER>
__device__ __forceinline__ void fn148_a16_impl(
    const __bf16 *__restrict__ A, const unsigned long long *__restrict__ xptr,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok,
    const int *__restrict__ meta, __bf16 *__restrict__ C, int N, int K, int gsplit) {
  const int tile = blockIdx.y;
  if (tile >= meta[0]) return;
  const int texp = tile_expert[tile], row0 = tile_row0[tile], M = tile_rows[tile];
  const int n = blockIdx.x * 16 + (threadIdx.x & 15);
  const int m = 16 * blockIdx.z + (threadIdx.x >> 4);
  if (m >= M) return;
  const unsigned char *W = (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 0];
  const unsigned char *Ws = (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 1];
  const float *Gs = (const float *)(uintptr_t)xptr[3 * (size_t)texp + 2];
  const float gs = Gs[n < gsplit ? 0 : 1];
  const int arow = GATHER ? row_tok[row0 + m] : row0 + m;
  const __bf16 *a = A + (size_t)arow * K;
  const int KS = K / 16, nt = n >> 4, nr = n & 15;
  float acc = 0.f, sc = 0.f;
  for (int k = 0; k < K; ++k) {
    if ((k & 15) == 0) sc = fn148_e4m3_f32(Ws[(size_t)(k >> 4) * N + n]);
    const size_t off = ((((size_t)nt * KS + (k >> 4)) * 2 + ((k >> 3) & 1)) * 16 + nr) * 4 + ((k & 7) >> 1);
    const int code = (W[off] >> ((k & 1) * 4)) & 0xF;
    const float w = (kFn148E2M1[code] * sc) * gs;
    acc = acc + (float)a[k] * w;
  }
  C[(size_t)(row0 + m) * N + n] = (__bf16)acc;
}
#define FN148_A16(name, G)                                                                          \
  extern "C" __global__ __launch_bounds__(256) void name(                                         \
      const __bf16 *__restrict__ A, const unsigned long long *__restrict__ xptr,                  \
      const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,                     \
      const int *__restrict__ tile_rows, const int *__restrict__ row_tok,                         \
      const int *__restrict__ meta, __bf16 *__restrict__ C, int N, int K, int gsplit) {           \
    fn148_a16_impl<G>(A, xptr, tile_expert, tile_row0, tile_rows, row_tok, meta, C, N, K, gsplit); \
  }
FN148_A16(fn148_a16_nvfp4_ref_g1, true)
FN148_A16(fn148_a16_nvfp4_ref_g0, false)
#undef FN148_A16

