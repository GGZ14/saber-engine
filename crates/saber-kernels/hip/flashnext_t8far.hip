// Flash-Next (FN141): the W8 GEMM's k-tile loop as a register ring. `fn141_t8_a8w8_n64_pf<PF>_ldc`
// takes `fn111_t8_a8w8_n64_ldc`'s arguments and grid and writes the same bytes.
#include <hip/hip_runtime.h>
#include <hip/hip_bf16.h>

typedef float floatx8 __attribute__((ext_vector_type(8)));
typedef unsigned int uint2_t __attribute__((ext_vector_type(2)));
typedef unsigned int uint4_t __attribute__((ext_vector_type(4)));
typedef __bf16 bf16x8 __attribute__((ext_vector_type(8)));

// ============================================================ fp8 W8A8 block-scale (dflash_gemm)
#define DG_BM 16
#define DG_BN 128
#define DG_BK 128
#define DG_NW 4
#define DG_NT (DG_NW * 32)

__device__ __forceinline__ floatx8 dg_wmma(uint2_t a, uint2_t b, floatx8 c) {
  return __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(a, b, c);
}
__device__ __forceinline__ int dg_acc_row(int lane, int e) { return (lane >> 4) * 8 + e; }

__device__ __forceinline__ void dg_store_acc(const floatx8 &acc, __bf16 *__restrict__ c,
                                             int n0, int m0, int M, int N, long ldc, int lane) {
  const int col = n0 + (lane & 15);
  if (col >= N) return;
#pragma unroll
  for (int e = 0; e < 8; ++e) {
    const int row = m0 + dg_acc_row(lane, e);
    if (row < M) c[(long)row * ldc + col] = (__bf16)acc[e];
  }
}

template <int BM, int BN, int BK, int NW>
__device__ __forceinline__ void t8_gemm_a8w8_impl(
    const unsigned char *__restrict__ A,   // [M, K] e4m3, row-major
    const unsigned char *__restrict__ W,   // [N/16, K*16] e4m3, preshuffled
    const float *__restrict__ As,          // [M, K/128] fp32 block scales
    const float *__restrict__ Ws,          // [N/128, K/128] fp32 block scales
    __bf16 *__restrict__ C,                // [M, ldc] bf16 (columns 0..N)
    int M, int N, int K, long LDC) {
  constexpr int NT = NW * 32;
  constexpr int NFRAG = BN / 16;
  constexpr int KSTEP = BK / 16;
  constexpr int MYF = NFRAG / NW;
  constexpr int ACH = BM * BK / 16 / NT;
  constexpr int LDA = BK + 8;
  __shared__ unsigned char sA[BM * LDA];
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int n0 = blockIdx.x * BN;
  const int m0 = (int)blockIdx.y * BM;
  if (m0 >= M) return;
  const int ktiles = K / BK;

  floatx8 acc[MYF];
#pragma unroll
  for (int i = 0; i < MYF; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0.f;

  const unsigned char *bbase = W + ((long)(n0 / 16) + wave) * (long)K * 16
                               + (long)(lane & 15) * 16 + (long)(lane >> 4) * 8;
  typedef uint2_t bfrag_t[MYF][KSTEP];
  bfrag_t b0, b1;
  uint4_t abuf[ACH];
  auto fetch_b = [&](bfrag_t &dst, int kt) {
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int ks = 0; ks < KSTEP; ++ks)
        dst[i][ks] = *(const uint2_t *)(bbase + (long)i * NW * K * 16
                                        + ((long)kt * KSTEP + ks) * 256);
  };
  auto fetch_a = [&](int kt) {
#pragma unroll
    for (int i = 0; i < ACH; ++i) {
      const int off = (tid + i * NT) * 16;
      const int r = off / BK, c = off % BK;
      const int gr = m0 + r;
      const int rc = gr < M ? gr : M - 1;
      abuf[i] = *(const uint4_t *)(A + (long)rc * K + kt * BK + c);
    }
  };
  auto step = [&](int kt, bfrag_t &cur, bfrag_t &nxt) {
#pragma unroll
    for (int i = 0; i < ACH; ++i) {
      const int off = (tid + i * NT) * 16;
      *(uint4_t *)(&sA[(off / BK) * LDA + off % BK]) = abuf[i];
    }
    __syncthreads();
    if (kt + 1 < ktiles) {
      fetch_b(nxt, kt + 1);
      fetch_a(kt + 1);
    }
    floatx8 tile[MYF];
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) tile[i][e] = 0.f;
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int ks = 0; ks < KSTEP; ++ks) {
        const uint2_t av =
            *(const uint2_t *)(&sA[(lane & 15) * LDA + ks * 16 + (lane >> 4) * 8]);
        tile[i] = dg_wmma(av, cur[i][ks], tile[i]);
      }
    __syncthreads();
    const float bs = Ws[(long)(n0 / 128) * (K / 128) + kt];
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int row = m0 + dg_acc_row(lane, e);
        const float as = row < M ? As[(long)row * (K / 128) + kt] : 0.f;
        acc[i][e] += tile[i][e] * (as * bs);
      }
  };

  fetch_b(b0, 0);
  fetch_a(0);
  int kt = 0;
  for (; kt + 1 < ktiles; kt += 2) {
    step(kt, b0, b1);
    step(kt + 1, b1, b0);
  }
  if (kt < ktiles) step(kt, b0, b1);

#pragma unroll
  for (int i = 0; i < MYF; ++i)
    dg_store_acc(acc[i], C, n0 + (wave + i * NW) * 16, m0, M, N, LDC, lane);
}



// ============================================================ bf16, one split (flashnext_hc)
__device__ __forceinline__ floatx8 vg_wmma(bf16x8 a, bf16x8 b, floatx8 c) {
  return __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32_gfx12(a, b, c);
}
#define FB_NW 4
#define FB_UNR 8


// ============================================================ FN86b family 4: quant + bf16 suffix
// `dflash_act_quant_g128` (dflash_mlp.hip's DQ_BODY: one wave per 128-group, 4 bf16 a lane, amax
// by a max butterfly, sc = max(amax / 448, 1 / (448 x 512)) a REAL division, clamp, the same
// convert) and `fn_t8_bgemm_m16_ldc` (above, line for line) as ONE launch over the SAME input `a`:
// workgroups [0, nqb) are the quant's grid, [nqb, nqb + nbx x nby) the suffix GEMM's (x fastest).
// Both parents run 128 threads and the default contraction (this file's flags = dflash_mlp's);
// the two halves share nothing but the input, so each output is its parent's at the same M.
// `_rc` = the GATE CONTROL (the quant scale as a reciprocal multiply): must differ.
template <bool RC>
__device__ __forceinline__ void fn86_q8_g128_part(const __bf16 *__restrict__ x,
                                                  unsigned char *__restrict__ q,
                                                  float *__restrict__ scales, int t_rows, int n,
                                                  int bid) {
  typedef __bf16 bf16x4 __attribute__((ext_vector_type(4)));
  const int wave = (int)(bid * 4 + (threadIdx.x >> 5));
  const int lane = threadIdx.x & 31;
  const int ngq = n / 128;
  const int t = wave / ngq, qg = wave - t * ngq;
  if (t >= t_rows) return;
  const int j = qg * 128 + lane * 4;
  const bf16x4 xv = *(const bf16x4 *)(x + (long)t * n + j);
  float ob[4];
  float a = 0.f;
#pragma unroll
  for (int e = 0; e < 4; ++e) {
    ob[e] = (float)xv[e];
    a = fmaxf(a, fabsf(ob[e]));
  }
#pragma unroll
  for (int d = 1; d < 32; d <<= 1) a = fmaxf(a, __shfl_xor(a, d, 32));
  const float sc = fmaxf(RC ? a * (1.f / 448.f) : a / 448.f, 1.f / (448.f * 512.f));
  if (lane == 0) scales[(long)t * ngq + qg] = sc;
  unsigned int packed = 0;
#pragma unroll
  for (int e = 0; e < 4; e += 2) {
    const float u = fminf(fmaxf(ob[e] / sc, -448.f), 448.f);
    const float v = fminf(fmaxf(ob[e + 1] / sc, -448.f), 448.f);
    packed |= (__builtin_amdgcn_cvt_pk_fp8_f32(u, v, 0u, false) & 0xffffu) << (e * 8);
  }
  *(unsigned int *)(q + (long)t * n + j) = packed;
}

__device__ __forceinline__ void fn86_bgemm_m16_ldc_part(const __bf16 *__restrict__ a,
                                                        const __bf16 *__restrict__ w,
                                                        __bf16 *__restrict__ c, int m, int n,
                                                        int k, int ldc, int bx, int by) {
  constexpr int MF = 1;
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int n0 = (bx * FB_NW + wave) * 16;
  const int m0 = by * 16;
  const int row = lane & 15, kh = (lane >> 4) * 8;
  const bool live = n0 < n;
  const __bf16 *ap[MF];
#pragma unroll
  for (int mf = 0; mf < MF; ++mf) ap[mf] = a + (long)min(m0 + mf * 16 + row, m - 1) * k + kh;
  const __bf16 *wp = w + (long)min(n0 + row, n - 1) * k + kh;
  floatx8 acc[MF];
#pragma unroll
  for (int mf = 0; mf < MF; ++mf)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[mf][e] = 0.f;
  const int ksteps = live ? k / 16 : 0;
  int ks = 0;
  for (; ks + FB_UNR <= ksteps; ks += FB_UNR) {
    bf16x8 af[MF][FB_UNR], wf[FB_UNR];
#pragma unroll
    for (int u = 0; u < FB_UNR; ++u) {
#pragma unroll
      for (int mf = 0; mf < MF; ++mf) af[mf][u] = *(const bf16x8 *)(ap[mf] + (ks + u) * 16);
      wf[u] = *(const bf16x8 *)(wp + (ks + u) * 16);
    }
#pragma unroll
    for (int u = 0; u < FB_UNR; ++u)
#pragma unroll
      for (int mf = 0; mf < MF; ++mf) acc[mf] = vg_wmma(af[mf][u], wf[u], acc[mf]);
  }
  for (; ks < ksteps; ++ks) {
    const bf16x8 wv = *(const bf16x8 *)(wp + ks * 16);
#pragma unroll
    for (int mf = 0; mf < MF; ++mf)
      acc[mf] = vg_wmma(*(const bf16x8 *)(ap[mf] + ks * 16), wv, acc[mf]);
  }
  const int col = n0 + (lane & 15);
  if (!live || col >= n) return;
#pragma unroll
  for (int mf = 0; mf < MF; ++mf)
#pragma unroll
    for (int e = 0; e < 8; ++e) {
      const int r = m0 + mf * 16 + (lane >> 4) * 8 + e;
      if (r < m) c[(long)r * ldc + col] = (__bf16)acc[mf][e];
    }
}

template <bool RC>
__device__ __forceinline__ void fn86_q8_bgemm_body(
    const __bf16 *__restrict__ a, unsigned char *__restrict__ q, float *__restrict__ as, int m,
    int k, int nqb, const __bf16 *__restrict__ w, __bf16 *__restrict__ c, int n, int ldc,
    int nbx) {
  const int b = (int)blockIdx.x;
  if (b < nqb) {
    fn86_q8_g128_part<RC>(a, q, as, m, k, b);
    return;
  }
  const int bb = b - nqb;
  fn86_bgemm_m16_ldc_part(a, w, c, m, n, k, ldc, bb % nbx, bb / nbx);
}





// ============================================================ FN86c family 2: the act quant in the
// W8 GEMM's A staging + family 4's bf16 suffix as extra workgroups (ONE launch for the merged
// projection). The W8 half is `t8_gemm_a8w8_impl` (above) line for line, except that its A tile is
// fetched as bf16 and quantized at staging: the quant group of `dflash_act_quant_g128` is one row's
// 128 K elements = exactly ONE K tile of one row (BK 128), so each staging thread (16 elements of
// row tid / 8) takes the group's amax over its 8-lane group by a max butterfly (exact: max is order
// free), sc = max(amax / 448, 1 / (448 x 512)) a REAL division, q = clamp(x / sc, +-448) -> e4m3
// by the same convert, packed in the same byte order; the scale is the epilogue's `as` (from LDS,
// double-buffered by K tile) instead of the global read. Workgroups x >= nbx8 run
// `fn86_bgemm_m16_ldc_part` (family 4's suffix, line for line) on the same bf16 input. Rows >= M
// stage a clamped duplicate and take `as` 0, as the parent. `_rc` = the gate CONTROL (the scale as
// a reciprocal multiply): must differ.
template <bool RC>
__device__ __forceinline__ uint4_t fn86_q8_stage16(const uint4_t lo, const uint4_t hi, float &sc) {
  typedef __bf16 bf16x8v __attribute__((ext_vector_type(8)));
  bf16x8v xa, xb;
  __builtin_memcpy(&xa, &lo, 16);
  __builtin_memcpy(&xb, &hi, 16);
  float ob[16];
  float a = 0.f;
#pragma unroll
  for (int e = 0; e < 8; ++e) {
    ob[e] = (float)xa[e];
    ob[8 + e] = (float)xb[e];
  }
#pragma unroll
  for (int e = 0; e < 16; ++e) a = fmaxf(a, fabsf(ob[e]));
#pragma unroll
  for (int d = 1; d < 8; d <<= 1) a = fmaxf(a, __shfl_xor(a, d, 32));
  sc = fmaxf(RC ? a * (1.f / 448.f) : a / 448.f, 1.f / (448.f * 512.f));
  uint4_t out;
#pragma unroll
  for (int wd = 0; wd < 4; ++wd) {
    unsigned int packed = 0;
#pragma unroll
    for (int e = 0; e < 4; e += 2) {
      const float u = fminf(fmaxf(ob[wd * 4 + e] / sc, -448.f), 448.f);
      const float v = fminf(fmaxf(ob[wd * 4 + e + 1] / sc, -448.f), 448.f);
      packed |= (__builtin_amdgcn_cvt_pk_fp8_f32(u, v, 0u, false) & 0xffffu) << (e * 8);
    }
    out[wd] = packed;
  }
  return out;
}

template <int BM, int BN, int BK, int NW, bool RC>
__device__ __forceinline__ void fn86_t8_q8gemm_impl(
    const __bf16 *__restrict__ A,          // [M, K] bf16, row-major (the quant's input)
    const unsigned char *__restrict__ W,   // [N/16, K*16] e4m3, preshuffled
    const float *__restrict__ Ws,          // [N/128, K/128] fp32 block scales
    __bf16 *__restrict__ C,                // [M, ldc] bf16 (columns 0..N)
    int M, int N, int K, long LDC, int bx, int by) {
  constexpr int NT = NW * 32;
  constexpr int NFRAG = BN / 16;
  constexpr int KSTEP = BK / 16;
  constexpr int MYF = NFRAG / NW;
  constexpr int ACH = BM * BK / 16 / NT;
  constexpr int LDA = BK + 8;
  static_assert(ACH == 1 && BK == 128 && NT == 128, "one 16-element chunk a thread, 8 a group");
  __shared__ unsigned char sA[BM * LDA];
  __shared__ float sAs[2][BM];
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int n0 = bx * BN;
  const int m0 = by * BM;
  if (m0 >= M) return;
  const int ktiles = K / BK;

  floatx8 acc[MYF];
#pragma unroll
  for (int i = 0; i < MYF; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0.f;

  const unsigned char *bbase = W + ((long)(n0 / 16) + wave) * (long)K * 16
                               + (long)(lane & 15) * 16 + (long)(lane >> 4) * 8;
  typedef uint2_t bfrag_t[MYF][KSTEP];
  bfrag_t b0, b1;
  uint4_t alo, ahi;
  auto fetch_b = [&](bfrag_t &dst, int kt) {
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int ks = 0; ks < KSTEP; ++ks)
        dst[i][ks] = *(const uint2_t *)(bbase + (long)i * NW * K * 16
                                        + ((long)kt * KSTEP + ks) * 256);
  };
  auto fetch_a = [&](int kt) {
    const int off = tid * 16;
    const int r = off / BK, c = off % BK;
    const int gr = m0 + r;
    const int rc = gr < M ? gr : M - 1;
    const __bf16 *p = A + (long)rc * K + kt * BK + c;
    alo = *(const uint4_t *)p;
    ahi = *(const uint4_t *)(p + 8);
  };
  auto step = [&](int kt, bfrag_t &cur, bfrag_t &nxt) {
    {
      const int off = tid * 16;
      float sc;
      const uint4_t q = fn86_q8_stage16<RC>(alo, ahi, sc);
      *(uint4_t *)(&sA[(off / BK) * LDA + off % BK]) = q;
      if ((tid & 7) == 0) sAs[kt & 1][off / BK] = sc;
    }
    __syncthreads();
    if (kt + 1 < ktiles) {
      fetch_b(nxt, kt + 1);
      fetch_a(kt + 1);
    }
    floatx8 tile[MYF];
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) tile[i][e] = 0.f;
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int ks = 0; ks < KSTEP; ++ks) {
        const uint2_t av =
            *(const uint2_t *)(&sA[(lane & 15) * LDA + ks * 16 + (lane >> 4) * 8]);
        tile[i] = dg_wmma(av, cur[i][ks], tile[i]);
      }
    __syncthreads();
    const float bs = Ws[(long)(n0 / 128) * (K / 128) + kt];
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int row = m0 + dg_acc_row(lane, e);
        const float as = row < M ? sAs[kt & 1][dg_acc_row(lane, e)] : 0.f;
        acc[i][e] += tile[i][e] * (as * bs);
      }
  };

  fetch_b(b0, 0);
  fetch_a(0);
  int kt = 0;
  for (; kt + 1 < ktiles; kt += 2) {
    step(kt, b0, b1);
    step(kt + 1, b1, b0);
  }
  if (kt < ktiles) step(kt, b0, b1);

#pragma unroll
  for (int i = 0; i < MYF; ++i)
    dg_store_acc(acc[i], C, n0 + (wave + i * NW) * 16, m0, M, N, LDC, lane);
}

// grid (nbx8 + nbxs, ceil(M / 16)): x < nbx8 = the W8 prefix's 128-column tiles (C at column 0),
// x >= nbx8 = the bf16 suffix's 64-column tiles (`cs` = C + the prefix's N, its own `ns` rows of
// `ws16`). Both read the SAME bf16 input `a` [M, K].
template <bool RC>
__device__ __forceinline__ void fn86_q8w8_sfx_body(
    const __bf16 *__restrict__ a, const unsigned char *__restrict__ w8, const float *__restrict__ ws8,
    __bf16 *__restrict__ c, int m, int n8, int k, int ldc, int nbx8,
    const __bf16 *__restrict__ w16, __bf16 *__restrict__ cs, int ns) {
  const int bx = (int)blockIdx.x, by = (int)blockIdx.y;
  if (bx < nbx8) {
    fn86_t8_q8gemm_impl<DG_BM, DG_BN, DG_BK, DG_NW, RC>(a, w8, ws8, c, m, n8, k, (long)ldc, bx, by);
    return;
  }
  fn86_bgemm_m16_ldc_part(a, w16, cs, m, ns, k, ldc, bx - nbx8, by);
}





// ============================================================ FN111: the N re-tile at M <= 16
// The served b1 verify's W8 GEMMs run 128-column tiles of 4 waves (2 fragments a wave): the
// out / o projection (N 2,560) is 20 workgroups on 64 CUs and the merged in / QSA projection 65 / 62
// (LEDGER FN111 census: 376 / 548 GB/s of 635). These are the SAME bodies at a 64-column tile (one
// fragment a wave): each output element's arithmetic -- the K-tile loop in order, the 8-step WMMA
// chain from zero, `acc += tile * (as * bs)` with bs from the element's own 128-column block, one
// bf16 rounding at the store -- does not depend on how many fragments a wave holds, so the bytes are
// the parents' (oracle-gated on card 1 vs the shipped symbols, `tools/gates/fn111_twin_hold.sh`).
// Twice the workgroups stream the same bytes.
//   fn111_t8_a8w8_n64_ldc      = fn_t8_a8w8_bs128_ldc / dflash_gemm_a8w8_bs128_m16n128k128 at BN 64
//                                (grid N / 64 x ceil(M / 16); `ldc` = N for the out / o projection)
//   fn111_t8_q8w8_sfx_n64_ldc  = fn86_t8_q8w8_sfx_ldc with the W8 prefix at BN 64 (nbx8 = N8 / 64);
//                                the bf16 suffix workgroups unchanged (64-column, family 4's)



// FN141: the W8 GEMM's k-tile loop as a REGISTER RING (the FN131 pattern applied to
// `t8_gemm_a8w8_impl`). The shipped body double-buffers B by one k-tile, but each step has two
// `__syncthreads()` (A through LDS) and gfx12's workgroup barrier is a release fence =
// `s_wait_loadcnt 0x0`: the next tile's loads drain at the step's end, so the weight stream runs as
// ONE memory round trip a k-tile (24 at K 3,072) with ~2 KB a wave in flight. Here:
//   * A's fragment is read straight from the row (the bytes the LDS tile held: row min(m0 + l, M-1),
//     columns kt*BK + ks*16 + (lane >> 4)*8 .. +8) -- no LDS, no barrier in the loop;
//   * A and B for PF k-tiles in flight in registers, reloaded at the slot just consumed (clamped
//     index min(kt + PF, KT - 1): branch-free, the ring's waits are the in-order loadcnt counts);
//   * the block scales (As rows, Ws) read ONCE into LDS at entry (issued BEFORE the ring head, so
//     their wait leaves the ring in flight), one LDS-only barrier.
// Every output element's arithmetic is the parent's: the KSTEP-step WMMA chain from zero per
// k-tile, `acc += tile * (as * bs)` in kt order with as = 0 for rows >= M, one bf16 rounding at the
// store (dg_store_acc). Byte-equal by construction; gated on card 1 (fn141_probe.py t8).
__device__ __forceinline__ void fn141_lds_barrier() {
  __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
  __builtin_amdgcn_s_barrier();
  __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
}

template <int BM, int BN, int BK, int NW, int PF>
__device__ __forceinline__ void fn141_t8_ring_impl(
    const unsigned char *__restrict__ A, const unsigned char *__restrict__ W,
    const float *__restrict__ As, const float *__restrict__ Ws, __bf16 *__restrict__ C,
    int M, int N, int K, long LDC) {
  static_assert(BM == 16 && BN == 16 * NW, "one fragment a wave");
  constexpr int NT = NW * 32;
  constexpr int KSTEP = BK / 16;
  constexpr int KTMAX = 32;
  __shared__ float s_as[BM * KTMAX];  // [row][kt] at stride KT (BM * KT <= BM * KTMAX = SV * NT)
  __shared__ float s_ws[KTMAX];
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int n0 = blockIdx.x * BN;
  const int m0 = (int)blockIdx.y * BM;
  if (m0 >= M) return;
  const int KT = K / BK;
  // scales first, a fixed count a thread at clamped addresses (their wait must not drain the ring)
  constexpr int SV = BM * KTMAX / NT;
  float sv[SV];
#pragma unroll
  for (int j = 0; j < SV; ++j) {
    const int i = tid + j * NT, r = min(i / KT, BM - 1), k = i - (i / KT) * KT;
    sv[j] = As[(long)min(m0 + r, M - 1) * KT + k];
  }
  const float wv = Ws[(long)(n0 / 128) * KT + min(tid, KT - 1)];
  const unsigned char *bbase = W + ((long)(n0 / 16) + wave) * (long)K * 16
                               + (long)(lane & 15) * 16 + (long)(lane >> 4) * 8;
  const int ar = min(m0 + (lane & 15), M - 1);
  const unsigned char *abase = A + (long)ar * K + (lane >> 4) * 8;
  uint2_t rb[PF][KSTEP], ra[PF][KSTEP];
  auto fetch = [&](int p, int kt) {
#pragma unroll
    for (int ks = 0; ks < KSTEP; ++ks) {
      ra[p][ks] = *(const uint2_t *)(abase + (long)kt * BK + ks * 16);
      rb[p][ks] = *(const uint2_t *)(bbase + ((long)kt * KSTEP + ks) * 256);
    }
  };
#pragma unroll
  for (int p = 0; p < PF; ++p) fetch(p, min(p, KT - 1));
#pragma unroll
  for (int j = 0; j < SV; ++j) {
    const int i = tid + j * NT, r = i / KT;
    s_as[i] = m0 + r < M ? sv[j] : 0.f;  // every slot written (slots past BM * KT unread)
  }
  s_ws[min(tid, KT - 1)] = wv;  // threads past KT store the last value again (same bytes)
  fn141_lds_barrier();
  floatx8 acc;
#pragma unroll
  for (int e = 0; e < 8; ++e) acc[e] = 0.f;
  for (int kt0 = 0; kt0 < KT; kt0 += PF) {
#pragma unroll
    for (int p = 0; p < PF; ++p) {
      const int kt = kt0 + p;
      {  // KT % PF == 0 (the route checks it): no guard, so the ring's waits stay exact
        floatx8 tile;
#pragma unroll
        for (int e = 0; e < 8; ++e) tile[e] = 0.f;
#pragma unroll
        for (int ks = 0; ks < KSTEP; ++ks) tile = dg_wmma(ra[p][ks], rb[p][ks], tile);
        fetch(p, min(kt + PF, KT - 1));
        __builtin_amdgcn_sched_barrier(0);  // the reload stays at its slot (else it sinks to the loop end)
        const float bs = s_ws[kt];
#pragma unroll
        for (int e = 0; e < 8; ++e) {
          const float as = s_as[dg_acc_row(lane, e) * KT + kt];
          acc[e] += tile[e] * (as * bs);
        }
      }
    }
  }
  dg_store_acc(acc, C, n0 + wave * 16, m0, M, N, LDC, lane);
}

// ---- the merged projection (FN86c family 2, `fn86_t8_q8gemm_impl`) as a ring: A is quantized at
// staging (one 128-element row group = one k tile of one row, 8 threads a row) so it keeps its LDS
// tile, but DOUBLE-BUFFERED (sA[kt & 1], as sAs already was) with ONE LDS-only barrier a k tile
// (the parent's two `__syncthreads()` drain the register prefetch: FN31's law); the bf16 A chunk
// and the W8 fragments for PF k tiles in flight (reloaded at the slot just consumed, clamped).
// Why one barrier suffices: a thread staging tile kt + 1 into buffer (kt + 1) & 1 has passed tile
// kt's barrier, which every thread reached only after its reads of tile kt - 1 (the same buffer).
// The arithmetic is the parent's line for line (fn86_q8_stage16, the 8-step chain from zero,
// `acc += tile * (as * bs)` with as = 0 for rows >= M, dg_store_acc).
template <int BM, int BN, int BK, int NW, int PF>
__device__ __forceinline__ void fn141_q8gemm_ring_impl(
    const __bf16 *__restrict__ A, const unsigned char *__restrict__ W, const float *__restrict__ Ws,
    __bf16 *__restrict__ C, int M, int N, int K, long LDC, int bx, int by) {
  constexpr int NT = NW * 32;
  constexpr int NFRAG = BN / 16;
  constexpr int KSTEP = BK / 16;
  constexpr int MYF = NFRAG / NW;
  constexpr int ACH = BM * BK / 16 / NT;
  constexpr int LDA = BK + 8;
  static_assert(ACH == 1 && BK == 128 && NT == 128, "one 16-element chunk a thread, 8 a group");
  static_assert(PF % 2 == 0, "kt & 1 == p & 1");
  __shared__ unsigned char sA[2][BM * LDA];
  __shared__ float sAs[2][BM];
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int n0 = bx * BN;
  const int m0 = by * BM;
  if (m0 >= M) return;
  const int KT = K / BK;
  floatx8 acc[MYF];
#pragma unroll
  for (int i = 0; i < MYF; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0.f;
  const unsigned char *bbase = W + ((long)(n0 / 16) + wave) * (long)K * 16
                               + (long)(lane & 15) * 16 + (long)(lane >> 4) * 8;
  const int off = tid * 16;
  const int ar = min(m0 + off / BK, M - 1);
  const __bf16 *abase = A + (long)ar * K + off % BK;
  uint2_t rb[PF][MYF][KSTEP];
  uint4_t alo[PF], ahi[PF];
  auto fetch = [&](int p, int kt) {
    const __bf16 *pa = abase + (long)kt * BK;
    alo[p] = *(const uint4_t *)pa;
    ahi[p] = *(const uint4_t *)(pa + 8);
    __builtin_amdgcn_sched_barrier(0);  // A before B: the staging's wait leaves the W8 slot in flight
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int ks = 0; ks < KSTEP; ++ks)
        rb[p][i][ks] = *(const uint2_t *)(bbase + (long)i * NW * K * 16 + ((long)kt * KSTEP + ks) * 256);
  };
#pragma unroll
  for (int p = 0; p < PF; ++p) fetch(p, min(p, KT - 1));
  for (int kt0 = 0; kt0 < KT; kt0 += PF) {   // KT % PF == 0 (the route checks it)
#pragma unroll
    for (int p = 0; p < PF; ++p) {
      const int kt = kt0 + p, buf = p & 1;
      {
        float sc;
        const uint4_t q = fn86_q8_stage16<false>(alo[p], ahi[p], sc);
        *(uint4_t *)(&sA[buf][(off / BK) * LDA + off % BK]) = q;
        if ((tid & 7) == 0) sAs[buf][off / BK] = sc;
      }
      fn141_lds_barrier();
      floatx8 tile[MYF];
#pragma unroll
      for (int i = 0; i < MYF; ++i)
#pragma unroll
        for (int e = 0; e < 8; ++e) tile[i][e] = 0.f;
#pragma unroll
      for (int i = 0; i < MYF; ++i)
#pragma unroll
        for (int ks = 0; ks < KSTEP; ++ks) {
          const uint2_t av = *(const uint2_t *)(&sA[buf][(lane & 15) * LDA + ks * 16 + (lane >> 4) * 8]);
          tile[i] = dg_wmma(av, rb[p][i][ks], tile[i]);
        }
      fetch(p, min(kt + PF, KT - 1));
      __builtin_amdgcn_sched_barrier(0);
      const float bs = Ws[(long)(n0 / 128) * (K / 128) + kt];
#pragma unroll
      for (int i = 0; i < MYF; ++i)
#pragma unroll
        for (int e = 0; e < 8; ++e) {
          const int row = m0 + dg_acc_row(lane, e);
          const float as = row < M ? sAs[buf][dg_acc_row(lane, e)] : 0.f;
          acc[i][e] += tile[i][e] * (as * bs);
        }
    }
  }
#pragma unroll
  for (int i = 0; i < MYF; ++i)
    dg_store_acc(acc[i], C, n0 + (wave + i * NW) * 16, m0, M, N, LDC, lane);
}

// ---- flashnext_trunk8p.hip's helpers, verbatim
#define P_BK 128
#define P_LDA (P_BK + 8)

__device__ __forceinline__ floatx8 p_wmma(uint2_t a, uint2_t b, floatx8 c) {
  return __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(a, b, c);
}

static __device__ __forceinline__ void p_lds_barrier() {
  __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
  __builtin_amdgcn_s_barrier();
  __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
}

template <bool NT>
__device__ __forceinline__ uint2_t p_ldb(const unsigned char *p) {
  if constexpr (NT) return __builtin_nontemporal_load((const uint2_t *)p);
  else return *(const uint2_t *)p;
}


// ================================================================ FN164: the mixer-out exchange
// FMODE 0 = the form, 1 = the CONTROL (no spin), 2 = the RACE CHECKER `_chk` (the form + the
// flag-range and late-word checks). FN137's channel struct, field for field (abi::STRUCT_FAR_ARGS).
struct FarArgs {
  int4 *peer;               // the PEER's window (its slot 0; slot 1 at + stride16)
  const int4 *my;           // this rank's window (the peer writes it)
  unsigned *pflags;         // the peer's 40 workgroup flags
  unsigned *mflags;         // this rank's 40 workgroup flags (the peer writes them)
  unsigned *ctr;            // the 40 workgroups' call counters (this rank's, plain memory)
  int4 *red;                // the SUM (M x 2,560 bf16): the all-reduce's output
  unsigned *diag;           // [0] spin timeouts; _chk: [1] peer flag outside {s, s+1}, [2] a
                            // payload word that changed between two reads after the flag
  unsigned long long *stamp;  // unused (0): the served form never stamps
  int stride16;             // a slot, in 16-byte words
  int pad;
};
__device__ __forceinline__ void t8far_rel(unsigned *p, unsigned v) {
  __hip_atomic_store(p, v, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_SYSTEM);
}
__device__ __forceinline__ unsigned t8far_acq(const unsigned *p) {
  return __hip_atomic_load(p, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM);
}
// saber_ar_exact.hip's `vadd<__hip_bfloat16, 8>`, verbatim arithmetic: fp32 sum, one bf16 rounding.
__device__ __forceinline__ int4 t8far_vadd(const int4 &a, const int4 &b) {
  int4 r;
  const __hip_bfloat16 *pa = reinterpret_cast<const __hip_bfloat16 *>(&a);
  const __hip_bfloat16 *pb = reinterpret_cast<const __hip_bfloat16 *>(&b);
  __hip_bfloat16 *pr = reinterpret_cast<__hip_bfloat16 *>(&r);
#pragma unroll
  for (int j = 0; j < 8; ++j) pr[j] = (__hip_bfloat16)((float)pa[j] + (float)pb[j]);
  return r;
}
// The oracle's skew source: one workgroup spins `ticks` of the 100 MHz realtime clock.
extern "C" __global__ void fn164_delay(unsigned long long ticks) {
  const unsigned long long t0 = wall_clock64();
  while (wall_clock64() - t0 < ticks) __builtin_amdgcn_s_sleep(1);
}
// Thread 0 advances this workgroup's call counter at entry (the load issues before the k loop).
__device__ __forceinline__ void t8far_begin(const FarArgs &fa, unsigned &s_sh) {
  if (threadIdx.x == 0) {
    const unsigned s = fa.ctr[blockIdx.x] + 1u;
    fa.ctr[blockIdx.x] = s;
    s_sh = s;
  }
}
// The workgroup's exchange over its 64 columns x (M - m0, <= BM) rows: the bf16 partial words in
// LDS `sp` ([BM][64], the store's roundings), pushed, flagged, the peer's awaited, summed.
template <int FMODE, int BM, int NT>
__device__ __forceinline__ void t8far_exchange(const __bf16 *sp, const int m0, const int M,
                                               const FarArgs &fa, const unsigned &s_sh) {
  constexpr int W16 = 2560 / 8;   // 16-byte words a row of the SUM (N = ldc = 2,560)
  constexpr int NI = (BM * 8 + NT - 1) / NT;
  __syncthreads();   // the partial tile in LDS + the call index
  const unsigned s = s_sh;
  const int wg = (int)blockIdx.x;
  const int items = min(BM, M - m0) * 8;
  const int slot = (int)(s & 1u);
  int4 *ps = fa.peer + (size_t)slot * fa.stride16;
  const int4 *ms = fa.my + (size_t)slot * fa.stride16;
  const int4 *s16 = reinterpret_cast<const int4 *>(sp);
  int4 o[NI];
#pragma unroll
  for (int j = 0; j < NI; ++j) {
    const int i = (int)threadIdx.x + j * NT;
    if (i < items) {
      const int k = (m0 + (i >> 3)) * W16 + wg * 8 + (i & 7);
      o[j] = s16[i];
      ps[k] = o[j];
    }
  }
  asm volatile("s_wait_storecnt 0x0" ::: "memory");   // the served drain (3)
  __syncthreads();
  if (threadIdx.x == 0) {
    t8far_rel(&fa.pflags[wg], s);
    if (FMODE != 1) {
      const unsigned long long t0 = wall_clock64();
      while (t8far_acq(&fa.mflags[wg]) < s) {
        // 40 s of the 100 MHz realtime clock: a peer KFD-queue eviction is a WAIT, never a
        // timeout (FN137b h2's law; the shipped one-shot bounds its spin at the same order)
        if (wall_clock64() - t0 > 4000000000ull) { atomicAdd(&fa.diag[0], 1u); break; }
      }
    }
    if (FMODE == 2) {   // _chk: the peer is at this call or the next one, never further
      const unsigned v = t8far_acq(&fa.mflags[wg]);
      if (v != s && v != s + 1u) atomicAdd(&fa.diag[1], 1u);
    }
  }
  __syncthreads();   // the served acq = 0: no fence after
#pragma unroll
  for (int j = 0; j < NI; ++j) {
    const int i = (int)threadIdx.x + j * NT;
    if (i < items) {
      const int k = (m0 + (i >> 3)) * W16 + wg * 8 + (i & 7);
      const int4 pv = ms[k];
      fa.red[k] = t8far_vadd(o[j], pv);
      if (FMODE == 2) {   // _chk: the landed word must not change after the flag (a late write)
        __builtin_amdgcn_s_sleep(4);
        const unsigned *pw = reinterpret_cast<const unsigned *>(&ms[k]);
        const unsigned w0 = __hip_atomic_load(pw + 0, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM);
        const unsigned w1 = __hip_atomic_load(pw + 1, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM);
        const unsigned w2 = __hip_atomic_load(pw + 2, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM);
        const unsigned w3 = __hip_atomic_load(pw + 3, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM);
        if (w0 != (unsigned)pv.x || w1 != (unsigned)pv.y || w2 != (unsigned)pv.z || w3 != (unsigned)pv.w)
          atomicAdd(&fa.diag[2], 1u);
      }
    }
  }
}

template <int BM, int BN, int BK, int NW, int FMODE>
__device__ __forceinline__ void t8_gemm_a8w8_far_impl(
    const unsigned char *__restrict__ A,   // [M, K] e4m3, row-major
    const unsigned char *__restrict__ W,   // [N/16, K*16] e4m3, preshuffled
    const float *__restrict__ As,          // [M, K/128] fp32 block scales
    const float *__restrict__ Ws,          // [N/128, K/128] fp32 block scales
    __bf16 *__restrict__ C,                // [M, ldc] bf16 (columns 0..N)
    int M, int N, int K, long LDC, const FarArgs fa) {
  constexpr int NT = NW * 32;
  constexpr int NFRAG = BN / 16;
  constexpr int KSTEP = BK / 16;
  constexpr int MYF = NFRAG / NW;
  constexpr int ACH = BM * BK / 16 / NT;
  constexpr int LDA = BK + 8;
  __shared__ unsigned char sA[BM * LDA];
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int n0 = blockIdx.x * BN;
  const int m0 = (int)blockIdx.y * BM;
  if (m0 >= M) return;
  __shared__ unsigned t8far_s;   // FN164: this workgroup's call index
  t8far_begin(fa, t8far_s);
  const int ktiles = K / BK;

  floatx8 acc[MYF];
#pragma unroll
  for (int i = 0; i < MYF; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0.f;

  const unsigned char *bbase = W + ((long)(n0 / 16) + wave) * (long)K * 16
                               + (long)(lane & 15) * 16 + (long)(lane >> 4) * 8;
  typedef uint2_t bfrag_t[MYF][KSTEP];
  bfrag_t b0, b1;
  uint4_t abuf[ACH];
  auto fetch_b = [&](bfrag_t &dst, int kt) {
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int ks = 0; ks < KSTEP; ++ks)
        dst[i][ks] = *(const uint2_t *)(bbase + (long)i * NW * K * 16
                                        + ((long)kt * KSTEP + ks) * 256);
  };
  auto fetch_a = [&](int kt) {
#pragma unroll
    for (int i = 0; i < ACH; ++i) {
      const int off = (tid + i * NT) * 16;
      const int r = off / BK, c = off % BK;
      const int gr = m0 + r;
      const int rc = gr < M ? gr : M - 1;
      abuf[i] = *(const uint4_t *)(A + (long)rc * K + kt * BK + c);
    }
  };
  auto step = [&](int kt, bfrag_t &cur, bfrag_t &nxt) {
#pragma unroll
    for (int i = 0; i < ACH; ++i) {
      const int off = (tid + i * NT) * 16;
      *(uint4_t *)(&sA[(off / BK) * LDA + off % BK]) = abuf[i];
    }
    __syncthreads();
    if (kt + 1 < ktiles) {
      fetch_b(nxt, kt + 1);
      fetch_a(kt + 1);
    }
    floatx8 tile[MYF];
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) tile[i][e] = 0.f;
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int ks = 0; ks < KSTEP; ++ks) {
        const uint2_t av =
            *(const uint2_t *)(&sA[(lane & 15) * LDA + ks * 16 + (lane >> 4) * 8]);
        tile[i] = dg_wmma(av, cur[i][ks], tile[i]);
      }
    __syncthreads();
    const float bs = Ws[(long)(n0 / 128) * (K / 128) + kt];
#pragma unroll
    for (int i = 0; i < MYF; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int row = m0 + dg_acc_row(lane, e);
        const float as = row < M ? As[(long)row * (K / 128) + kt] : 0.f;
        acc[i][e] += tile[i][e] * (as * bs);
      }
  };

  fetch_b(b0, 0);
  fetch_a(0);
  int kt = 0;
  for (; kt + 1 < ktiles; kt += 2) {
    step(kt, b0, b1);
    step(kt + 1, b1, b0);
  }
  if (kt < ktiles) step(kt, b0, b1);

#pragma unroll
  for (int i = 0; i < MYF; ++i)
    dg_store_acc(acc[i], C, n0 + (wave + i * NW) * 16, m0, M, N, LDC, lane);
  // FN164: the same words (the store's rounding) staged for the exchange
  static_assert(BN == 64, "the exchange's 40 workgroups of 64 columns");
  __shared__ __bf16 t8far_p[BM * BN];
#pragma unroll
  for (int i = 0; i < MYF; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e)
      t8far_p[dg_acc_row(lane, e) * BN + (wave + i * NW) * 16 + (lane & 15)] = (__bf16)acc[i][e];
  t8far_exchange<FMODE, BM, NT>(t8far_p, m0, M, fa, t8far_s);
}



template <int BM, int BN, int BK, int NW, int PF, int FMODE>
__device__ __forceinline__ void fn141_t8_ring_far_impl(
    const unsigned char *__restrict__ A, const unsigned char *__restrict__ W,
    const float *__restrict__ As, const float *__restrict__ Ws, __bf16 *__restrict__ C,
    int M, int N, int K, long LDC, const FarArgs fa) {
  static_assert(BM == 16 && BN == 16 * NW, "one fragment a wave");
  constexpr int NT = NW * 32;
  constexpr int KSTEP = BK / 16;
  constexpr int KTMAX = 32;
  __shared__ float s_as[BM * KTMAX];  // [row][kt] at stride KT (BM * KT <= BM * KTMAX = SV * NT)
  __shared__ float s_ws[KTMAX];
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int n0 = blockIdx.x * BN;
  const int m0 = (int)blockIdx.y * BM;
  if (m0 >= M) return;
  __shared__ unsigned t8far_s;   // FN164: this workgroup's call index
  t8far_begin(fa, t8far_s);
  const int KT = K / BK;
  // scales first, a fixed count a thread at clamped addresses (their wait must not drain the ring)
  constexpr int SV = BM * KTMAX / NT;
  float sv[SV];
#pragma unroll
  for (int j = 0; j < SV; ++j) {
    const int i = tid + j * NT, r = min(i / KT, BM - 1), k = i - (i / KT) * KT;
    sv[j] = As[(long)min(m0 + r, M - 1) * KT + k];
  }
  const float wv = Ws[(long)(n0 / 128) * KT + min(tid, KT - 1)];
  const unsigned char *bbase = W + ((long)(n0 / 16) + wave) * (long)K * 16
                               + (long)(lane & 15) * 16 + (long)(lane >> 4) * 8;
  const int ar = min(m0 + (lane & 15), M - 1);
  const unsigned char *abase = A + (long)ar * K + (lane >> 4) * 8;
  uint2_t rb[PF][KSTEP], ra[PF][KSTEP];
  auto fetch = [&](int p, int kt) {
#pragma unroll
    for (int ks = 0; ks < KSTEP; ++ks) {
      ra[p][ks] = *(const uint2_t *)(abase + (long)kt * BK + ks * 16);
      rb[p][ks] = *(const uint2_t *)(bbase + ((long)kt * KSTEP + ks) * 256);
    }
  };
#pragma unroll
  for (int p = 0; p < PF; ++p) fetch(p, min(p, KT - 1));
#pragma unroll
  for (int j = 0; j < SV; ++j) {
    const int i = tid + j * NT, r = i / KT;
    s_as[i] = m0 + r < M ? sv[j] : 0.f;  // every slot written (slots past BM * KT unread)
  }
  s_ws[min(tid, KT - 1)] = wv;  // threads past KT store the last value again (same bytes)
  fn141_lds_barrier();
  floatx8 acc;
#pragma unroll
  for (int e = 0; e < 8; ++e) acc[e] = 0.f;
  for (int kt0 = 0; kt0 < KT; kt0 += PF) {
#pragma unroll
    for (int p = 0; p < PF; ++p) {
      const int kt = kt0 + p;
      {  // KT % PF == 0 (the route checks it): no guard, so the ring's waits stay exact
        floatx8 tile;
#pragma unroll
        for (int e = 0; e < 8; ++e) tile[e] = 0.f;
#pragma unroll
        for (int ks = 0; ks < KSTEP; ++ks) tile = dg_wmma(ra[p][ks], rb[p][ks], tile);
        fetch(p, min(kt + PF, KT - 1));
        __builtin_amdgcn_sched_barrier(0);  // the reload stays at its slot (else it sinks to the loop end)
        const float bs = s_ws[kt];
#pragma unroll
        for (int e = 0; e < 8; ++e) {
          const float as = s_as[dg_acc_row(lane, e) * KT + kt];
          acc[e] += tile[e] * (as * bs);
        }
      }
    }
  }
  dg_store_acc(acc, C, n0 + wave * 16, m0, M, N, LDC, lane);
  // FN164: the same words (the store's rounding) staged for the exchange
  static_assert(BN == 64, "the exchange's 40 workgroups of 64 columns");
  __shared__ __bf16 t8far_p[BM * BN];
#pragma unroll
  for (int e = 0; e < 8; ++e)
    t8far_p[dg_acc_row(lane, e) * BN + wave * 16 + (lane & 15)] = (__bf16)acc[e];
  t8far_exchange<FMODE, BM, NT>(t8far_p, m0, M, fa, t8far_s);
}

template <int MF, int MH, int NW, bool MFAST, bool NT, int FMODE>
__device__ __forceinline__ void t8p_far_impl(
    const unsigned char *__restrict__ A,   // [M, K] e4m3, row-major
    const unsigned char *__restrict__ W,   // [N/16, K*16] e4m3, preshuffled
    const float *__restrict__ As,          // [M, K/128] fp32
    const float *__restrict__ Ws,          // [N/128, K/128] fp32
    __bf16 *__restrict__ C,                // [M, ldc] bf16 (columns 0..N)
    int M, int N, int K, long LDC, const FarArgs fa) {
  constexpr int BM = 16 * MF;
  constexpr int NTH = NW * 32;
  constexpr int KSTEP = P_BK / 16;
  constexpr int ACH = BM * (P_BK / 16) / NTH;   // uint4 A chunks a thread a k tile
  static_assert(ACH * NTH == BM * (P_BK / 16), "A staging divides");
  static_assert(NTH >= BM, "one scale a thread");
  __shared__ unsigned char sA[2][BM * P_LDA];
  __shared__ float sS[2][BM];
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int mt = MFAST ? (int)blockIdx.x : (int)blockIdx.y;
  const int nt = MFAST ? (int)blockIdx.y : (int)blockIdx.x;
  const int m0 = mt * BM;
  const int nf = nt * NW * 16 + wave * 16;   // this wave's 16 columns
  const int kb = K / P_BK;
  static_assert(!MFAST && NW == 4, "FN164: the decode tiles (40 column workgroups on x)");
  __shared__ unsigned t8far_s;   // FN164: this workgroup's call index
  t8far_begin(fa, t8far_s);

  floatx8 acc[MF];
#pragma unroll
  for (int i = 0; i < MF; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0.f;

  const unsigned char *bbase =
      W + (long)(nf / 16) * K * 16 + (long)(lane & 15) * 16 + (long)(lane >> 4) * 8;
  const float *wsrow = Ws + (long)(nf / 128) * kb;
  uint2_t b0[KSTEP], b1[KSTEP];
  uint4_t abuf[ACH];
  float sbuf = 0.f;
  const int srow = min(m0 + (tid < BM ? tid : 0), M - 1);

  auto fetch_b = [&](uint2_t (&dst)[KSTEP], int kt) {
#pragma unroll
    for (int ks = 0; ks < KSTEP; ++ks)
      dst[ks] = p_ldb<NT>(bbase + ((long)kt * KSTEP + ks) * 256);
  };
  auto fetch_a = [&](int kt) {
#pragma unroll
    for (int i = 0; i < ACH; ++i) {
      const int off = (tid + i * NTH) * 16;
      const int r = off / P_BK, c = off % P_BK;
      const int rc = min(m0 + r, M - 1);
      abuf[i] = *(const uint4_t *)(A + (long)rc * K + kt * P_BK + c);
    }
    sbuf = As[(long)srow * kb + kt];
  };
  auto put_a = [&](int buf) {
#pragma unroll
    for (int i = 0; i < ACH; ++i) {
      const int off = (tid + i * NTH) * 16;
      *(uint4_t *)(&sA[buf][(off / P_BK) * P_LDA + off % P_BK]) = abuf[i];
    }
    if (tid < BM) sS[buf][tid] = sbuf;
  };
  auto step = [&](int kt, uint2_t (&cur)[KSTEP], uint2_t (&nxt)[KSTEP]) {
    const int buf = kt & 1;
    const bool more = kt + 1 < kb;
    if (more) {
      fetch_a(kt + 1);
      fetch_b(nxt, kt + 1);
    }
    const float bs = wsrow[kt];
    // MH row fragments a pass (the register bound): each fragment's chain is the parent's
#pragma unroll
    for (int h = 0; h < MF; h += MH) {
      floatx8 tile[MH];
#pragma unroll
      for (int i = 0; i < MH; ++i)
#pragma unroll
        for (int e = 0; e < 8; ++e) tile[i][e] = 0.f;
#pragma unroll
      for (int ks = 0; ks < KSTEP; ++ks)
#pragma unroll
        for (int i = 0; i < MH; ++i) {
          const uint2_t av = *(const uint2_t *)(
              &sA[buf][((h + i) * 16 + (lane & 15)) * P_LDA + ks * 16 + (lane >> 4) * 8]);
          tile[i] = p_wmma(av, cur[ks], tile[i]);
        }
#pragma unroll
      for (int i = 0; i < MH; ++i)
#pragma unroll
        for (int e = 0; e < 8; ++e) {
          const float as = sS[buf][(h + i) * 16 + (lane >> 4) * 8 + e];
          acc[h + i][e] += tile[i][e] * (as * bs);
        }
    }
    if (more) put_a(buf ^ 1);
    p_lds_barrier();
  };

  fetch_a(0);
  fetch_b(b0, 0);
  put_a(0);
  __syncthreads();
  int kt = 0;
  for (; kt + 1 < kb; kt += 2) {
    step(kt, b0, b1);
    step(kt + 1, b1, b0);
  }
  if (kt < kb) step(kt, b0, b1);

  const int col = nf + (lane & 15);
#pragma unroll
  for (int i = 0; i < MF; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) {
      const int row = m0 + i * 16 + (lane >> 4) * 8 + e;
      if (row < M) C[(long)row * LDC + col] = (__bf16)acc[i][e];
    }
  // FN164: the same words (the store's rounding) staged for the exchange
  __shared__ __bf16 t8far_p[BM * 64];
#pragma unroll
  for (int i = 0; i < MF; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e)
      t8far_p[(i * 16 + (lane >> 4) * 8 + e) * 64 + wave * 16 + (lane & 15)] = (__bf16)acc[i][e];
  t8far_exchange<FMODE, BM, NTH>(t8far_p, m0, M, fa, t8far_s);
}


