// GENERATED by tools/gen_cmp27ae_arw.py from hip/mxfp4_gemm_decode_pf.hip (the shipped prefetch
// decode body through its split-K election, verbatim) + tools/capture/cmp27ae/arw_{helpers,epilogue}.inc.
// Do not edit: re-run the generator (`--check` proves this file current).
// CMP27AE: the N 5120 dwn4 decode GEMM whose last split-K arriver of every 64-column tile runs the
// rotated (wht6) two-rank all-reduce of the tile's own rotation groups (one group a row at DWN 4)
// and stores the reduced bf16 rows to `out` -- one launch for `GEMM -> allreduce_wht` (LEDGER
// CMP27AB: 0 of 360 cases differ from the shipped GEMM + wpar reduce in output, symbols and scales).
// Saber source (CMP27E, 2026-10-26): the b8 (tm4) MXFP4 decode GEMMs with a REGISTER PREFETCH.
//
// The shipped decode body (`mxfp4_gemm_decode.hip`) stages each K slab global -> LDS and then runs
// its WMMA, one slab at a time: at 64 rows a block's slab is ~4 us of serial latency and the b8 GEMMs
// stream their weights at 240-400 GB/s against a 540 GB/s cap (LEDGER CMP27E's census). Here slab
// s+1's A rows, W fragment words and Ws / Wref scale bytes are loaded into registers BEFORE slab s's
// WMMA, and the loop's barriers are LDS-only (a `__syncthreads()` is a workgroup release fence =
// `s_wait_loadcnt 0` on gfx12, which would drain the prefetch). Every slab's LDS bytes and the WMMA
// order are the shipped body's, so the accumulators, the split-K partials, the last-arriver reduce
// and the direct store are the same bits (gated: `tools/capture/cmp27e/pair_probe.py --mode v5`,
// 0 differing outputs on 16 + 3 x 8 real layer copies, both cards).
//
// The PAIR twin also lays problem 1 (the 48-wide `in_proj_ba`, 4 short split blocks) FIRST in the
// grid: the shipped order dispatches them last, behind 128 long qkvz blocks, where their 10-slab
// latency chain is the kernel's tail (100 us isolated; 82 us only when the dispatcher happens to
// place them well -- CMP27D's per-boot, per-layer "rank asymmetry"). Same blocks, same bytes.
//
// Bound only under the `decode_pf` knob (`--engine-decode-pf`, an ARM, default off) by
// `saber_kernels::rules`, never by a registry row; the shipped `mxfp4_gemm_decode` keeps its bytes.
#include <hip/hip_runtime.h>
#include <hip/hip_bf16.h>
#include "mxfp4_common.h"

#define DEC_DWN 8
#define DEC_MTILE 16
#define DEC_PAD 8
static __device__ __forceinline__ unsigned int wq_dec(uint2_t v, int q) { return q ? v[1] : v[0]; }
template <bool NT, typename T>
static __device__ __forceinline__ T ld_w(const T *p) {
  if constexpr (NT) return __builtin_nontemporal_load(p);
  else return *p;
}

#define CMP27E_LDS_BARRIER()                                          \
  do {                                                                \
    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");   \
    __builtin_amdgcn_s_barrier();                                     \
    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");   \
  } while (0)

// ---- CMP27AE (CMP27AB's probe helpers): the shipped wht6 per-group arithmetic (saber_ar_wht_wpar.hip, built with
// -ffp-contract=off; this TU keeps the pf GEMM's flags, so every helper turns contraction off).
#include <hip/hip_fp16.h>
#define AB_GROUP 64
#define AB_EPL 8
#define AB_LPG 8
#define AB_BITS 6
#define AB_SPIN_MAX 4000000000ULL
// The family's first counter / flag word in `ar_seq` / `ar_flags` (512 words; the one-shots use
// 0..95, the split form 511): `saber::AR_FUSE_WORD0` on the host.
#define ARW_WORD0 384
__device__ __forceinline__ void ab_store_sys_rel(unsigned int* p, unsigned int v) {
  __hip_atomic_store(p, v, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_SYSTEM);
}
__device__ __forceinline__ unsigned int ab_load_sys_acq(const unsigned int* p) {
  return __hip_atomic_load(p, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM);
}
__device__ __forceinline__ float ab_bf16_round(float v) {
  unsigned u = __float_as_uint(v);
  const unsigned lsb = (u >> 16) & 1u;
  u += 0x7fffu + lsb;
  return __uint_as_float(u & 0xffff0000u);
}
__device__ __forceinline__ void ab_wht(float* v, int lig) {
#pragma clang fp contract(off)
#pragma unroll
  for (int h = 1; h < AB_EPL; h <<= 1)
#pragma unroll
    for (int i = 0; i < AB_EPL; ++i)
      if ((i & h) == 0) { const float x = v[i], y = v[i ^ h]; v[i] = x + y; v[i ^ h] = x - y; }
#pragma unroll
  for (int m = 1; m < AB_LPG; m <<= 1) {
    const bool lo = (lig & m) == 0;
#pragma unroll
    for (int i = 0; i < AB_EPL; ++i) {
      const float o = __shfl_xor(v[i], m);
      v[i] = lo ? (v[i] + o) : (o - v[i]);
    }
  }
  const float nrm = rsqrtf((float)AB_GROUP);
#pragma unroll
  for (int i = 0; i < AB_EPL; ++i) v[i] *= nrm;
}
// rotate + amax + scale + symbols of one group's 8 lanes (the wpar push phase 1, per lane)
__device__ __forceinline__ void ab_quant(float* v, int lig, unsigned& w0, unsigned& w1, float& sc) {
#pragma clang fp contract(off)
  constexpr int qmin = -(1 << (AB_BITS - 1)), qmax = (1 << (AB_BITS - 1)) - 1;
  ab_wht(v, lig);
  float a = 0.f;
#pragma unroll
  for (int i = 0; i < AB_EPL; ++i) a = fmaxf(a, fabsf(v[i]));
#pragma unroll
  for (int m = 1; m < AB_LPG; m <<= 1) a = fmaxf(a, __shfl_xor(a, m));
  sc = (a > 0.f) ? ab_bf16_round(a * (1.0f / (float)qmax)) : 1.0f;
  if (!(sc > 0.f)) sc = 1.0f;
  const float inv = 1.0f / sc;
  unsigned long long w = 0ull;
#pragma unroll
  for (int i = 0; i < AB_EPL; ++i) {
    const int q = min(max((int)rintf(v[i] * inv), qmin), qmax) - qmin;
    w |= (unsigned long long)(unsigned)q << (i * AB_BITS);
  }
  w0 = (unsigned)w; w1 = (unsigned)(w >> 32);
}
// dequant both halves (peer first, as the shipped reduce), add in fp32, inverse rotation
__device__ __forceinline__ void ab_reduce(float* v, int lig, unsigned long long pw, float psc,
                                          unsigned long long lw, float lsc) {
#pragma clang fp contract(off)
  constexpr int qmin = -(1 << (AB_BITS - 1));
  constexpr unsigned MASK = (1u << AB_BITS) - 1u;
#pragma unroll
  for (int i = 0; i < AB_EPL; ++i) {
    const unsigned ps = (unsigned)(pw >> (i * AB_BITS)), ls = (unsigned)(lw >> (i * AB_BITS));
    v[i] = (float)((int)(ps & MASK) + qmin) * psc + (float)((int)(ls & MASK) + qmin) * lsc;
  }
  ab_wht(v, lig);
}

template <int DWN, int DBK, int DTM, bool NT>
__device__ __forceinline__ void cmp27ae_arw_impl(
    const unsigned char *__restrict__ A, const unsigned char *__restrict__ W,
    const unsigned char *__restrict__ Ws, const unsigned char *__restrict__ Wref,
    const float *__restrict__ As, float *__restrict__ P, int *__restrict__ cnt,
    __bf16 *__restrict__ C, int M, int N, int K, int pb1, int pb2, long astride,
    const int DKS, const int bx_, const int bz_,
    char* peer_scratch, const char* my_scratch, __hip_bfloat16* __restrict__ out,
    unsigned int* peer_flags, unsigned int* my_flags, unsigned int* seq_ctrs,
    long slot_stride_bytes, long fuse_off, int drain, int acq) {
  constexpr int BND = DWN * 16;
  constexpr int DASTR = DBK + DEC_PAD, DWSTR = DBK + DEC_PAD;
  constexpr int DNTHREADS = DWN * 32;
  constexpr int KSTEPS_T = DBK / 16, NTILES_T = BND / 16;
  constexpr int NA = (DEC_MTILE * DTM * DBK + DNTHREADS * 16 - 1) / (DNTHREADS * 16);
  constexpr int NW = (NTILES_T * KSTEPS_T * 32) / (DNTHREADS * 2);
  static_assert((NTILES_T * KSTEPS_T * 32) % (DNTHREADS * 2) == 0, "W slots per thread");
  __shared__ unsigned char sA[DEC_MTILE * DTM * DASTR];
  __shared__ unsigned char sW[BND * DWSTR];
  __shared__ int s_last;

  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int col = lane & 15, kb8 = (lane >> 4) * 8;
  const int n0 = bx_ * BND;
  const int ks = bz_;
  {
    const int p_ = n0 >= pb2 ? 2 : (n0 >= pb1 ? 1 : 0);
    A += (size_t)p_ * astride;
    As += (size_t)p_ * M;
  }
  const int slabs = (K + DBK - 1) / DBK;
  const int spb = (slabs + DKS - 1) / DKS;
  const int s_lo = ks * spb, s_hi = min(slabs, s_lo + spb);

  floatx8 acc[DTM];
#pragma unroll
  for (int i = 0; i < DTM; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0.f;

  const unsigned int *__restrict__ Wp = (const unsigned int *)W;
  const int ksteps_g = K / 16;
  uint4_t ra[NA];
  uint2_t rw[NW];
  unsigned char rref[NW][2], rws[NW][2];

  auto load = [&](int k0) {
#pragma unroll
    for (int j = 0; j < NA; ++j) {
      const int idx = j * DNTHREADS * 16 + tid * 16;
      if (idx < DEC_MTILE * DTM * DBK) {
        const int r = idx / DBK, c = idx % DBK;
        const int rc = r < M - 1 ? r : M - 1;
        ra[j] = *(const uint4_t *)(A + (size_t)rc * K + k0 + c);
      }
    }
    const int kstep0 = k0 / 16;
#pragma unroll
    for (int j = 0; j < NW; ++j) {
      const int sl = j * DNTHREADS * 2 + tid * 2;
      const int lane_ = sl & 31, rest = sl >> 5;
      const int kst = rest % KSTEPS_T, ntl = rest / KSTEPS_T;
      const int r = ntl * 16 + (lane_ & 15);
      const int gn = n0 + r;
      const int gc = gn < N - 2 ? gn : N - 2;
      const int lanec = (lane_ & 16) | (gc & 15);
      rw[j] = ld_w<NT>((const uint2_t *)&Wp[((size_t)(gc >> 4) * ksteps_g + kstep0 + kst) * 32 + lanec]);
      const int blk = (k0 + kst * 16) / 32;
#pragma unroll
      for (int q = 0; q < 2; ++q) {
        rref[j][q] = Wref[gc + q];
        rws[j][q] = Ws[(size_t)blk * N + gc + q];
      }
    }
  };
  auto store = [&]() {
#pragma unroll
    for (int j = 0; j < NA; ++j) {
      const int idx = j * DNTHREADS * 16 + tid * 16;
      if (idx < DEC_MTILE * DTM * DBK) {
        const int r = idx / DBK, c = idx % DBK;
        *(uint4_t *)(&sA[r * DASTR + c]) = ra[j];
      }
    }
#pragma unroll
    for (int j = 0; j < NW; ++j) {
      const int sl = j * DNTHREADS * 2 + tid * 2;
      const int lane_ = sl & 31, rest = sl >> 5;
      const int kst = rest % KSTEPS_T, ntl = rest / KSTEPS_T;
      const int r = ntl * 16 + (lane_ & 15), kloc = kst * 16 + (lane_ >> 4) * 8;
#pragma unroll
      for (int q = 0; q < 2; ++q) {
        int d = (int)rref[j][q] - (int)rws[j][q];
        d = d < 0 ? 0 : (d > 15 ? 15 : d);
        const unsigned int t0 = kMag[d][0], t1 = kMag[d][1];
        const unsigned int ev = wq_dec(rw[j], q) & 0x0F0F0F0Fu;
        const unsigned int od = (wq_dec(rw[j], q) >> 4) & 0x0F0F0F0Fu;
        const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u) | ((ev & 0x08080808u) << 4);
        const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u) | ((od & 0x08080808u) << 4);
        *(uint2_t *)(&sW[(r + q) * DWSTR + kloc]) =
            uint2_t{__builtin_amdgcn_perm(bo, be, 0x05010400u), __builtin_amdgcn_perm(bo, be, 0x07030602u)};
      }
    }
  };
  auto mma_slab = [&]() {
    CMP27E_LDS_BARRIER();
#pragma unroll
    for (int step = 0; step < DBK / 16; ++step) {
      const int kk = step * 16 + kb8;
      int2_t af[DTM], wf;
#pragma unroll
      for (int i = 0; i < DTM; ++i) {
        const unsigned char *pa = &sA[(i * 16 + col) * DASTR + kk];
        af[i][0] = *(const int *)pa; af[i][1] = *(const int *)(pa + 4);
      }
      const unsigned char *pw = &sW[(wave * 16 + col) * DWSTR + kk];
      wf[0] = *(const int *)pw; wf[1] = *(const int *)(pw + 4);
#pragma unroll
      for (int i = 0; i < DTM; ++i)
        acc[i] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(af[i], wf, acc[i]);
    }
    CMP27E_LDS_BARRIER();
  };

  if (s_lo < s_hi) load(s_lo * DBK);
  for (int s = s_lo; s < s_hi; ++s) {
    store();
    if (s + 1 < s_hi) load((s + 1) * DBK);
    mma_slab();
  }

  const int n = n0 + wave * 16 + col;
  if (DKS == 1) {
    if (n < N) {
      const float rf = __int_as_float((int)Wref[n] << 23);
#pragma unroll
      for (int i = 0; i < DTM; ++i)
#pragma unroll
        for (int e = 0; e < 8; ++e) {
          const int m = i * 16 + kb8 + e;
          if (m < M) C[(size_t)m * N + n] = (__bf16)(acc[i][e] * rf * As[m]);
        }
    }
    return;
  }
  if (n < N) {
#pragma unroll
    for (int i = 0; i < DTM; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int m = i * 16 + kb8 + e;
        if (m < M) P[((size_t)ks * M + m) * N + n] = acc[i][e];
      }
  }
  __syncthreads();
  if (tid == 0) {
    __threadfence();
    s_last = (atomicAdd(&cnt[bx_], 1) == DKS - 1);
  }
  __syncthreads();
  if (!s_last) return;
  if (tid == 0) cnt[bx_] = 0;
  // ---- CMP27AE (CMP27AB's probe body): the wht6 all-reduce as the tile's epilogue (the last split-K
  // arriver only). Protocol (engine form): this family's OWN words in the rotated reduce's regions --
  // counter + flag word ARW_WORD0 + bx (80 tiles, every call of the family runs all 80, so each
  // counter IS the family's call count and the slot is the CALL's parity, FN114d's law) and the
  // tile's payload at `fuse_off` inside the slot (below the scales, above every one-shot payload).
  // The tile owns columns [n0, n0 + 64) of every row = ONE rotation group a row. Each lane: row
  // m = p * 16 + wave * 4 + gw, elements lig * 8 .. + 7 (the wpar lane map of one group).
  // C is the shipped fold's value (same sums, same order, bf16-rounded), then the shipped wht6
  // per-group arithmetic. The tile's region of a slot: M groups x 8 lanes x 6 bytes of symbols, then
  // M bf16 scales (the wire carries the shipped symbols and scales; only their PLACE moves:
  // tile-contiguous so a tile pushes whole uint4s and the peer's tile bx reads only tile bx).
  static_assert(DWN == 4, "one 64-element group a row per tile");
  __shared__ unsigned int ab_seq;
  if (tid == 0) ab_seq = atomicAdd(&seq_ctrs[ARW_WORD0 + bx_], 1u) + 1u;
  const int lig = lane & 7, gw = lane >> 3;
  unsigned lw0[DTM], lw1[DTM];
  float lsc[DTM];
  const long TSTR = ((long)M * 50 + 15) / 16 * 16;
  unsigned char* sreg = sA;
#pragma unroll
  for (int p = 0; p < DTM; ++p) {
    const int m = p * 16 + wave * 4 + gw;
    const bool live = m < M;
    float v[AB_EPL];
#pragma unroll
    for (int i = 0; i < AB_EPL; ++i) {
      const int nn = n0 + lig * AB_EPL + i;
      float x = 0.f;
      if (live) {
        const float rf = __int_as_float((int)Wref[nn] << 23);
        float sum = 0.f;
        for (int k = 0; k < DKS; ++k) sum += P[((size_t)k * M + m) * N + nn];
        x = (float)(__bf16)(sum * rf * As[m]);
      }
      v[i] = x;
    }
    ab_quant(v, lig, lw0[p], lw1[p], lsc[p]);
    if (live) {
      unsigned short* q = (unsigned short*)(sreg + m * 48 + lig * 6);
      q[0] = (unsigned short)lw0[p]; q[1] = (unsigned short)(lw0[p] >> 16); q[2] = (unsigned short)lw1[p];
      if (lig == 0) *(unsigned short*)(sreg + M * 48 + 2 * m) = (unsigned short)(__float_as_uint(lsc[p]) >> 16);
    }
  }
  __syncthreads();
  const unsigned int s = ab_seq;
  const int slot = (int)(s & 1u);
  uint4* pt = (uint4*)(peer_scratch + (size_t)slot * slot_stride_bytes + (size_t)fuse_off + (size_t)bx_ * TSTR);
  const uint4* mt = (const uint4*)(my_scratch + (size_t)slot * slot_stride_bytes + (size_t)fuse_off +
                                    (size_t)bx_ * TSTR);
  const int n16 = (int)(TSTR / 16);
  for (int k = tid; k < n16; k += DNTHREADS) pt[k] = ((const uint4*)sreg)[k];
  if (drain == 1) __threadfence_system();
  else if (drain == 3) asm volatile("s_wait_storecnt 0x0" ::: "memory");
  __syncthreads();
  if (tid == 0) {
    if (drain == 2) __threadfence_system();
    ab_store_sys_rel(&peer_flags[ARW_WORD0 + bx_], s);
    unsigned long long z = 0;
    while (ab_load_sys_acq(&my_flags[ARW_WORD0 + bx_]) < s) { if (++z > AB_SPIN_MAX) break; }
  }
  __syncthreads();
  if (acq) __threadfence_system();
  unsigned char* rreg = sW;
  for (int k = tid; k < n16; k += DNTHREADS) ((uint4*)rreg)[k] = mt[k];
  __syncthreads();
#pragma unroll
  for (int p = 0; p < DTM; ++p) {
    const int m = p * 16 + wave * 4 + gw;
    if (m >= M) continue;                                   // whole group: no shuffle is split
    const unsigned short* q = (const unsigned short*)(rreg + m * 48 + lig * 6);
    const unsigned long long pw = (unsigned long long)q[0] | ((unsigned long long)q[1] << 16) |
                                  ((unsigned long long)q[2] << 32);
    const float psc = __uint_as_float((unsigned)*(const unsigned short*)(rreg + M * 48 + 2 * m) << 16);
    const unsigned long long lw = (unsigned long long)lw0[p] | ((unsigned long long)lw1[p] << 32);
    float v[AB_EPL];
    ab_reduce(v, lig, pw, psc, lw, lsc[p]);
    __hip_bfloat16 o[AB_EPL];
#pragma unroll
    for (int i = 0; i < AB_EPL; ++i) o[i] = (__hip_bfloat16)v[i];
    *(uint4*)(out + (size_t)m * N + n0 + lig * AB_EPL) = *(const uint4*)o;
  }
}

#define AB_FUSED(NAME, TM)                                                                              \
  extern "C" __global__ __launch_bounds__(4 * 32) void NAME(                                             \
      const unsigned char *__restrict__ A, const unsigned char *__restrict__ W,                          \
      const unsigned char *__restrict__ Ws, const unsigned char *__restrict__ Wref,                      \
      const float *__restrict__ As, float *__restrict__ P, int *__restrict__ cnt, __bf16 *__restrict__ C, \
      int M, int N, int K, int pb1, int pb2, long astride, char *peer_scratch, const char *my_scratch,    \
      __hip_bfloat16 *__restrict__ out, unsigned int *peer_flags, unsigned int *my_flags,                \
      unsigned int *seq_ctrs, long slot_stride_bytes, long fuse_off, int drain, int acq) {               \
    cmp27ae_arw_impl<4, 128, TM, true>(A, W, Ws, Wref, As, P, cnt, C, M, N, K, pb1, pb2, astride, 2,   \
                                         blockIdx.x, blockIdx.z, peer_scratch, my_scratch, out,          \
                                         peer_flags, my_flags, seq_ctrs, slot_stride_bytes, fuse_off,    \
                                         drain, acq);                                                    \
  }
AB_FUSED(mxfp4_gemm_decode_arw_bk128_ks2_tm2_dwn4, 2)
AB_FUSED(mxfp4_gemm_decode_arw_bk128_ks2_tm4_dwn4, 4)
