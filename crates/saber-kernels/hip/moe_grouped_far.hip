// GENERATED by tools/gen_fn137b_far.py -- do not edit by hand, re-run the generator.
// FN137 Phase B (`--fn-moe-ar-push on`): the half-width fused back half with the MoE-out
// all-reduce fused into its combine slices. The text up to the FN137 marker below is
// `moe_grouped_tp2.hip` up to its first kernel wrapper, verbatim (generated by
// tools/gen_moe_grouped.py), so every helper lowers from the shipped text.
// GENERATED by tools/gen_moe_grouped.py -- do not edit by hand, re-run the deriver.
//
// FN80b-1: the TP=2 HALF-WIDTH expert cells (code object `moe_grouped_tp2`): the down half's
// grouped GEMM at DBK 64 (K 320) and the half-width fused back half. Everything below the
// wrappers is `moe_grouped`'s derived text (FN4 / FN26), unchanged; the half-width back half is
// FN26's at INTER 320 by anchored substitution.
//
// Flash-Next's grouped MXFP4 W4A8 GEMM (workstream FN4) and the expert-major silu-quant producer.
// The GEMM half is DERIVED MECHANICALLY from `mxfp4_gemm_decode.hip`'s own impl (the certified
// split-K decode body): renamed, the merged-linear partition select replaced by the tile lookup,
// the A row, the output row, the partial slab and the arrival counter read through the tile.
// Every line that decides a byte -- W staging, the MX fold, the WMMA loop, the slab partition, the
// fused reduce's order, the `acc * rf * As` epilogue -- is the decode kernel's, character for
// character, so a grouped row IS the dense kernel's row on that expert (the byte oracle,
// tools/capture/fn4/). The producer half is `silu_mul_quant`'s committed impl with its row an
// argument.
//
// The tile law (docs/EXEC.md section 11): the router/sort kernel (`moe_route.hip`) writes the
// routes expert-major, each expert's segment padded to 16 rows (a 16-row block owns ONE expert),
// and cuts each segment into tiles of up to 16*DTM rows. Tile t = (tile_expert[t], tile_row0[t],
// tile_rows[t] live rows); `meta[0]` = the live tile count (a static grid, the tail exits).
// `xptr[3*e + {0,1,2}]` = expert e's `w`, `ws`, `wref` device addresses (an EP rank's local
// experts, then the shared expert; the tier owns the table and may point a slot anywhere).
#include <hip/hip_runtime.h>
#include <hip/hip_bf16.h>
#include "mxfp4_common.h"

#define DEC_DWN 8   // waves per decode block; the N tile is DEC_DWN*16 = 128 wide
#define DEC_MTILE 16
#define DEC_PAD 8
static __device__ __forceinline__ unsigned int wq_dec(uint2_t v, int q) { return q ? v[1] : v[0]; }
template <bool NT, typename T>
static __device__ __forceinline__ T ld_w(const T *p) {
  if constexpr (NT) return __builtin_nontemporal_load(p);
  else return *p;
}

template <int DWN, int DBK, int DKS, int DTM, bool WPERM, bool GATHER, bool DIRECT = true,
          bool NT = false>
__device__ __forceinline__ void moe_grouped_w4a8_impl(
    const unsigned char *__restrict__ A, const unsigned long long *__restrict__ xptr,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok,
    const int *__restrict__ meta,
    const float *__restrict__ As, float *__restrict__ P, int *__restrict__ cnt,
    __bf16 *__restrict__ C, int N, int K, int Pmax) {
  constexpr int BND = DWN * 16;
  constexpr int DASTR = DBK + DEC_PAD, DWSTR = DBK + DEC_PAD;
  constexpr int DNTHREADS = DWN * 32;
  __shared__ unsigned char sA[DEC_MTILE * DTM * DASTR];
  __shared__ unsigned char sW[BND * DWSTR];
  __shared__ int s_last;
  __shared__ int s_arow[DEC_MTILE * DTM];

  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int col = lane & 15, kb8 = (lane >> 4) * 8;
  const int n0 = blockIdx.x * BND;
  const int ks = blockIdx.z;
  // ---- the tile (FN4): which expert, which rows. A tile past the live count exits whole (every
  // split of it alike, so its arrival counter is never touched).
  const int tile = blockIdx.y;
  if (tile >= meta[0]) return;
  const int texp = tile_expert[tile], row0 = tile_row0[tile];
  const int M = tile_rows[tile];
  const unsigned char *__restrict__ W =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 0];
  const unsigned char *__restrict__ Ws =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 1];
  const unsigned char *__restrict__ Wref =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 2];
  // The A row of tile row m: GATHER (gate_up) reads the token the route came from, compact (down)
  // reads the expert-major row itself. Clamped rows (m >= M) are never read: stage_a clamps to
  // M - 1 exactly as the dense kernel does.
  for (int r = tid; r < DEC_MTILE * DTM; r += DNTHREADS) {
    const int rr = r < M - 1 ? r : M - 1;
    s_arow[r] = GATHER ? row_tok[row0 + rr] : row0 + rr;
  }
  __syncthreads();

  const int slabs = (K + DBK - 1) / DBK;
  const int spb = (slabs + DKS - 1) / DKS;
  const int s_lo = ks * spb, s_hi = min(slabs, s_lo + spb);

  floatx8 acc[DTM];
#pragma unroll
  for (int i = 0; i < DTM; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0.f;

  // ---- per-slab pieces, shared by the three slab loops below ----
  constexpr int NITA = (DEC_MTILE * DTM * DBK + DNTHREADS * 16 - 1) / (DNTHREADS * 16);
  const unsigned char *arow_base[NITA];
#pragma unroll
  for (int i = 0; i < NITA; ++i) {
    const int idx = i * DNTHREADS * 16 + tid * 16;
    const int r = idx < DEC_MTILE * DTM * DBK ? idx / DBK : 0;
    const int rc = r < M - 1 ? r : M - 1;                  // clamp, never predicate
    arow_base[i] = A + (size_t)s_arow[rc] * K;
  }
  auto stage_a = [&](int k0) {
#pragma unroll
    for (int off = 0; off < DEC_MTILE * DTM * DBK; off += DNTHREADS * 16) {
      const int idx = off + tid * 16;
      if (idx < DEC_MTILE * DTM * DBK) {
        const int r = idx / DBK, c = idx % DBK;
        const int rc = r < M - 1 ? r : M - 1;                  // clamp, never predicate
        *(uint4_t *)(&sA[r * DASTR + c]) = *(const uint4_t *)(arow_base[off / (DNTHREADS * 16)] + k0 + c);
      }
    }
  };
  // Row-order (checkpoint layout) W staging from a packed 8-byte word per (iteration, thread).
  // getw(it, gc, c) supplies the word so the plain and line-group loops share the fold.
  constexpr int NITW = BND * DBK / 2 / (DNTHREADS * 8);
  auto stage_w_row = [&](int k0, auto &&getw) {
#pragma unroll
    for (int it = 0; it < NITW; ++it) {
      const int idx = it * DNTHREADS * 8 + tid * 8;
      const int r = idx / (DBK / 2), c = idx % (DBK / 2), gn = n0 + r;
      const int gc = gn < N - 1 ? gn : N - 1;                  // clamp, never predicate
      const unsigned long long packed = getw(it, gc, c);
      const int blk = (k0 + c * 2) / 32;
      int dsh = (int)Wref[gc] - (int)Ws[(size_t)blk * N + gc];
      dsh = dsh < 0 ? 0 : (dsh > 15 ? 15 : dsh);
      const unsigned int t0 = kMag[dsh][0], t1 = kMag[dsh][1];
      unsigned int outw[4];
#pragma unroll
      for (int h = 0; h < 2; ++h) {
        const unsigned int wv = (unsigned int)(packed >> (32 * h));
        const unsigned int ev = wv & 0x0F0F0F0Fu;
        const unsigned int od = (wv >> 4) & 0x0F0F0F0Fu;
        const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u)
                              | ((ev & 0x08080808u) << 4);
        const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u)
                              | ((od & 0x08080808u) << 4);
        outw[2 * h]     = __builtin_amdgcn_perm(bo, be, 0x05010400u);
        outw[2 * h + 1] = __builtin_amdgcn_perm(bo, be, 0x07030602u);
      }
      *(uint4_t *)(&sW[r * DWSTR + c * 2]) = uint4_t{outw[0], outw[1], outw[2], outw[3]};
    }
  };
  auto stage_w_wperm = [&](int k0) {
    if constexpr (WPERM) {
      // Fragment order, as in the folded kernel: consecutive threads take consecutive uint32, so
      // a wave's weight read is 128 contiguous bytes instead of sixteen rows K/2 bytes apart.
      // TWO lane slots per thread (an 8 B request), the width the int4 twin measured optimal
      // (4 B was 11% slower there; 16 B identical). Adjacent slots are adjacent rows at the same
      // k, exactly as in the folded kernel above.
      constexpr int KSTEPS_T = DBK / 16, NTILES_T = BND / 16;
      const unsigned int *__restrict__ Wp = (const unsigned int *)W;
      const int ksteps_g = K / 16, kstep0 = k0 / 16;
#pragma unroll
      for (int off = 0; off < NTILES_T * KSTEPS_T * 32; off += DNTHREADS * 2) {
        const int sl = off + tid * 2;                   // first of the pair; always even
        const int lane_ = sl & 31, rest = sl >> 5;
        const int kst = rest % KSTEPS_T, ntl = rest / KSTEPS_T;
        const int r = ntl * 16 + (lane_ & 15), kloc = kst * 16 + (lane_ >> 4) * 8;
        const int gn = n0 + r;
        // Clamp, never predicate; gn is always even here and N % 16 == 0 under WPERM, so
        // clamping to the last even row keeps the uint2 read 8-byte aligned and gc + 1 in
        // bounds; the fragment address is recomputed from the clamped row.
        const int gc = gn < N - 2 ? gn : N - 2;
        const int lanec = (lane_ & 16) | (gc & 15);
        const uint2_t wv = ld_w<NT>(
            (const uint2_t *)&Wp[((size_t)(gc >> 4) * ksteps_g + kstep0 + kst) * 32 + lanec]);
        const int blk = (k0 + kst * 16) / 32;
#pragma unroll
        for (int q = 0; q < 2; ++q) {
          int d = (int)Wref[gc + q] - (int)Ws[(size_t)blk * N + gc + q];
          d = d < 0 ? 0 : (d > 15 ? 15 : d);
          const unsigned int t0 = kMag[d][0], t1 = kMag[d][1];
          const unsigned int ev = wq_dec(wv, q) & 0x0F0F0F0Fu;
          const unsigned int od = (wq_dec(wv, q) >> 4) & 0x0F0F0F0Fu;
          const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u)
                                | ((ev & 0x08080808u) << 4);
          const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u)
                                | ((od & 0x08080808u) << 4);
          *(uint2_t *)(&sW[(r + q) * DWSTR + kloc]) =
              uint2_t{__builtin_amdgcn_perm(bo, be, 0x05010400u),
                      __builtin_amdgcn_perm(bo, be, 0x07030602u)};
        }
      }
    }
  };
  auto mma_slab = [&]() {
    __syncthreads();
#pragma unroll
    for (int step = 0; step < DBK / 16; ++step) {
      const int kk = step * 16 + kb8;
      int2_t af[DTM], wf;
#pragma unroll
      for (int i = 0; i < DTM; ++i) {
        const unsigned char *pa = &sA[(i * 16 + col) * DASTR + kk];
        af[i][0] = *(const int *)pa; af[i][1] = *(const int *)(pa + 4);
      }
      const unsigned char *pw = &sW[(wave * 16 + col) * DWSTR + kk];
      wf[0] = *(const int *)pw; wf[1] = *(const int *)(pw + 4);
#pragma unroll
      for (int i = 0; i < DTM; ++i)
        acc[i] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(af[i], wf, acc[i]);
    }
    __syncthreads();
  };

  if constexpr (WPERM) {
    for (int s = s_lo; s < s_hi; ++s) {
      const int k0 = s * DBK;
      stage_a(k0);
      stage_w_wperm(k0);
      mma_slab();
    }
  } else {
    for (int s = s_lo; s < s_hi; ++s) {
      const int k0 = s * DBK;
      stage_a(k0);
      stage_w_row(k0, [&](int, int gc, int c) {
        return ld_w<NT>((const unsigned long long *)(W + ((size_t)gc * K + k0) / 2 + c));
      });
      mma_slab();
    }
  }

  const int n = n0 + wave * 16 + col;

  // At DKS==1 the accumulator already holds the whole K range, so the partial buffer, the
  // threadfence, the atomic and the reduction pass are all pure overhead -- and that overhead is
  // not small. Partial traffic is DKS*M*N floats: constant in the weight stream but LINEAR IN M,
  // 11.1 MB against gate_up's 44.6 MB of weights at M=40 and 17.8 MB at M=64. Picking DKS by shape
  // and by M is the launcher's job (split_k_for below); this is the path that makes DKS==1 free.
  // Bit-identical to the DKS==1 reduction path, which summed a single term -- the DIRECT=false
  // instantiation exists so that equivalence can be tested rather than asserted.
  if constexpr (DKS == 1 && DIRECT) {
    if (n < N) {
      const float rf = __int_as_float((int)Wref[n] << 23);
#pragma unroll
      for (int i = 0; i < DTM; ++i)
#pragma unroll
        for (int e = 0; e < 8; ++e) {
          const int m = i * 16 + kb8 + e;
          if (m < M) C[(size_t)(row0 + m) * N + n] = (__bf16)(acc[i][e] * rf * As[s_arow[m]]);
        }
    }
    return;
  }

  if (n < N) {
#pragma unroll
    for (int i = 0; i < DTM; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int m = i * 16 + kb8 + e;
        if (m < M) P[((size_t)ks * Pmax + row0 + m) * N + n] = acc[i][e];
      }
  }

  // Fused reduction. The DKS blocks covering one n-range race on an atomic counter and whoever
  // arrives last reduces in place, so there is no second kernel launch -- 13,376 of them per
  // decode run in the profile, at a 4.5 us mean host gap. It is also faster in pure kernel time
  // (-5.5% on gate_up to -29% on gdn.out) because the partials are still in cache when the
  // reduction reads them. The last block resets the counter, leaving it zeroed for the next
  // launch; launches on one stream are serialised, so no separate clearing pass is needed.
  __syncthreads();
  if (tid == 0) {
    __threadfence();
    s_last = (atomicAdd(&cnt[(size_t)tile * gridDim.x + blockIdx.x], 1) == DKS - 1);
  }
  __syncthreads();
  if (!s_last) return;
  if (tid == 0) cnt[(size_t)tile * gridDim.x + blockIdx.x] = 0;

  const int nhi = min(n0 + BND, N);
  for (int nn = n0 + tid; nn < nhi; nn += DNTHREADS) {
    const float rf = __int_as_float((int)Wref[nn] << 23);
    for (int m = 0; m < M; ++m) {
      float sum = 0.f;
      for (int k = 0; k < DKS; ++k) sum += P[((size_t)k * Pmax + row0 + m) * N + nn];
      C[(size_t)(row0 + m) * N + nn] = (__bf16)(sum * rf * As[s_arow[m]]);
    }
  }
}




// ---------------------------------------------------------------- the producer's preamble
#define ARNQ_T 256
typedef unsigned int uint32_tt;
union ArnqVec8 { uint4 u4; __bf16 h[8]; };


// ================================================================ FN26: the decode TRAIN
// DERIVED by tools/gen_moe_grouped.py `derive_train` (workstream FN26). (1) the grouped impl with
// the workgroup's coordinates as arguments, its LDS from an arena, and (PFD 1) the slab loop
// double-buffered in registers -- same slabs, same fold, same LDS images, same WMMA chain, same
// split-K reduce, so the same bytes as the shipped cells; (2) the MoE block's back half (shared
// gate GEMV, gate_up, silu-quant, down, combine) as ONE launch chained by device counters.
template <int DWN, int DTM>
__host__ __device__ constexpr int mx_lds_bytes() {
  return DEC_MTILE * DTM * (128 + DEC_PAD) + DWN * 16 * (128 + DEC_PAD) + 4 * DEC_MTILE * DTM + 16;
}
struct mx_nowait {
  __device__ __forceinline__ void operator()() const {}
};
struct mx_nobar {
  __device__ __forceinline__ void operator()() const {}
};
// FN84 (D): does a wait hook ask the PFD 1 loop to stream slab s_lo + 1's W words before it waits
// (FN84's `mo_wait<true>` of a RAM tile's down workgroup)? Every shipped hook: no (constant false,
// the shipped loop's code).
template <typename F>
static __device__ __forceinline__ constexpr bool mx_pre2(const F &) { return false; }
// FN31 (PFD 2): a GLOBAL load (a flat one also counts on DScnt) and an LDS-scope barrier (a
// `__syncthreads()` is a workgroup release fence = `s_wait_loadcnt 0` on gfx12 WGP mode).
template <bool NT, typename T>
static __device__ __forceinline__ T mx_ldg(const T *p) {
  const __attribute__((address_space(1))) T *g = (const __attribute__((address_space(1))) T *)p;
  if constexpr (NT) return __builtin_nontemporal_load(g);
  else return *g;
}
static __device__ __forceinline__ void mx_lds_barrier() {
  __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
  __builtin_amdgcn_s_barrier();
  __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
}

template <int DWN, int DBK, int DKS, int DTM, bool WPERM, bool GATHER, bool DIRECT, bool NT,
          int PFD, typename WaitF>
__device__ __forceinline__ void moe_grouped_w4a8_x_impl(
    const unsigned char *__restrict__ A, const unsigned long long *__restrict__ xptr,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok,
    const int *__restrict__ meta,
    const float *__restrict__ As, float *__restrict__ P, int *__restrict__ cnt,
    __bf16 *__restrict__ C, int N, int K, int Pmax, unsigned char *__restrict__ smem,
    const int vbx, const int vby, const int vbz, const int vgx, WaitF &&wait) {
  constexpr int BND = DWN * 16;
  constexpr int DASTR = DBK + DEC_PAD, DWSTR = DBK + DEC_PAD;
  constexpr int DNTHREADS = DWN * 32;
  unsigned char *const sA = smem;
  unsigned char *const sW = smem + DEC_MTILE * DTM * DASTR;
  int *const s_arow = (int *)(smem + DEC_MTILE * DTM * DASTR + BND * DWSTR);
  int &s_last = *(int *)(smem + DEC_MTILE * DTM * DASTR + BND * DWSTR + 4 * DEC_MTILE * DTM);

  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int col = lane & 15, kb8 = (lane >> 4) * 8;
  const int n0 = vbx * BND;
  const int ks = vbz;
  // ---- the tile (FN4): which expert, which rows. A tile past the live count exits whole (every
  // split of it alike, so its arrival counter is never touched).
  const int tile = vby;
  if (tile >= meta[0]) return;
  const int texp = tile_expert[tile], row0 = tile_row0[tile];
  const int M = tile_rows[tile];
  const unsigned char *__restrict__ W =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 0];
  const unsigned char *__restrict__ Ws =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 1];
  const unsigned char *__restrict__ Wref =
      (const unsigned char *)(uintptr_t)xptr[3 * (size_t)texp + 2];
  // The A row of tile row m: GATHER (gate_up) reads the token the route came from, compact (down)
  // reads the expert-major row itself. Clamped rows (m >= M) are never read: stage_a clamps to
  // M - 1 exactly as the dense kernel does.
  for (int r = tid; r < DEC_MTILE * DTM; r += DNTHREADS) {
    const int rr = r < M - 1 ? r : M - 1;
    s_arow[r] = GATHER ? row_tok[row0 + rr] : row0 + rr;
  }
  __syncthreads();

  const int slabs = (K + DBK - 1) / DBK;
  const int spb = (slabs + DKS - 1) / DKS;
  const int s_lo = ks * spb, s_hi = min(slabs, s_lo + spb);

  floatx8 acc[DTM];
#pragma unroll
  for (int i = 0; i < DTM; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0.f;

  // ---- per-slab pieces, shared by the three slab loops below ----
  constexpr int NITA = (DEC_MTILE * DTM * DBK + DNTHREADS * 16 - 1) / (DNTHREADS * 16);
  const unsigned char *arow_base[NITA];
#pragma unroll
  for (int i = 0; i < NITA; ++i) {
    const int idx = i * DNTHREADS * 16 + tid * 16;
    const int r = idx < DEC_MTILE * DTM * DBK ? idx / DBK : 0;
    const int rc = r < M - 1 ? r : M - 1;                  // clamp, never predicate
    arow_base[i] = A + (size_t)s_arow[rc] * K;
  }
  auto stage_a = [&](int k0) {
#pragma unroll
    for (int off = 0; off < DEC_MTILE * DTM * DBK; off += DNTHREADS * 16) {
      const int idx = off + tid * 16;
      if (idx < DEC_MTILE * DTM * DBK) {
        const int r = idx / DBK, c = idx % DBK;
        const int rc = r < M - 1 ? r : M - 1;                  // clamp, never predicate
        *(uint4_t *)(&sA[r * DASTR + c]) = *(const uint4_t *)(arow_base[off / (DNTHREADS * 16)] + k0 + c);
      }
    }
  };
  // Row-order (checkpoint layout) W staging from a packed 8-byte word per (iteration, thread).
  // getw(it, gc, c) supplies the word so the plain and line-group loops share the fold.
  constexpr int NITW = BND * DBK / 2 / (DNTHREADS * 8);
  auto stage_w_row = [&](int k0, auto &&getw) {
#pragma unroll
    for (int it = 0; it < NITW; ++it) {
      const int idx = it * DNTHREADS * 8 + tid * 8;
      const int r = idx / (DBK / 2), c = idx % (DBK / 2), gn = n0 + r;
      const int gc = gn < N - 1 ? gn : N - 1;                  // clamp, never predicate
      const unsigned long long packed = getw(it, gc, c);
      const int blk = (k0 + c * 2) / 32;
      int dsh = (int)Wref[gc] - (int)Ws[(size_t)blk * N + gc];
      dsh = dsh < 0 ? 0 : (dsh > 15 ? 15 : dsh);
      const unsigned int t0 = kMag[dsh][0], t1 = kMag[dsh][1];
      unsigned int outw[4];
#pragma unroll
      for (int h = 0; h < 2; ++h) {
        const unsigned int wv = (unsigned int)(packed >> (32 * h));
        const unsigned int ev = wv & 0x0F0F0F0Fu;
        const unsigned int od = (wv >> 4) & 0x0F0F0F0Fu;
        const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u)
                              | ((ev & 0x08080808u) << 4);
        const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u)
                              | ((od & 0x08080808u) << 4);
        outw[2 * h]     = __builtin_amdgcn_perm(bo, be, 0x05010400u);
        outw[2 * h + 1] = __builtin_amdgcn_perm(bo, be, 0x07030602u);
      }
      *(uint4_t *)(&sW[r * DWSTR + c * 2]) = uint4_t{outw[0], outw[1], outw[2], outw[3]};
    }
  };
  auto stage_w_wperm = [&](int k0) {
    if constexpr (WPERM) {
      // Fragment order, as in the folded kernel: consecutive threads take consecutive uint32, so
      // a wave's weight read is 128 contiguous bytes instead of sixteen rows K/2 bytes apart.
      // TWO lane slots per thread (an 8 B request), the width the int4 twin measured optimal
      // (4 B was 11% slower there; 16 B identical). Adjacent slots are adjacent rows at the same
      // k, exactly as in the folded kernel above.
      constexpr int KSTEPS_T = DBK / 16, NTILES_T = BND / 16;
      const unsigned int *__restrict__ Wp = (const unsigned int *)W;
      const int ksteps_g = K / 16, kstep0 = k0 / 16;
#pragma unroll
      for (int off = 0; off < NTILES_T * KSTEPS_T * 32; off += DNTHREADS * 2) {
        const int sl = off + tid * 2;                   // first of the pair; always even
        const int lane_ = sl & 31, rest = sl >> 5;
        const int kst = rest % KSTEPS_T, ntl = rest / KSTEPS_T;
        const int r = ntl * 16 + (lane_ & 15), kloc = kst * 16 + (lane_ >> 4) * 8;
        const int gn = n0 + r;
        // Clamp, never predicate; gn is always even here and N % 16 == 0 under WPERM, so
        // clamping to the last even row keeps the uint2 read 8-byte aligned and gc + 1 in
        // bounds; the fragment address is recomputed from the clamped row.
        const int gc = gn < N - 2 ? gn : N - 2;
        const int lanec = (lane_ & 16) | (gc & 15);
        const uint2_t wv = ld_w<NT>(
            (const uint2_t *)&Wp[((size_t)(gc >> 4) * ksteps_g + kstep0 + kst) * 32 + lanec]);
        const int blk = (k0 + kst * 16) / 32;
#pragma unroll
        for (int q = 0; q < 2; ++q) {
          int d = (int)Wref[gc + q] - (int)Ws[(size_t)blk * N + gc + q];
          d = d < 0 ? 0 : (d > 15 ? 15 : d);
          const unsigned int t0 = kMag[d][0], t1 = kMag[d][1];
          const unsigned int ev = wq_dec(wv, q) & 0x0F0F0F0Fu;
          const unsigned int od = (wq_dec(wv, q) >> 4) & 0x0F0F0F0Fu;
          const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u)
                                | ((ev & 0x08080808u) << 4);
          const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u)
                                | ((od & 0x08080808u) << 4);
          *(uint2_t *)(&sW[(r + q) * DWSTR + kloc]) =
              uint2_t{__builtin_amdgcn_perm(bo, be, 0x05010400u),
                      __builtin_amdgcn_perm(bo, be, 0x07030602u)};
        }
      }
    }
  };
  auto mma_slab = [&]() {
    __syncthreads();
#pragma unroll
    for (int step = 0; step < DBK / 16; ++step) {
      const int kk = step * 16 + kb8;
      int2_t af[DTM], wf;
#pragma unroll
      for (int i = 0; i < DTM; ++i) {
        const unsigned char *pa = &sA[(i * 16 + col) * DASTR + kk];
        af[i][0] = *(const int *)pa; af[i][1] = *(const int *)(pa + 4);
      }
      const unsigned char *pw = &sW[(wave * 16 + col) * DWSTR + kk];
      wf[0] = *(const int *)pw; wf[1] = *(const int *)(pw + 4);
#pragma unroll
      for (int i = 0; i < DTM; ++i)
        acc[i] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(af[i], wf, acc[i]);
    }
    __syncthreads();
  };

  if constexpr (WPERM && PFD == 1) {
    // FN26 (10): slab s + 1's operands in registers while slab s folds and multiplies.
    constexpr int KSTEPS_P = DBK / 16, NTILES_P = BND / 16;
    constexpr int NWI = NTILES_P * KSTEPS_P * 32 / (DNTHREADS * 2);
    static_assert(NWI * DNTHREADS * 2 == NTILES_P * KSTEPS_P * 32, "WPERM slot pairs tile the block");
    const unsigned int *__restrict__ Wp = (const unsigned int *)W;
    const int ksteps_g = K / 16;
    unsigned int wref2[NWI];
#pragma unroll
    for (int it = 0; it < NWI; ++it) {
      const int sl = it * DNTHREADS * 2 + tid * 2;
      const int lane_ = sl & 31, rest = sl >> 5;
      const int ntl = rest / KSTEPS_P;
      const int r = ntl * 16 + (lane_ & 15);
      const int gn = n0 + r;
      const int gc = gn < N - 2 ? gn : N - 2;
      wref2[it] = (unsigned int)Wref[gc] | ((unsigned int)Wref[gc + 1] << 8);
    }
    auto pf_load_w = [&](int k0, uint2_t (&wv)[NWI], unsigned int (&ws2)[NWI]) {
      const int kstep0 = k0 / 16;
#pragma unroll
      for (int it = 0; it < NWI; ++it) {
        const int sl = it * DNTHREADS * 2 + tid * 2;
        const int lane_ = sl & 31, rest = sl >> 5;
        const int kst = rest % KSTEPS_P, ntl = rest / KSTEPS_P;
        const int r = ntl * 16 + (lane_ & 15);
        const int gn = n0 + r;
        const int gc = gn < N - 2 ? gn : N - 2;
        const int lanec = (lane_ & 16) | (gc & 15);
        wv[it] = ld_w<NT>(
            (const uint2_t *)&Wp[((size_t)(gc >> 4) * ksteps_g + kstep0 + kst) * 32 + lanec]);
        const int blk = (k0 + kst * 16) / 32;
        ws2[it] = (unsigned int)Ws[(size_t)blk * N + gc] |
                  ((unsigned int)Ws[(size_t)blk * N + gc + 1] << 8);
      }
    };
    auto pf_load_a = [&](int k0, uint4_t (&av)[NITA]) {
#pragma unroll
      for (int i = 0; i < NITA; ++i) {
        const int idx = i * DNTHREADS * 16 + tid * 16;
        if (idx < DEC_MTILE * DTM * DBK) av[i] = *(const uint4_t *)(arow_base[i] + k0 + idx % DBK);
      }
    };
    auto pf_put = [&](const uint2_t (&wv)[NWI], const unsigned int (&ws2)[NWI],
                      const uint4_t (&av)[NITA]) {
#pragma unroll
      for (int i = 0; i < NITA; ++i) {
        const int idx = i * DNTHREADS * 16 + tid * 16;
        if (idx < DEC_MTILE * DTM * DBK) {
          const int r = idx / DBK, c = idx % DBK;
          *(uint4_t *)(&sA[r * DASTR + c]) = av[i];
        }
      }
#pragma unroll
      for (int it = 0; it < NWI; ++it) {
        const int sl = it * DNTHREADS * 2 + tid * 2;
        const int lane_ = sl & 31, rest = sl >> 5;
        const int kst = rest % KSTEPS_P, ntl = rest / KSTEPS_P;
        const int r = ntl * 16 + (lane_ & 15), kloc = kst * 16 + (lane_ >> 4) * 8;
#pragma unroll
        for (int q = 0; q < 2; ++q) {
          int d = (int)((wref2[it] >> (8 * q)) & 0xFFu) - (int)((ws2[it] >> (8 * q)) & 0xFFu);
          d = d < 0 ? 0 : (d > 15 ? 15 : d);
          const unsigned int t0 = kMag[d][0], t1 = kMag[d][1];
          const unsigned int ev = wq_dec(wv[it], q) & 0x0F0F0F0Fu;
          const unsigned int od = (wq_dec(wv[it], q) >> 4) & 0x0F0F0F0Fu;
          const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u)
                                | ((ev & 0x08080808u) << 4);
          const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u)
                                | ((od & 0x08080808u) << 4);
          *(uint2_t *)(&sW[(r + q) * DWSTR + kloc]) =
              uint2_t{__builtin_amdgcn_perm(bo, be, 0x05010400u),
                      __builtin_amdgcn_perm(bo, be, 0x07030602u)};
        }
      }
    };
    uint2_t wv0[NWI], wv1[NWI];
    unsigned int ws0[NWI], ws1[NWI];
    uint4_t av0[NITA], av1[NITA];
#pragma unroll
    for (int i = 0; i < NITA; ++i) {
      av0[i] = uint4_t{0u, 0u, 0u, 0u};
      av1[i] = av0[i];
    }
    if (s_lo < s_hi) pf_load_w(s_lo * DBK, wv0, ws0);
    const bool pre2 = mx_pre2(wait) && s_lo + 1 < s_hi;
    if (pre2) pf_load_w((s_lo + 1) * DBK, wv1, ws1);
    wait();
    if (s_lo < s_hi) pf_load_a(s_lo * DBK, av0);
    for (int s = s_lo; s < s_hi; s += 2) {
      const bool m1 = s + 1 < s_hi;
      if (m1) {
        if (!pre2 || s != s_lo) pf_load_w((s + 1) * DBK, wv1, ws1);
        pf_load_a((s + 1) * DBK, av1);
      }
      pf_put(wv0, ws0, av0);
      mma_slab();
      if (!m1) break;
      if (s + 2 < s_hi) {
        pf_load_w((s + 2) * DBK, wv0, ws0);
        pf_load_a((s + 2) * DBK, av0);
      }
      pf_put(wv1, ws1, av1);
      mma_slab();
    }
  } else if constexpr (WPERM && PFD == 2) {
    auto mma_slab_l = [&]() {
      mx_lds_barrier();
  #pragma unroll
      for (int step = 0; step < DBK / 16; ++step) {
        const int kk = step * 16 + kb8;
        int2_t af[DTM], wf;
  #pragma unroll
        for (int i = 0; i < DTM; ++i) {
          const unsigned char *pa = &sA[(i * 16 + col) * DASTR + kk];
          af[i][0] = *(const int *)pa; af[i][1] = *(const int *)(pa + 4);
        }
        const unsigned char *pw = &sW[(wave * 16 + col) * DWSTR + kk];
        wf[0] = *(const int *)pw; wf[1] = *(const int *)(pw + 4);
  #pragma unroll
        for (int i = 0; i < DTM; ++i)
          acc[i] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(af[i], wf, acc[i]);
      }
      mx_lds_barrier();
    };
    // FN31: FN26's register buffers; LDS-scope barriers, the fold table in LDS, global loads.
    __shared__ unsigned int s_mag[32];
    if (tid < 32) s_mag[tid] = kMag[tid >> 1][tid & 1];
    mx_lds_barrier();
    constexpr int KSTEPS_P = DBK / 16, NTILES_P = BND / 16;
    constexpr int NWI = NTILES_P * KSTEPS_P * 32 / (DNTHREADS * 2);
    static_assert(NWI * DNTHREADS * 2 == NTILES_P * KSTEPS_P * 32, "WPERM slot pairs tile the block");
    const unsigned int *__restrict__ Wp = (const unsigned int *)W;
    const int ksteps_g = K / 16;
    unsigned int wref2[NWI];
#pragma unroll
    for (int it = 0; it < NWI; ++it) {
      const int sl = it * DNTHREADS * 2 + tid * 2;
      const int lane_ = sl & 31, rest = sl >> 5;
      const int ntl = rest / KSTEPS_P;
      const int r = ntl * 16 + (lane_ & 15);
      const int gn = n0 + r;
      const int gc = gn < N - 2 ? gn : N - 2;
      wref2[it] = (unsigned int)mx_ldg<false>(&Wref[gc]) | ((unsigned int)mx_ldg<false>(&Wref[gc + 1]) << 8);
    }
    auto pf_load_w = [&](int k0, uint2_t (&wv)[NWI], unsigned int (&ws2)[NWI]) {
      const int kstep0 = k0 / 16;
#pragma unroll
      for (int it = 0; it < NWI; ++it) {
        const int sl = it * DNTHREADS * 2 + tid * 2;
        const int lane_ = sl & 31, rest = sl >> 5;
        const int kst = rest % KSTEPS_P, ntl = rest / KSTEPS_P;
        const int r = ntl * 16 + (lane_ & 15);
        const int gn = n0 + r;
        const int gc = gn < N - 2 ? gn : N - 2;
        const int lanec = (lane_ & 16) | (gc & 15);
        wv[it] = mx_ldg<NT>(
            (const uint2_t *)&Wp[((size_t)(gc >> 4) * ksteps_g + kstep0 + kst) * 32 + lanec]);
        const int blk = (k0 + kst * 16) / 32;
        ws2[it] = (unsigned int)mx_ldg<false>(&Ws[(size_t)blk * N + gc]) |
                  ((unsigned int)mx_ldg<false>(&Ws[(size_t)blk * N + gc + 1]) << 8);
      }
    };
    auto pf_load_a = [&](int k0, uint4_t (&av)[NITA]) {
#pragma unroll
      for (int i = 0; i < NITA; ++i) {
        const int idx = i * DNTHREADS * 16 + tid * 16;
        av[i] = mx_ldg<false>((const uint4_t *)(arow_base[i] + k0 + idx % DBK));
      }
    };
    auto pf_put = [&](const uint2_t (&wv)[NWI], const unsigned int (&ws2)[NWI],
                      const uint4_t (&av)[NITA]) {
#pragma unroll
      for (int i = 0; i < NITA; ++i) {
        const int idx = i * DNTHREADS * 16 + tid * 16;
        if (idx < DEC_MTILE * DTM * DBK) {
          const int r = idx / DBK, c = idx % DBK;
          *(uint4_t *)(&sA[r * DASTR + c]) = av[i];
        }
      }
#pragma unroll
      for (int it = 0; it < NWI; ++it) {
        const int sl = it * DNTHREADS * 2 + tid * 2;
        const int lane_ = sl & 31, rest = sl >> 5;
        const int kst = rest % KSTEPS_P, ntl = rest / KSTEPS_P;
        const int r = ntl * 16 + (lane_ & 15), kloc = kst * 16 + (lane_ >> 4) * 8;
#pragma unroll
        for (int q = 0; q < 2; ++q) {
          int d = (int)((wref2[it] >> (8 * q)) & 0xFFu) - (int)((ws2[it] >> (8 * q)) & 0xFFu);
          d = d < 0 ? 0 : (d > 15 ? 15 : d);
          const unsigned int t0 = s_mag[2 * d], t1 = s_mag[2 * d + 1];
          const unsigned int ev = wq_dec(wv[it], q) & 0x0F0F0F0Fu;
          const unsigned int od = (wq_dec(wv[it], q) >> 4) & 0x0F0F0F0Fu;
          const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u)
                                | ((ev & 0x08080808u) << 4);
          const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u)
                                | ((od & 0x08080808u) << 4);
          *(uint2_t *)(&sW[(r + q) * DWSTR + kloc]) =
              uint2_t{__builtin_amdgcn_perm(bo, be, 0x05010400u),
                      __builtin_amdgcn_perm(bo, be, 0x07030602u)};
        }
      }
    };
    uint2_t wv0[NWI], wv1[NWI];
    unsigned int ws0[NWI], ws1[NWI];
    uint4_t av0[NITA], av1[NITA];
    auto sc = [&](int x) { return (x < slabs - 1 ? x : slabs - 1) * DBK; };
    pf_load_w(sc(s_lo), wv0, ws0);
    wait();
    pf_load_a(sc(s_lo), av0);
    for (int s = s_lo; s < s_hi; s += 2) {
      pf_load_w(sc(s + 1), wv1, ws1);
      pf_load_a(sc(s + 1), av1);
      pf_put(wv0, ws0, av0);
      mma_slab_l();
      if (s + 1 >= s_hi) break;
      pf_load_w(sc(s + 2), wv0, ws0);
      pf_load_a(sc(s + 2), av0);
      pf_put(wv1, ws1, av1);
      mma_slab_l();
    }
  } else if constexpr (WPERM && PFD == 3) {
    auto mma_slab_l = [&]() {
      mx_lds_barrier();
  #pragma unroll
      for (int step = 0; step < DBK / 16; ++step) {
        const int kk = step * 16 + kb8;
        int2_t af[DTM], wf;
  #pragma unroll
        for (int i = 0; i < DTM; ++i) {
          const unsigned char *pa = &sA[(i * 16 + col) * DASTR + kk];
          af[i][0] = *(const int *)pa; af[i][1] = *(const int *)(pa + 4);
        }
        const unsigned char *pw = &sW[(wave * 16 + col) * DWSTR + kk];
        wf[0] = *(const int *)pw; wf[1] = *(const int *)(pw + 4);
  #pragma unroll
        for (int i = 0; i < DTM; ++i)
          acc[i] = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(af[i], wf, acc[i]);
      }
      mx_lds_barrier();
    };
    // FN31: FN26's register buffers; LDS-scope barriers, the fold table in LDS, global loads.
    __shared__ unsigned int s_mag[32];
    if (tid < 32) s_mag[tid] = kMag[tid >> 1][tid & 1];
    mx_lds_barrier();
    constexpr int KSTEPS_P = DBK / 16, NTILES_P = BND / 16;
    constexpr int NWI = NTILES_P * KSTEPS_P * 32 / (DNTHREADS * 2);
    static_assert(NWI * DNTHREADS * 2 == NTILES_P * KSTEPS_P * 32, "WPERM slot pairs tile the block");
    const unsigned int *__restrict__ Wp = (const unsigned int *)W;
    const int ksteps_g = K / 16;
    unsigned int wref2[NWI];
#pragma unroll
    for (int it = 0; it < NWI; ++it) {
      const int sl = it * DNTHREADS * 2 + tid * 2;
      const int lane_ = sl & 31, rest = sl >> 5;
      const int ntl = rest / KSTEPS_P;
      const int r = ntl * 16 + (lane_ & 15);
      const int gn = n0 + r;
      const int gc = gn < N - 2 ? gn : N - 2;
      wref2[it] = (unsigned int)mx_ldg<false>(&Wref[gc]) | ((unsigned int)mx_ldg<false>(&Wref[gc + 1]) << 8);
    }
    auto pf_load_w = [&](int k0, uint2_t (&wv)[NWI], unsigned int (&ws2)[NWI]) {
      const int kstep0 = k0 / 16;
#pragma unroll
      for (int it = 0; it < NWI; ++it) {
        const int sl = it * DNTHREADS * 2 + tid * 2;
        const int lane_ = sl & 31, rest = sl >> 5;
        const int kst = rest % KSTEPS_P, ntl = rest / KSTEPS_P;
        const int r = ntl * 16 + (lane_ & 15);
        const int gn = n0 + r;
        const int gc = gn < N - 2 ? gn : N - 2;
        const int lanec = (lane_ & 16) | (gc & 15);
        wv[it] = mx_ldg<NT>(
            (const uint2_t *)&Wp[((size_t)(gc >> 4) * ksteps_g + kstep0 + kst) * 32 + lanec]);
        const int blk = (k0 + kst * 16) / 32;
        ws2[it] = (unsigned int)mx_ldg<false>(&Ws[(size_t)blk * N + gc]) |
                  ((unsigned int)mx_ldg<false>(&Ws[(size_t)blk * N + gc + 1]) << 8);
      }
    };
    auto pf_load_a = [&](int k0, uint4_t (&av)[NITA]) {
#pragma unroll
      for (int i = 0; i < NITA; ++i) {
        const int idx = i * DNTHREADS * 16 + tid * 16;
        av[i] = mx_ldg<false>((const uint4_t *)(arow_base[i] + k0 + idx % DBK));
      }
    };
    auto pf_put = [&](const uint2_t (&wv)[NWI], const unsigned int (&ws2)[NWI],
                      const uint4_t (&av)[NITA]) {
#pragma unroll
      for (int i = 0; i < NITA; ++i) {
        const int idx = i * DNTHREADS * 16 + tid * 16;
        if (idx < DEC_MTILE * DTM * DBK) {
          const int r = idx / DBK, c = idx % DBK;
          *(uint4_t *)(&sA[r * DASTR + c]) = av[i];
        }
      }
#pragma unroll
      for (int it = 0; it < NWI; ++it) {
        const int sl = it * DNTHREADS * 2 + tid * 2;
        const int lane_ = sl & 31, rest = sl >> 5;
        const int kst = rest % KSTEPS_P, ntl = rest / KSTEPS_P;
        const int r = ntl * 16 + (lane_ & 15), kloc = kst * 16 + (lane_ >> 4) * 8;
#pragma unroll
        for (int q = 0; q < 2; ++q) {
          int d = (int)((wref2[it] >> (8 * q)) & 0xFFu) - (int)((ws2[it] >> (8 * q)) & 0xFFu);
          d = d < 0 ? 0 : (d > 15 ? 15 : d);
          const unsigned int t0 = s_mag[2 * d], t1 = s_mag[2 * d + 1];
          const unsigned int ev = wq_dec(wv[it], q) & 0x0F0F0F0Fu;
          const unsigned int od = (wq_dec(wv[it], q) >> 4) & 0x0F0F0F0Fu;
          const unsigned int be = __builtin_amdgcn_perm(t1, t0, ev & 0x07070707u)
                                | ((ev & 0x08080808u) << 4);
          const unsigned int bo = __builtin_amdgcn_perm(t1, t0, od & 0x07070707u)
                                | ((od & 0x08080808u) << 4);
          *(uint2_t *)(&sW[(r + q) * DWSTR + kloc]) =
              uint2_t{__builtin_amdgcn_perm(bo, be, 0x05010400u),
                      __builtin_amdgcn_perm(bo, be, 0x07030602u)};
        }
      }
    };
    uint2_t wv0[NWI], wv1[NWI], wv2[NWI];
    unsigned int ws0[NWI], ws1[NWI], ws2_[NWI];
    uint4_t av0[NITA], av1[NITA], av2[NITA];
    auto sc = [&](int x) { return (x < slabs - 1 ? x : slabs - 1) * DBK; };
    pf_load_w(sc(s_lo), wv0, ws0);
    wait();
    pf_load_a(sc(s_lo), av0);
    pf_load_w(sc(s_lo + 1), wv1, ws1);
    pf_load_a(sc(s_lo + 1), av1);
    for (int s = s_lo; s < s_hi; s += 3) {
      pf_load_w(sc(s + 2), wv2, ws2_);
      pf_load_a(sc(s + 2), av2);
      pf_put(wv0, ws0, av0);
      mma_slab_l();
      if (s + 1 >= s_hi) break;
      pf_load_w(sc(s + 3), wv0, ws0);
      pf_load_a(sc(s + 3), av0);
      pf_put(wv1, ws1, av1);
      mma_slab_l();
      if (s + 2 >= s_hi) break;
      pf_load_w(sc(s + 4), wv1, ws1);
      pf_load_a(sc(s + 4), av1);
      pf_put(wv2, ws2_, av2);
      mma_slab_l();
    }
  } else if constexpr (WPERM) {
    wait();
    for (int s = s_lo; s < s_hi; ++s) {
      const int k0 = s * DBK;
      stage_a(k0);
      stage_w_wperm(k0);
      mma_slab();
    }
  } else {
    wait();
    for (int s = s_lo; s < s_hi; ++s) {
      const int k0 = s * DBK;
      stage_a(k0);
      stage_w_row(k0, [&](int, int gc, int c) {
        return ld_w<NT>((const unsigned long long *)(W + ((size_t)gc * K + k0) / 2 + c));
      });
      mma_slab();
    }
  }

  const int n = n0 + wave * 16 + col;

  // At DKS==1 the accumulator already holds the whole K range, so the partial buffer, the
  // threadfence, the atomic and the reduction pass are all pure overhead -- and that overhead is
  // not small. Partial traffic is DKS*M*N floats: constant in the weight stream but LINEAR IN M,
  // 11.1 MB against gate_up's 44.6 MB of weights at M=40 and 17.8 MB at M=64. Picking DKS by shape
  // and by M is the launcher's job (split_k_for below); this is the path that makes DKS==1 free.
  // Bit-identical to the DKS==1 reduction path, which summed a single term -- the DIRECT=false
  // instantiation exists so that equivalence can be tested rather than asserted.
  if constexpr (DKS == 1 && DIRECT) {
    if (n < N) {
      const float rf = __int_as_float((int)Wref[n] << 23);
#pragma unroll
      for (int i = 0; i < DTM; ++i)
#pragma unroll
        for (int e = 0; e < 8; ++e) {
          const int m = i * 16 + kb8 + e;
          if (m < M) C[(size_t)(row0 + m) * N + n] = (__bf16)(acc[i][e] * rf * As[s_arow[m]]);
        }
    }
    return;
  }

  if (n < N) {
#pragma unroll
    for (int i = 0; i < DTM; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int m = i * 16 + kb8 + e;
        if (m < M) P[((size_t)ks * Pmax + row0 + m) * N + n] = acc[i][e];
      }
  }

  // Fused reduction. The DKS blocks covering one n-range race on an atomic counter and whoever
  // arrives last reduces in place, so there is no second kernel launch -- 13,376 of them per
  // decode run in the profile, at a 4.5 us mean host gap. It is also faster in pure kernel time
  // (-5.5% on gate_up to -29% on gdn.out) because the partials are still in cache when the
  // reduction reads them. The last block resets the counter, leaving it zeroed for the next
  // launch; launches on one stream are serialised, so no separate clearing pass is needed.
  __syncthreads();
  if (tid == 0) {
    __threadfence();
    s_last = (atomicAdd(&cnt[(size_t)tile * vgx + vbx], 1) == DKS - 1);
  }
  __syncthreads();
  if (!s_last) return;
  if (tid == 0) cnt[(size_t)tile * vgx + vbx] = 0;

  const int nhi = min(n0 + BND, N);
  for (int nn = n0 + tid; nn < nhi; nn += DNTHREADS) {
    const float rf = __int_as_float((int)Wref[nn] << 23);
    for (int m = 0; m < M; ++m) {
      float sum = 0.f;
      for (int k = 0; k < DKS; ++k) sum += P[((size_t)k * Pmax + row0 + m) * N + nn];
      C[(size_t)(row0 + m) * N + nn] = (__bf16)(sum * rf * As[s_arow[m]]);
    }
  }
}



// The silu-quant of ONE expert-major row with a WAVE (`moe_silu_mul_quant_impl`'s expressions: the
// producer's per-thread group loop over the wave's 32 lanes -- 80 groups of 8 at N 640, 3 a lane
// -- and its block-wide amax as a wave-wide one: a max of the same values, order-free and exact).
// N <= 768.
__device__ __forceinline__ void mx_silu_row_wave(const int row, const __bf16 *__restrict__ gu,
                                                 unsigned char *__restrict__ q,
                                                 float *__restrict__ scale, const int N) {
  const int lane = threadIdx.x & 31;
  gu += (long)row * 2 * N;
  q += (long)row * N;
  constexpr int MAXG = 3;
  const int NV = N >> 3;
  float pv[MAXG][8];
  float amax = 0.f;
#pragma unroll
  for (int ng = 0; ng < MAXG; ++ng) {
    const int g = lane + ng * 32;
    if (g >= NV) break;
    ArnqVec8 vg, vu;
    vg.u4 = ((const uint4 *)gu)[g];
    vu.u4 = ((const uint4 *)(gu + N))[g];
#pragma unroll
    for (int j = 0; j < 8; ++j) {
      float x = (float)vg.h[j];
      float t = (float)(__bf16)(x / (1.f + expf(-x)));       // silu, rounded to bf16
      float p = (float)(__bf16)(t * (float)vu.h[j]);         // product, rounded to bf16
      pv[ng][j] = p;
      amax = fmaxf(amax, fabsf(p));
    }
  }
  for (int o = 16; o; o >>= 1) amax = fmaxf(amax, __shfl_xor(amax, o));
  const float sc = fmaxf(amax * (1.f / 448.f), 1.f / (448.f * 512.f));
  const float rs = 1.f / sc;
  if (lane == 0) scale[row] = sc;
#pragma unroll
  for (int mg = 0; mg < MAXG; ++mg) {
    const int g = lane + mg * 32;
    if (g >= NV) break;
    uint32_tt lo = 0, hi = 0;
#pragma unroll
    for (int j = 0; j < 4; j += 2) {
      float a = fminf(fmaxf(pv[mg][j] * rs, -448.f), 448.f);
      float b = fminf(fmaxf(pv[mg][j + 1] * rs, -448.f), 448.f);
      lo |= (__builtin_amdgcn_cvt_pk_fp8_f32(a, b, 0u, false) & 0xffffu) << (j * 8);
    }
#pragma unroll
    for (int j = 4; j < 8; j += 2) {
      float a = fminf(fmaxf(pv[mg][j] * rs, -448.f), 448.f);
      float b = fminf(fmaxf(pv[mg][j + 1] * rs, -448.f), 448.f);
      hi |= (__builtin_amdgcn_cvt_pk_fp8_f32(a, b, 0u, false) & 0xffffu) << ((j - 4) * 8);
    }
    ((uint2 *)q)[g] = make_uint2(lo, hi);
  }
}

// ---- below: contraction OFF (FN5's band, moe_route's exp / sigmoid and combine are built so)
#pragma clang fp contract(off)
typedef __bf16 mx_bf16x8 __attribute__((ext_vector_type(8)));
__device__ __forceinline__ floatx8 mx_vg_wmma(mx_bf16x8 a, mx_bf16x8 b, floatx8 c) {
  return __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32_gfx12(a, b, c);
}
#define MX_FB_NW 4
#define MX_FB_UNR 8
template <int MROWS, typename BarF>
__device__ __forceinline__ void moe_x_bgemm_sk_body(const __bf16 *__restrict__ a,
                                                 const __bf16 *__restrict__ w,
                                                 float *__restrict__ part, int *__restrict__ cnt,
                                                 __bf16 *__restrict__ c, int m, int n, int k,
    const int vbx, const int vby, const int vbz, const int vgx, const int vgz,
    int *__restrict__ s_last_p, BarF &&bar) {
  constexpr int MF = MROWS / 16;
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int n0 = (vbx * MX_FB_NW + wave) * 16;
  const int m0 = vby * MROWS;
  const int sp = vbz, nsp = vgz;
  const int kw = k / nsp, kb = sp * kw;
  const int row = lane & 15, kh = (lane >> 4) * 8;
  int &s_last = *s_last_p;
  const bool live = n0 < n;
  const __bf16 *ap[MF];
#pragma unroll
  for (int mf = 0; mf < MF; ++mf) ap[mf] = a + (long)min(m0 + mf * 16 + row, m - 1) * k + kb + kh;
  const __bf16 *wp = w + (long)min(n0 + row, n - 1) * k + kb + kh;
  floatx8 acc[MF];
#pragma unroll
  for (int mf = 0; mf < MF; ++mf)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[mf][e] = 0.f;
  const int ksteps = live ? kw / 16 : 0;
  int ks = 0;
  for (; ks + MX_FB_UNR <= ksteps; ks += MX_FB_UNR) {
    mx_bf16x8 af[MF][MX_FB_UNR], wf[MX_FB_UNR];
#pragma unroll
    for (int u = 0; u < MX_FB_UNR; ++u) {
#pragma unroll
      for (int mf = 0; mf < MF; ++mf) af[mf][u] = *(const mx_bf16x8 *)(ap[mf] + (ks + u) * 16);
      wf[u] = *(const mx_bf16x8 *)(wp + (ks + u) * 16);
    }
#pragma unroll
    for (int u = 0; u < MX_FB_UNR; ++u)
#pragma unroll
      for (int mf = 0; mf < MF; ++mf) acc[mf] = mx_vg_wmma(af[mf][u], wf[u], acc[mf]);
  }
  for (; ks < ksteps; ++ks) {
    const mx_bf16x8 wv = *(const mx_bf16x8 *)(wp + ks * 16);
#pragma unroll
    for (int mf = 0; mf < MF; ++mf)
      acc[mf] = mx_vg_wmma(*(const mx_bf16x8 *)(ap[mf] + ks * 16), wv, acc[mf]);
  }
  const int col = n0 + (lane & 15);
  if (nsp == 1) {                                 // one slice: the band itself, no partials
    if (!live || col >= n) return;
#pragma unroll
    for (int mf = 0; mf < MF; ++mf)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int r = m0 + mf * 16 + (lane >> 4) * 8 + e;
        if (r < m) c[(long)r * n + col] = (__bf16)acc[mf][e];
      }
    return;
  }
  if (live && col < n) {
#pragma unroll
    for (int mf = 0; mf < MF; ++mf)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int r = m0 + mf * 16 + (lane >> 4) * 8 + e;
        if (r < m) part[((long)sp * m + r) * n + col] = acc[mf][e];
      }
  }
  bar();
  const int tile = vby * vgx + vbx;
  if (tid == 0) {
    __threadfence();
    s_last = atomicAdd(&cnt[tile], 1) == nsp - 1;
  }
  bar();
  if (!s_last) return;
  if (tid == 0) cnt[tile] = 0;
  __threadfence();
  const int nb = vbx * MX_FB_NW * 16;
  const int ncols = min(MX_FB_NW * 16, n - nb), nrows = min(MROWS, m - m0);
  for (int idx = tid; idx < nrows * ncols; idx += MX_FB_NW * 32) {
    const int rl = idx / ncols, cc = nb + (idx - rl * ncols), r = m0 + rl;
    float v = part[(long)r * n + cc];
    for (int p = 1; p < nsp; ++p) v = v + part[((long)p * m + r) * n + cc];
    c[(long)r * n + cc] = (__bf16)v;
  }
}


static __device__ __forceinline__ float mx_f32_bits(unsigned int u) { return __uint_as_float(u); }

// e^x for x <= 0, from IEEE-rounded mul/add/rint/ldexp only (bit-reproducible on the host):
//   n = rint(x * log2e); r = (x - n*C1) - n*C2; e^r by Horner (Taylor, degree 7, |r| <= 0.347);
//   ldexp(p, n). C1 = ln2's top 16 bits (n*C1 exact for |n| < 256). x <= -80 (or NaN) -> 0: a
// probability below e^-80 relative to the row's max cannot reach a top-10 of 512 real logits and
// cannot move a sum that holds the max's 1.0.
static __device__ __forceinline__ float mx_exp_nonpos(float x) {
  if (!(x > -80.f)) return 0.f;
  const float n = __builtin_rintf(x * mx_f32_bits(0x3FB8AA3Bu));      // log2(e)
  float r = x - n * mx_f32_bits(0x3F317200u);                         // C1 = 0.693145751953125
  r = r - n * mx_f32_bits(0x35BFBE8Eu);                               // C2 = ln2 - C1
  float p = mx_f32_bits(0x39500D01u);                                 // 1/5040
  p = p * r + mx_f32_bits(0x3AB60B61u);                               // 1/720
  p = p * r + mx_f32_bits(0x3C088889u);                               // 1/120
  p = p * r + mx_f32_bits(0x3D2AAAABu);                               // 1/24
  p = p * r + mx_f32_bits(0x3E2AAAABu);                               // 1/6
  p = p * r + 0.5f;
  p = p * r + 1.f;
  p = p * r + 1.f;
  return __builtin_ldexpf(p, (int)n);
}

static __device__ __forceinline__ float mx_sigmoid(float g) {
  const float e = mx_exp_nonpos(-fabsf(g));
  const float d = 1.f + e;
  return g >= 0.f ? 1.f / d : e / d;
}


// The combine for ONE 128-column slice (n-block nb) of every token: `moe_combine_bf16`'s
// arithmetic for its groups g in [16 nb, 16 nb + 16) -- fp32, the routes in top-k order (a
// non-local route contributes nothing), the shared row weighted by sigmoid(g) last, one bf16
// rounding.
#define MX_TOPK 10
__device__ __forceinline__ void mx_combine_slice(
    const int nb, const int T, const __bf16 *__restrict__ Y, const float *__restrict__ topk_w,
    const int *__restrict__ route_pos, const __bf16 *__restrict__ sgate,
    const int *__restrict__ meta, __bf16 *__restrict__ out) {
  constexpr int H = 2560;
  const int sh0 = meta[2];
  const bool shared = sh0 >= 0 && sgate != nullptr;
  union V { uint4 u; __bf16 h[8]; };
  for (int i = threadIdx.x; i < T * 16; i += blockDim.x) {
    const int t = i >> 4, g = nb * 16 + (i & 15);
    const float sg = shared ? mx_sigmoid((float)sgate[t]) : 0.f;
    float acc[8];
#pragma unroll
    for (int j = 0; j < 8; ++j) acc[j] = 0.f;
    for (int k = 0; k < MX_TOPK; ++k) {
      const int p = route_pos[(size_t)t * MX_TOPK + k];
      if (p < 0) continue;
      const float w = topk_w[(size_t)t * MX_TOPK + k];
      V y;
      y.u = ((const uint4 *)(Y + (size_t)p * H))[g];
#pragma unroll
      for (int j = 0; j < 8; ++j) acc[j] = acc[j] + w * (float)y.h[j];
    }
    if (shared) {
      V y;
      y.u = ((const uint4 *)(Y + (size_t)(sh0 + t) * H))[g];
#pragma unroll
      for (int j = 0; j < 8; ++j) acc[j] = acc[j] + sg * (float)y.h[j];
    }
    V o;
#pragma unroll
    for (int j = 0; j < 8; ++j) o.h[j] = (__bf16)acc[j];
    ((uint4 *)(out + (size_t)t * H))[g] = o.u;
  }
}

// The fused back half. `sync` (i32, zero at allocation, zero again after every launch):
//   [0] ticket  [1] gate-GEMV flag  [2] combine slices done  [3, 23) per down n-block arrivals
//   [23, 23 + tc) gate_up arrivals per tile  [.., + tc) silu flag per tile  [.., + tc) down
//   arrivals per tile. Grid: 1 + tc * 10 * KSG + tc * 20 * KSD workgroups of 256 (1-D). T <= 64.
template <int KSG, int KSD, int PFD>
__device__ __forceinline__ void moe_back_impl(
    const unsigned char *__restrict__ A, const float *__restrict__ As,
    const unsigned long long *__restrict__ xgu, const unsigned long long *__restrict__ xdn,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok,
    const int *__restrict__ meta, float *__restrict__ Pgu, float *__restrict__ Pdn,
    int *__restrict__ cgu, int *__restrict__ cdn, __bf16 *__restrict__ GU,
    unsigned char *__restrict__ Q, float *__restrict__ QS, __bf16 *__restrict__ Y,
    const float *__restrict__ topk_w, const int *__restrict__ route_pos,
    const __bf16 *__restrict__ wsg, const __bf16 *__restrict__ bi, __bf16 *__restrict__ sg,
    __bf16 *__restrict__ out, int *__restrict__ sync, const int T, const int Pmax,
    const int tc) {
  constexpr int NBG = 1280 / 128, NBD = 2560 / 128;
  __shared__ __attribute__((aligned(16))) unsigned char smem[mx_lds_bytes<DEC_DWN, 1>()];
  __shared__ int s_v, s_f0, s_f1, s_sl;
  const int tid = threadIdx.x;
  int *const tk = sync, *const sgf = sync + 1, *const cdone = sync + 2, *const nbc = sync + 3;
  int *const gdone = sync + 3 + NBD, *const sready = gdone + tc, *const ddone = sready + tc;
  if (tid == 0) {
    const int v = atomicAdd(tk, 1);
    if (v == (int)gridDim.x - 1) *tk = 0;   // every ticket is taken: the counter is free again
    s_v = v;
  }
  __syncthreads();
  const int v = __builtin_amdgcn_readfirstlane(s_v);
  const int ntile = meta[0];
  if (v == 0) {
    // The shared-expert gate logit: FN5's band at ONE split (the engine's `fn_bgemm_sk_m16`, M 1 =
    // the gate row, N = T = the block input's rows); waves 4..7 own columns >= 64 > T: idle.
    moe_x_bgemm_sk_body<16>(wsg, bi, nullptr, nullptr, sg, 1, T, 2560, 0, 0, 0, 1, 1, &s_sl,
                            mx_nobar{});
    __syncthreads();
    __threadfence();
    if (ntile == 0) {   // no expert rows on this rank: the combine is its (all-remote) zero sum
      for (int nb = 0; nb < NBD; ++nb) mx_combine_slice(nb, T, Y, topk_w, route_pos, sg, meta, out);
      return;
    }
    if (tid == 0) __hip_atomic_store(sgf, 1, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
    return;
  }
  int u = v - 1;
  const int NGU = tc * NBG * KSG;
  if (u < NGU) {
    const int tile = u / (NBG * KSG), rem = u - tile * (NBG * KSG);
    const int nb = rem / KSG, ks = rem - nb * KSG;
    if (tile >= ntile) return;
    moe_grouped_w4a8_x_impl<DEC_DWN, 128, KSG, 1, true, true, true, true, PFD>(
        A, xgu, tile_expert, tile_row0, tile_rows, row_tok, meta, As, Pgu, cgu, GU, 1280, 2560,
        Pmax, smem, nb, tile, ks, NBG, mx_nowait{});
    __syncthreads();
    if (tid == 0) {
      __threadfence();
      s_f0 = atomicAdd(&gdone[tile], 1) == NBG * KSG - 1;
    }
    __syncthreads();
    if (!s_f0) return;
    __threadfence();                                   // acquire: every n-block's gu rows
    if (tid == 0) gdone[tile] = 0;
    const int row0 = tile_row0[tile], M = tile_rows[tile];
    for (int m = tid >> 5; m < M; m += DEC_DWN) mx_silu_row_wave(row0 + m, GU, Q, QS, 640);
    __syncthreads();
    if (tid == 0) {
      __threadfence();
      __hip_atomic_store(&sready[tile], 1, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
    }
    return;
  }
  u -= NGU;
  const int tile = u / (NBD * KSD), rem = u - tile * (NBD * KSD);
  const int nb = rem / KSD, ks = rem - nb * KSD;
  if (tile >= ntile) return;
  auto wait_silu = [&]() {
    if (tid == 0)
      while (__hip_atomic_load(&sready[tile], __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT) == 0)
        __builtin_amdgcn_s_sleep(2);
    __syncthreads();
    __threadfence();
  };
  moe_grouped_w4a8_x_impl<DEC_DWN, 128, KSD, 1, true, false, true, true, PFD>(
      Q, xdn, tile_expert, tile_row0, tile_rows, row_tok, meta, QS, Pdn, cdn, Y, 2560, 640, Pmax,
      smem, nb, tile, ks, NBD, wait_silu);
  __syncthreads();
  if (tid == 0) {
    __threadfence();
    s_f0 = atomicAdd(&ddone[tile], 1) == NBD * KSD - 1;
    s_f1 = atomicAdd(&nbc[nb], 1) == ntile * KSD - 1;
    if (s_f0) {                                        // every down workgroup of the tile passed
      sready[tile] = 0;
      ddone[tile] = 0;
    }
  }
  __syncthreads();
  if (!s_f1) return;
  __threadfence();                                     // acquire: every tile's Y columns of nb
  if (tid == 0) {
    nbc[nb] = 0;
    while (__hip_atomic_load(sgf, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT) == 0)
      __builtin_amdgcn_s_sleep(2);
  }
  __syncthreads();
  __threadfence();
  mx_combine_slice(nb, T, Y, topk_w, route_pos, sg, meta, out);
  if (tid == 0 && atomicAdd(cdone, 1) == NBD - 1) {    // the last slice: the gate flag is free
    *cdone = 0;
    __hip_atomic_store(sgf, 0, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
  }
}


// FN80b-1: the HALF-WIDTH fused back half (TP=2: INTER 320 -- gate_up N 640 = 5 n-blocks,
// silu n 320, down K 320 at DBK 64; the shared-gate GEMV and the combine unchanged). `sync` (i32, zero at allocation, zero again after every launch):
//   [0] ticket  [1] gate-GEMV flag  [2] combine slices done  [3, 23) per down n-block arrivals
//   [23, 23 + tc) gate_up arrivals per tile  [.., + tc) silu flag per tile  [.., + tc) down
//   arrivals per tile. Grid: 1 + tc * 5 * KSG + tc * 20 * KSD workgroups of 256 (1-D). T <= 64.
template <int KSG, int KSD, int PFD>
__device__ __forceinline__ void moe_back_h2_impl(
    const unsigned char *__restrict__ A, const float *__restrict__ As,
    const unsigned long long *__restrict__ xgu, const unsigned long long *__restrict__ xdn,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok,
    const int *__restrict__ meta, float *__restrict__ Pgu, float *__restrict__ Pdn,
    int *__restrict__ cgu, int *__restrict__ cdn, __bf16 *__restrict__ GU,
    unsigned char *__restrict__ Q, float *__restrict__ QS, __bf16 *__restrict__ Y,
    const float *__restrict__ topk_w, const int *__restrict__ route_pos,
    const __bf16 *__restrict__ wsg, const __bf16 *__restrict__ bi, __bf16 *__restrict__ sg,
    __bf16 *__restrict__ out, int *__restrict__ sync, const int T, const int Pmax,
    const int tc) {
  constexpr int NBG = 640 / 128, NBD = 2560 / 128;
  __shared__ __attribute__((aligned(16))) unsigned char smem[mx_lds_bytes<DEC_DWN, 1>()];
  __shared__ int s_v, s_f0, s_f1, s_sl;
  const int tid = threadIdx.x;
  int *const tk = sync, *const sgf = sync + 1, *const cdone = sync + 2, *const nbc = sync + 3;
  int *const gdone = sync + 3 + NBD, *const sready = gdone + tc, *const ddone = sready + tc;
  if (tid == 0) {
    const int v = atomicAdd(tk, 1);
    if (v == (int)gridDim.x - 1) *tk = 0;   // every ticket is taken: the counter is free again
    s_v = v;
  }
  __syncthreads();
  const int v = __builtin_amdgcn_readfirstlane(s_v);
  const int ntile = meta[0];
  if (v == 0) {
    // The shared-expert gate logit: FN5's band at ONE split (the engine's `fn_bgemm_sk_m16`, M 1 =
    // the gate row, N = T = the block input's rows); waves 4..7 own columns >= 64 > T: idle.
    moe_x_bgemm_sk_body<16>(wsg, bi, nullptr, nullptr, sg, 1, T, 2560, 0, 0, 0, 1, 1, &s_sl,
                            mx_nobar{});
    __syncthreads();
    __threadfence();
    if (ntile == 0) {   // no expert rows on this rank: the combine is its (all-remote) zero sum
      for (int nb = 0; nb < NBD; ++nb) mx_combine_slice(nb, T, Y, topk_w, route_pos, sg, meta, out);
      return;
    }
    if (tid == 0) __hip_atomic_store(sgf, 1, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
    return;
  }
  int u = v - 1;
  const int NGU = tc * NBG * KSG;
  if (u < NGU) {
    const int tile = u / (NBG * KSG), rem = u - tile * (NBG * KSG);
    const int nb = rem / KSG, ks = rem - nb * KSG;
    if (tile >= ntile) return;
    moe_grouped_w4a8_x_impl<DEC_DWN, 128, KSG, 1, true, true, true, true, PFD>(
        A, xgu, tile_expert, tile_row0, tile_rows, row_tok, meta, As, Pgu, cgu, GU, 640, 2560,
        Pmax, smem, nb, tile, ks, NBG, mx_nowait{});
    __syncthreads();
    if (tid == 0) {
      __threadfence();
      s_f0 = atomicAdd(&gdone[tile], 1) == NBG * KSG - 1;
    }
    __syncthreads();
    if (!s_f0) return;
    __threadfence();                                   // acquire: every n-block's gu rows
    if (tid == 0) gdone[tile] = 0;
    const int row0 = tile_row0[tile], M = tile_rows[tile];
    for (int m = tid >> 5; m < M; m += DEC_DWN) mx_silu_row_wave(row0 + m, GU, Q, QS, 320);
    __syncthreads();
    if (tid == 0) {
      __threadfence();
      __hip_atomic_store(&sready[tile], 1, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
    }
    return;
  }
  u -= NGU;
  const int tile = u / (NBD * KSD), rem = u - tile * (NBD * KSD);
  const int nb = rem / KSD, ks = rem - nb * KSD;
  if (tile >= ntile) return;
  auto wait_silu = [&]() {
    if (tid == 0)
      while (__hip_atomic_load(&sready[tile], __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT) == 0)
        __builtin_amdgcn_s_sleep(2);
    __syncthreads();
    __threadfence();
  };
  moe_grouped_w4a8_x_impl<DEC_DWN, 64, KSD, 1, true, false, true, true, PFD>(
      Q, xdn, tile_expert, tile_row0, tile_rows, row_tok, meta, QS, Pdn, cdn, Y, 2560, 320, Pmax,
      smem, nb, tile, ks, NBD, wait_silu);
  __syncthreads();
  if (tid == 0) {
    __threadfence();
    s_f0 = atomicAdd(&ddone[tile], 1) == NBD * KSD - 1;
    s_f1 = atomicAdd(&nbc[nb], 1) == ntile * KSD - 1;
    if (s_f0) {                                        // every down workgroup of the tile passed
      sready[tile] = 0;
      ddone[tile] = 0;
    }
  }
  __syncthreads();
  if (!s_f1) return;
  __threadfence();                                     // acquire: every tile's Y columns of nb
  if (tid == 0) {
    nbc[nb] = 0;
    while (__hip_atomic_load(sgf, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT) == 0)
      __builtin_amdgcn_s_sleep(2);
  }
  __syncthreads();
  __threadfence();
  mx_combine_slice(nb, T, Y, topk_w, route_pos, sg, meta, out);
  if (tid == 0 && atomicAdd(cdone, 1) == NBD - 1) {    // the last slice: the gate flag is free
    *cdone = 0;
    __hip_atomic_store(sgf, 0, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
  }
}

// ---------------------------------------------------------------- FN137: the exchange (FMODE 0 the form,
// 1 the CONTROL: no spin, 2 the RACE CHECKER `_chk`: the form + the flag-range and late-word checks)
struct FarArgs {
  int4 *peer;               // the PEER's window (its slot 0; slot 1 at + stride16)
  const int4 *my;           // this rank's window (the peer writes it)
  unsigned *pflags;         // the peer's 20 slice flags
  unsigned *mflags;         // this rank's 20 slice flags (the peer writes them)
  unsigned *ctr;            // [0] the channel's call counter, [1] this call's index
  int4 *red;                // the SUM (T x 2,560 bf16): the all-reduce's output
  unsigned *diag;           // [0] spin timeouts; _chk: [1] peer flag outside {s, s+1}, [2] a
                            // payload word that changed between two reads after the flag
  unsigned long long *stamp;  // timing only: [call % 64][21][8] s_memrealtime
  int stride16;             // a slot, in 16-byte words
  int pad;
};
__device__ __forceinline__ void far_rel(unsigned *p, unsigned v) {
  __hip_atomic_store(p, v, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_SYSTEM);
}
__device__ __forceinline__ unsigned far_acq(const unsigned *p) {
  return __hip_atomic_load(p, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM);
}
// saber_ar_exact.hip's `vadd<__hip_bfloat16, 8>`, verbatim arithmetic: fp32 sum, one bf16 rounding.
__device__ __forceinline__ int4 far_vadd(const int4 &a, const int4 &b) {
  int4 r;
  const __hip_bfloat16 *pa = reinterpret_cast<const __hip_bfloat16 *>(&a);
  const __hip_bfloat16 *pb = reinterpret_cast<const __hip_bfloat16 *>(&b);
  __hip_bfloat16 *pr = reinterpret_cast<__hip_bfloat16 *>(&r);
#pragma unroll
  for (int j = 0; j < 8; ++j) pr[j] = (__hip_bfloat16)((float)pa[j] + (float)pb[j]);
  return r;
}
__device__ __forceinline__ unsigned long long far_now() { return wall_clock64(); }
// The oracle's skew source: one workgroup spins `ticks` of the 100 MHz realtime clock.
extern "C" __global__ void fn137_delay(unsigned long long ticks) {
  const unsigned long long t0 = wall_clock64();
  while (wall_clock64() - t0 < ticks) __builtin_amdgcn_s_sleep(1);
}
__device__ __forceinline__ void far_st(const FarArgs &fa, unsigned s, int row, int j) {
  if (fa.stamp && threadIdx.x == 0) fa.stamp[((size_t)(s & 63u) * 21 + row) * 8 + j] = far_now();
}
// The ticket-0 workgroup: advance the channel's call counter, publish the index (before `sgf`).
__device__ __forceinline__ unsigned far_call_begin(const FarArgs &fa) {
  __shared__ unsigned s_far;
  if (threadIdx.x == 0) {
    const unsigned s = fa.ctr[0] + 1u;
    fa.ctr[0] = s;
    fa.ctr[1] = s;
    s_far = s;
  }
  __syncthreads();
  const unsigned s = s_far;
  far_st(fa, s, 20, 0);
  return s;
}
__device__ __forceinline__ unsigned far_call_read(const FarArgs &fa) {
  return __builtin_amdgcn_readfirstlane(__hip_atomic_load(&fa.ctr[1], __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT));
}
// The slice's exchange: the words `mx_combine_slice` wrote for slice nb (its own thread mapping),
// pushed, flagged, the peer's awaited, summed.
template <int FMODE>
__device__ __forceinline__ void far_exchange(const int nb, const int T, const __bf16 *__restrict__ out,
                                             const FarArgs &fa, const unsigned s) {
  constexpr int W16 = 2560 / 8;   // 16-byte words a row
  const int slot = (int)(s & 1u);
  int4 *ps = fa.peer + (size_t)slot * fa.stride16;
  const int4 *ms = fa.my + (size_t)slot * fa.stride16;
  far_st(fa, s, nb, 0);
  int4 o[4];   // T <= 64: T * 16 <= 4 x 256 items a thread, static indices (no scratch)
#pragma unroll
  for (int j = 0; j < 4; ++j) {
    const int i = threadIdx.x + j * blockDim.x;
    if (i < T * 16) {
      const int k = (i >> 4) * W16 + nb * 16 + (i & 15);
      o[j] = ((const int4 *)out)[k];
      ps[k] = o[j];
    }
  }
  far_st(fa, s, nb, 1);
  asm volatile("s_wait_storecnt 0x0" ::: "memory");   // the served drain (3)
  __syncthreads();
  far_st(fa, s, nb, 2);
  if (threadIdx.x == 0) {
    far_rel(&fa.pflags[nb], s);
    if (fa.stamp) fa.stamp[((size_t)(s & 63u) * 21 + nb) * 8 + 3] = far_now();
    if (FMODE != 1) {
      const unsigned long long t0 = far_now();
      while (far_acq(&fa.mflags[nb]) < s) {
        // 40 s of the 100 MHz realtime clock: a peer KFD-queue eviction (FN121: > 50 ms served steps)
        // is a WAIT, never a timeout (FN137b h2: a 50 ms bound timed out 19 times on a served boot);
        // the shipped one-shot bounds its spin at SABER_AR_SPIN_MAX polls, the same order
        if (far_now() - t0 > 4000000000ull) { atomicAdd(&fa.diag[0], 1u); break; }
      }
    }
    if (FMODE == 2) {   // _chk: the peer is at this call or the next one, never further
      const unsigned v = far_acq(&fa.mflags[nb]);
      if (v != s && v != s + 1u) atomicAdd(&fa.diag[1], 1u);
    }
  }
  __syncthreads();                                     // the served acq = 0: no fence after
  far_st(fa, s, nb, 4);
#pragma unroll
  for (int j = 0; j < 4; ++j) {
    const int i = threadIdx.x + j * blockDim.x;
    if (i < T * 16) {
      const int k = (i >> 4) * W16 + nb * 16 + (i & 15);
      const int4 pv = ms[k];
      fa.red[k] = far_vadd(o[j], pv);
      if (FMODE == 2) {   // _chk: the landed word must not change after the flag (a late write)
        __builtin_amdgcn_s_sleep(4);
        const unsigned *pw = reinterpret_cast<const unsigned *>(&ms[k]);
        const unsigned w0 = __hip_atomic_load(pw + 0, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM);
        const unsigned w1 = __hip_atomic_load(pw + 1, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM);
        const unsigned w2 = __hip_atomic_load(pw + 2, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM);
        const unsigned w3 = __hip_atomic_load(pw + 3, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_SYSTEM);
        if (w0 != (unsigned)pv.x || w1 != (unsigned)pv.y || w2 != (unsigned)pv.z || w3 != (unsigned)pv.w)
          atomicAdd(&fa.diag[2], 1u);
      }
    }
  }
  if (fa.stamp) {
    __syncthreads();
    far_st(fa, s, nb, 5);
  }
}

template <int KSG, int KSD, int PFD, int FMODE>
__device__ __forceinline__ void moe_back_h2_far_impl(
    const unsigned char *__restrict__ A, const float *__restrict__ As,
    const unsigned long long *__restrict__ xgu, const unsigned long long *__restrict__ xdn,
    const int *__restrict__ tile_expert, const int *__restrict__ tile_row0,
    const int *__restrict__ tile_rows, const int *__restrict__ row_tok,
    const int *__restrict__ meta, float *__restrict__ Pgu, float *__restrict__ Pdn,
    int *__restrict__ cgu, int *__restrict__ cdn, __bf16 *__restrict__ GU,
    unsigned char *__restrict__ Q, float *__restrict__ QS, __bf16 *__restrict__ Y,
    const float *__restrict__ topk_w, const int *__restrict__ route_pos,
    const __bf16 *__restrict__ wsg, const __bf16 *__restrict__ bi, __bf16 *__restrict__ sg,
    __bf16 *__restrict__ out, int *__restrict__ sync, const int T, const int Pmax,
    const int tc, const FarArgs fa) {
  constexpr int NBG = 640 / 128, NBD = 2560 / 128;
  __shared__ __attribute__((aligned(16))) unsigned char smem[mx_lds_bytes<DEC_DWN, 1>()];
  __shared__ int s_v, s_f0, s_f1, s_sl;
  const int tid = threadIdx.x;
  int *const tk = sync, *const sgf = sync + 1, *const cdone = sync + 2, *const nbc = sync + 3;
  int *const gdone = sync + 3 + NBD, *const sready = gdone + tc, *const ddone = sready + tc;
  if (tid == 0) {
    const int v = atomicAdd(tk, 1);
    if (v == (int)gridDim.x - 1) *tk = 0;   // every ticket is taken: the counter is free again
    s_v = v;
  }
  __syncthreads();
  const int v = __builtin_amdgcn_readfirstlane(s_v);
  const int ntile = meta[0];
  if (v == 0) {
    // The shared-expert gate logit: FN5's band at ONE split (the engine's `fn_bgemm_sk_m16`, M 1 =
    // the gate row, N = T = the block input's rows); waves 4..7 own columns >= 64 > T: idle.
    moe_x_bgemm_sk_body<16>(wsg, bi, nullptr, nullptr, sg, 1, T, 2560, 0, 0, 0, 1, 1, &s_sl,
                            mx_nobar{});
    __syncthreads();
    __threadfence();
    const unsigned fs = far_call_begin(fa);   // FN137: the call index, before `sgf`
    if (ntile == 0) {   // no expert rows on this rank: the combine is its (all-remote) zero sum
      for (int nb = 0; nb < NBD; ++nb) {
        mx_combine_slice(nb, T, Y, topk_w, route_pos, sg, meta, out);
        far_exchange<FMODE>(nb, T, out, fa, fs);   // FN137
      }
      return;
    }
    if (tid == 0) __hip_atomic_store(sgf, 1, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
    return;
  }
  int u = v - 1;
  const int NGU = tc * NBG * KSG;
  if (u < NGU) {
    const int tile = u / (NBG * KSG), rem = u - tile * (NBG * KSG);
    const int nb = rem / KSG, ks = rem - nb * KSG;
    if (tile >= ntile) return;
    moe_grouped_w4a8_x_impl<DEC_DWN, 128, KSG, 1, true, true, true, true, PFD>(
        A, xgu, tile_expert, tile_row0, tile_rows, row_tok, meta, As, Pgu, cgu, GU, 640, 2560,
        Pmax, smem, nb, tile, ks, NBG, mx_nowait{});
    __syncthreads();
    if (tid == 0) {
      __threadfence();
      s_f0 = atomicAdd(&gdone[tile], 1) == NBG * KSG - 1;
    }
    __syncthreads();
    if (!s_f0) return;
    __threadfence();                                   // acquire: every n-block's gu rows
    if (tid == 0) gdone[tile] = 0;
    const int row0 = tile_row0[tile], M = tile_rows[tile];
    for (int m = tid >> 5; m < M; m += DEC_DWN) mx_silu_row_wave(row0 + m, GU, Q, QS, 320);
    __syncthreads();
    if (tid == 0) {
      __threadfence();
      __hip_atomic_store(&sready[tile], 1, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
    }
    return;
  }
  u -= NGU;
  const int tile = u / (NBD * KSD), rem = u - tile * (NBD * KSD);
  const int nb = rem / KSD, ks = rem - nb * KSD;
  if (tile >= ntile) return;
  auto wait_silu = [&]() {
    if (tid == 0)
      while (__hip_atomic_load(&sready[tile], __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT) == 0)
        __builtin_amdgcn_s_sleep(2);
    __syncthreads();
    __threadfence();
  };
  moe_grouped_w4a8_x_impl<DEC_DWN, 64, KSD, 1, true, false, true, true, PFD>(
      Q, xdn, tile_expert, tile_row0, tile_rows, row_tok, meta, QS, Pdn, cdn, Y, 2560, 320, Pmax,
      smem, nb, tile, ks, NBD, wait_silu);
  __syncthreads();
  if (tid == 0) {
    __threadfence();
    s_f0 = atomicAdd(&ddone[tile], 1) == NBD * KSD - 1;
    s_f1 = atomicAdd(&nbc[nb], 1) == ntile * KSD - 1;
    if (s_f0) {                                        // every down workgroup of the tile passed
      sready[tile] = 0;
      ddone[tile] = 0;
    }
  }
  __syncthreads();
  if (!s_f1) return;
  __threadfence();                                     // acquire: every tile's Y columns of nb
  if (tid == 0) {
    nbc[nb] = 0;
    while (__hip_atomic_load(sgf, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT) == 0)
      __builtin_amdgcn_s_sleep(2);
  }
  __syncthreads();
  __threadfence();
  mx_combine_slice(nb, T, Y, topk_w, route_pos, sg, meta, out);
  far_exchange<FMODE>(nb, T, out, fa, far_call_read(fa));   // FN137
  if (tid == 0 && atomicAdd(cdone, 1) == NBD - 1) {    // the last slice: the gate flag is free
    *cdone = 0;
    __hip_atomic_store(sgf, 0, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
  }
}

