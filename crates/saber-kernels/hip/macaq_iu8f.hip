typedef int iu8_int2 __attribute__((ext_vector_type(2)));
typedef int iu8_intx8 __attribute__((ext_vector_type(8)));
typedef unsigned int iu8_uint4 __attribute__((ext_vector_type(4)));

static __device__ __forceinline__ iu8_intx8 iu8_wmma(iu8_int2 a, iu8_int2 b, iu8_intx8 c) {
  return __builtin_amdgcn_wmma_i32_16x16x16_iu8_w32_gfx12(true, a, true, b, c, false);
}
// an LDS-only workgroup barrier (a __syncthreads() would also drain the register prefetch)
static __device__ __forceinline__ void iu8_bar() {
  __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
  __builtin_amdgcn_s_barrier();
  __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
}
static __device__ __forceinline__ float iu8_epi(int acc, float a_scale, float w_scale_u) {
#pragma clang fp contract(off)
  const float t = (float)acc * a_scale;
  return t * w_scale_u;
}
template <bool W8>
static __device__ __forceinline__ float iu8_wsu(const float *__restrict__ ws, int n) {
#pragma clang fp contract(off)
  return W8 ? ws[n] : ws[n] * 0.0625f;
}

// ============================================================================ decode band (M <= 64)
// 8 waves a block, one 16-column n-tile a wave (a block = 128 columns), A staged in LDS once a slab,
// W nontemporal straight into the B operand, K slab 128, split-K over blockIdx.z (gridDim.z = ks) with
// the last-arriving split reducing the int32 partials (exact) and running the epilogue. DTM = ceil(M/16).
template <int DTM, bool W8>
__device__ __forceinline__ bool iu8f_dec_impl(const int bx, const int bz, const int nz,
                                              const unsigned char *__restrict__ AT, const unsigned char *__restrict__ W,
                                             const float *__restrict__ as, const float *__restrict__ ws,
                                             int *__restrict__ P, int *__restrict__ cnt, __bf16 *__restrict__ C,
                                             int M, int N, int K) {
  constexpr int NS = 8;
  constexpr int WFB = W8 ? 256 : 128;  // bytes a W fragment
  __shared__ int s_last;
  __shared__ unsigned char sA[DTM * NS * 256];
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int col = lane & 15, kb8 = (lane >> 4) * 8;
  const int ntiles = N >> 4;
  const int nt = bx * 8 + wave;
  const bool live = nt < ntiles;
  const int ntl = live ? nt : ntiles - 1;  // a dead wave streams a live tile's bytes and stores nothing
  const int ks = bz, DKS = nz;
  const int ksg = K >> 4;
  const int slabs = K >> 7, spb = (slabs + DKS - 1) / DKS;
  const int s_lo = ks * spb, s_hi = min(slabs, s_lo + spb);
  const unsigned char *wbase = W + (size_t)ntl * ksg * WFB;
  const int n = ntl * 16 + col;
  iu8_intx8 acc[DTM];
#pragma unroll
  for (int i = 0; i < DTM; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) acc[i][e] = 0;
#pragma unroll 2
  for (int s = s_lo; s < s_hi; ++s) {
    const int kk0 = s * NS;
    iu8_int2 wv[NS];
#pragma unroll
    for (int st = 0; st < NS; ++st) {
      if constexpr (W8) {
        const unsigned *p = (const unsigned *)(wbase + ((unsigned)lane * 8 + (unsigned)((kk0 + st) * 256)));
        wv[st][0] = (int)__builtin_nontemporal_load(p);
        wv[st][1] = (int)__builtin_nontemporal_load(p + 1);
      } else {
        const unsigned d = __builtin_nontemporal_load((const unsigned *)(wbase + ((unsigned)lane * 4 + (unsigned)((kk0 + st) * 128))));
        wv[st][0] = (int)((d << 4) & 0xF0F0F0F0u);
        wv[st][1] = (int)(d & 0xF0F0F0F0u);
      }
    }
    for (int o = tid * 16; o < DTM * NS * 256; o += 256 * 16) {
      const int i = o / (NS * 256), r = o % (NS * 256);
      *(iu8_uint4 *)&sA[o] = *(const iu8_uint4 *)(AT + (size_t)(i * ksg + kk0) * 256 + r);
    }
    iu8_bar();
    iu8_int2 af[DTM][NS];
#pragma unroll
    for (int i = 0; i < DTM; ++i)
#pragma unroll
      for (int st = 0; st < NS; ++st) af[i][st] = *(const iu8_int2 *)&sA[(i * NS + st) * 256 + lane * 8];
#pragma unroll
    for (int st = 0; st < NS; ++st)
#pragma unroll
      for (int i = 0; i < DTM; ++i) acc[i] = iu8_wmma(af[i][st], wv[st], acc[i]);
    iu8_bar();
  }
  if (DKS == 1) {
    if (!live) return true;
    const float wsu = iu8_wsu<W8>(ws, n);
#pragma unroll
    for (int i = 0; i < DTM; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int m = i * 16 + kb8 + e;
        if (m < M) C[(size_t)m * N + n] = (__bf16)iu8_epi(acc[i][e], as[m], wsu);
      }
    return true;
  }
  if (live) {
#pragma unroll
    for (int i = 0; i < DTM; ++i)
#pragma unroll
      for (int e = 0; e < 8; ++e) {
        const int m = i * 16 + kb8 + e;
        if (m < M) P[((size_t)ks * M + m) * N + n] = acc[i][e];
      }
  }
  __syncthreads();
  if (tid == 0) {
    __threadfence();
    s_last = (atomicAdd(&cnt[bx], 1) == DKS - 1);
  }
  __syncthreads();
  if (!s_last) return false;
  __threadfence();
  if (tid == 0) cnt[bx] = 0;  // self-resetting: zeroed once at construction, never again
  const int nb = bx * 128, nw = min(128, N - nb);
  for (int idx = tid; idx < nw * M; idx += 256) {
    const int m = idx / nw, nn = nb + idx % nw;
    int sum = 0;
    for (int k = 0; k < DKS; ++k) sum += __builtin_nontemporal_load(&P[((size_t)k * M + m) * N + nn]);
    C[(size_t)m * N + nn] = (__bf16)iu8_epi(sum, as[m], iu8_wsu<W8>(ws, nn));
  }
  return true;
}


// ============================================================================ (a) the decode pair
// Problem 0's grid (nb x ks blocks, n-block fastest, as `macaq_iu8_dec_*` dispatches it) then problem 1's;
// both halves W4, the same M and K, the shared A tile and per-token scale.
template <int DTM>
__device__ __forceinline__ void iu8f_pair_impl(const unsigned char *__restrict__ a, const float *__restrict__ as,
                                               const unsigned char *__restrict__ w, const float *__restrict__ ws,
                                               int *__restrict__ P, int *__restrict__ cnt, __bf16 *__restrict__ c,
                                               const unsigned char *__restrict__ w_b, const float *__restrict__ ws_b,
                                               int *__restrict__ P_b, int *__restrict__ cnt_b,
                                               __bf16 *__restrict__ c_b, int M, int K, int N0, int ks0, int nb0,
                                               int N1, int ks1, int nb1) {
  const int b0 = nb0 * ks0;
  const bool p1 = (int)blockIdx.x >= b0;
  const int bl = p1 ? (int)blockIdx.x - b0 : (int)blockIdx.x;
  const int nb = p1 ? nb1 : nb0;
  (void)iu8f_dec_impl<DTM, false>(bl % nb, bl / nb, p1 ? ks1 : ks0, a, p1 ? w_b : w, as, p1 ? ws_b : ws,
                                  p1 ? P_b : P, p1 ? cnt_b : cnt, p1 ? c_b : c, M, p1 ? N1 : N0, K);
}

#define IU8F_PAIR(name, DTM)                                                                                   \
  extern "C" __global__ __launch_bounds__(256) void name(                                                     \
      const unsigned char *__restrict__ a, const float *__restrict__ as, const unsigned char *__restrict__ w, \
      const float *__restrict__ ws, int *__restrict__ decode_partial, int *__restrict__ decode_counter,        \
      __bf16 *__restrict__ c, const unsigned char *__restrict__ w_b, const float *__restrict__ ws_b,           \
      int *__restrict__ decode_partial_b, int *__restrict__ decode_counter_b, __bf16 *__restrict__ c_b,        \
      int m, int k, int n, int ks, int nb, int n_b, int ks_b, int nb_b) {                                     \
    iu8f_pair_impl<DTM>(a, as, w, ws, decode_partial, decode_counter, c, w_b, ws_b, decode_partial_b,          \
                        decode_counter_b, c_b, m, k, n, ks, nb, n_b, ks_b, nb_b);                              \
  }
IU8F_PAIR(macaq_iu8f_pair_w4_tm1, 1)
IU8F_PAIR(macaq_iu8f_pair_w4_tm2, 2)
IU8F_PAIR(macaq_iu8f_pair_w4_tm3, 3)
IU8F_PAIR(macaq_iu8f_pair_w4_tm4, 4)
#undef IU8F_PAIR

// ============================================================================ (b) row 3
#define SABER_AR_SPIN_MAX 4000000000ULL
#define SABER_ARNQ_T 256
#define SABER_ARNQ_MAXG 5

__device__ __forceinline__ void arnq_store_sys_rel(unsigned int* p, unsigned int v) {
  __hip_atomic_store(p, v, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_SYSTEM);
}
__device__ __forceinline__ unsigned int arnq_load_sys_acq(const unsigned int* p) {
  return __hip_atomic_load(p, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_SYSTEM);
}
__device__ __forceinline__ float arnq_rd_to_f(const float& x) { return x; }
__device__ __forceinline__ float arnq_rd_to_f(const __half& x) { return __half2float(x); }
__device__ __forceinline__ float arnq_rd_to_f(const __hip_bfloat16& x) { return (float)x; }
__device__ __forceinline__ void arnq_rd_from_f(float v, float& o) { o = v; }
__device__ __forceinline__ void arnq_rd_from_f(float v, __half& o) { o = __float2half(v); }
__device__ __forceinline__ void arnq_rd_from_f(float v, __hip_bfloat16& o) { o = (__hip_bfloat16)v; }

// vectorized 128-bit add: an int4 packs LANES elements of T; fp32-accumulate reduce.
template <typename T, int LANES>
__device__ __forceinline__ int4 arnq_vadd(const int4& a, const int4& b) {
#pragma clang fp contract(off)
  int4 r;
  const T* pa = reinterpret_cast<const T*>(&a);
  const T* pb = reinterpret_cast<const T*>(&b);
  T* pr = reinterpret_cast<T*>(&r);
#pragma unroll
  for (int j = 0; j < LANES; ++j) arnq_rd_from_f(arnq_rd_to_f(pa[j]) + arnq_rd_to_f(pb[j]), pr[j]);
  return r;
}

__device__ __forceinline__ void iu8f_arnq_epilogue(
    const int b, const int4* __restrict__ in4, const int4* my_base,
    const __hip_bfloat16* __restrict__ res, const __hip_bfloat16* __restrict__ w,
    unsigned char* __restrict__ q, float* __restrict__ scale,
    __hip_bfloat16* __restrict__ res_out,
    unsigned int* peer_flags, unsigned int* my_flags, unsigned int* seq_ctrs,
    int k16, int slot_stride16, float eps, int drain, int acq, const float* __restrict__ had_t) {
#pragma clang fp contract(off)
  const int tid = threadIdx.x;
  __shared__ unsigned int s_seq;
  if (tid == 0) s_seq = atomicAdd(&seq_ctrs[b], 1u) + 1u;
  __syncthreads();
  const unsigned int sq = s_seq;
  const int slot = (int)(sq & 1u);
  const int4* ms = my_base + (size_t)slot * slot_stride16;
  const int start = b * k16, end = start + k16;
  const int K = k16 * 8;
  // (the push loop: done by the GEMM tiles, one [M x 128] piece each)
  if (drain == 1) __threadfence_system();
  else if (drain == 3) asm volatile("s_wait_storecnt 0x0" ::: "memory");
  __syncthreads();
  if (tid == 0) {
    if (drain == 2) __threadfence_system();
    arnq_store_sys_rel(&peer_flags[b], sq);
    unsigned long long z = 0;
    while (arnq_load_sys_acq(&my_flags[b]) < sq) { if (++z > SABER_AR_SPIN_MAX) break; }
  }
  __syncthreads();
  if (acq) __threadfence_system();
  // reduce this row into registers (bf16-rounded like the plain kernel) + start the epilogue
  res += (size_t)b * K; res_out += (size_t)b * K;  // q is the A-tiled edge base
  float sv[SABER_ARNQ_MAXG][8];
  float ssq = 0.f;
#pragma unroll
  for (int ng = 0; ng < SABER_ARNQ_MAXG; ++ng) {
    const int k = start + tid + ng * SABER_ARNQ_T;
    if (k >= end) break;
    int4 red = arnq_vadd<__hip_bfloat16, 8>(in4[k], ms[k]);
    const __hip_bfloat16* rh = reinterpret_cast<const __hip_bfloat16*>(&red);
    const int e0 = (k - start) * 8;
    int4 rv = ((const int4*)res)[k - start];
    const __hip_bfloat16* vh = reinterpret_cast<const __hip_bfloat16*>(&rv);
    int4 ro;
    __hip_bfloat16* oh = reinterpret_cast<__hip_bfloat16*>(&ro);
#pragma unroll
    for (int j = 0; j < 8; ++j) {
      float v = (float)rh[j] + (float)vh[j];
      sv[ng][j] = v;
      oh[j] = (__hip_bfloat16)v;
      ssq = __builtin_fmaf(v, v, ssq);
    }
    ((int4*)res_out)[k - start] = ro;
    (void)e0;
  }
  __shared__ float lds[SABER_ARNQ_T / 32];
  for (int o = 16; o; o >>= 1) ssq += __shfl_down(ssq, o);
  if ((tid & 31) == 0) lds[tid >> 5] = ssq;
  __syncthreads();
  if (tid < SABER_ARNQ_T / 32) {
    float v = lds[tid];
    for (int o = SABER_ARNQ_T / 64; o; o >>= 1) v += __shfl_down(v, o);
    if (tid == 0) lds[0] = v;
  }
  __syncthreads();
  const float inv = rsqrtf(lds[0] / (float)K + eps);
  __syncthreads();
  float amax = 0.f;
#pragma unroll
  for (int mg = 0; mg < SABER_ARNQ_MAXG; ++mg) {
    const int k = start + tid + mg * SABER_ARNQ_T;
    if (k >= end) break;
    int4 wv = ((const int4*)w)[k - start + 0] ; // w indexed by column within the row
    const __hip_bfloat16* wh = reinterpret_cast<const __hip_bfloat16*>(&wv);
#pragma unroll
    for (int j = 0; j < 8; ++j) {
      float nv = (float)(__hip_bfloat16)(sv[mg][j] * inv * ((float)wh[j] + 1.f));
      sv[mg][j] = nv;
    }
    macaq_had32(sv[mg], had_t + 8 * (k - start), tid);
#pragma unroll
    for (int j = 0; j < 8; ++j) amax = fmaxf(amax, fabsf(sv[mg][j]));
  }
  for (int o = 16; o; o >>= 1) amax = fmaxf(amax, __shfl_down(amax, o));
  if ((tid & 31) == 0) lds[tid >> 5] = amax;
  __syncthreads();
  if (tid < SABER_ARNQ_T / 32) {
    float v = lds[tid];
    for (int o = SABER_ARNQ_T / 64; o; o >>= 1) v = fmaxf(v, __shfl_down(v, o));
    if (tid == 0) lds[0] = v;
  }
  __syncthreads();
  // saber_ar_hadi8.hip's per-token INT8 tail (codes in the A-TILED fragment order, row b)
  const float sc = fmaxf(__fdiv_rn(lds[0], 127.0f), 1e-30f);
  if (tid == 0) scale[b] = sc;
  const int mt = b >> 4, lrow = b & 15, kst = k16 >> 1;
#pragma unroll
  for (int mg = 0; mg < SABER_ARNQ_MAXG; ++mg) {
    const int k = start + tid + mg * SABER_ARNQ_T;
    if (k >= end) break;
    unsigned int lo = 0, hi = 0;
#pragma unroll
    for (int j = 0; j < 4; ++j) lo |= macaq_i8_code(sv[mg][j], sc) << (j * 8);
#pragma unroll
    for (int j = 4; j < 8; ++j) hi |= macaq_i8_code(sv[mg][j], sc) << ((j - 4) * 8);
    const long g = k - start;
    ((uint2*)q)[((long)mt * kst + (g >> 1)) * 32 + lrow + 16 * (g & 1)] = make_uint2(lo, hi);
  }
}


// The decode GEMM (tm1: M <= 16 rows, the exact band's M <= 12) whose split-K last arriver per 128-column
// n-block holds the exact C tile, then row 3's protocol (sliced) and the int8 `_nq` epilogue on the last M
// arrivals. N must be a whole number of 128-column n-blocks (every row-parallel N is 5,120).
template <bool W8>
__device__ __forceinline__ void iu8f_arnq_impl(
    const unsigned char *__restrict__ A, const unsigned char *__restrict__ W, const float *__restrict__ as,
    const float *__restrict__ ws, int *__restrict__ P, int *__restrict__ cnt, __bf16 *__restrict__ C, int M, int N,
    int K, int4 *peer_base, const int4 *my_base, const __hip_bfloat16 *__restrict__ res,
    const __hip_bfloat16 *__restrict__ nw, unsigned char *__restrict__ q, float *__restrict__ scale,
    __hip_bfloat16 *__restrict__ res_out, unsigned int *peer_flags, unsigned int *my_flags,
    unsigned int *seq_ctrs, unsigned long long *tiles, int k16, int slot_stride16, float eps, int drain, int acq,
    int ep_rows, const float *__restrict__ had_t) {
  if (!iu8f_dec_impl<1, W8>((int)blockIdx.x, (int)blockIdx.z, (int)gridDim.z, A, W, as, ws, P, cnt, C, M, N, K))
    return;  // not this n-block's last split arriver (uniform over the block)
  const int tid = threadIdx.x;
  const int n0 = blockIdx.x * 128;
  __shared__ int s_row;
  __shared__ unsigned long long s_target;
  __syncthreads();
  {
    const int c16 = tid & 15, m = tid >> 4;
    if (m < M) {
      const unsigned int s_ =
          __hip_atomic_load(&seq_ctrs[m], __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT) + 1u;
      const size_t w16 = (size_t)m * k16 + (n0 >> 3) + c16;
      peer_base[(size_t)(s_ & 1u) * slot_stride16 + w16] = reinterpret_cast<const int4 *>(C)[w16];
    }
  }
  if (drain == 1) __threadfence_system();
  else if (drain == 3) asm volatile("s_wait_storecnt 0x0" ::: "memory");
  __syncthreads();
  const int rows_ = ep_rows < M ? ep_rows : M;
  if (tid == 0) {
    if (drain == 2) __threadfence_system();
    __threadfence();
    const unsigned long long nt = gridDim.x;
    const unsigned long long t = atomicAdd(tiles, 1ull);
    const unsigned long long i = t % nt;
    s_row = (i + (unsigned long long)rows_ >= nt) ? (int)(i + (unsigned long long)rows_ - nt) : -1;
    s_target = (t / nt + 1ull) * nt;
  }
  __syncthreads();
  const int row = s_row;
  if (row < 0) return;
  if (tid == 0) {
    const unsigned long long tgt = s_target;
    unsigned long long z = 0;
    while (__hip_atomic_load(tiles, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT) < tgt) {
      if (++z > SABER_AR_SPIN_MAX) break;
    }
  }
  __syncthreads();
  // Every wave acquires, not only tid0's: in WGP mode a workgroup's waves may sit on either CU's
  // L0, and the C tiles the owner is about to read were written by other CUs.
  __threadfence();
  iu8f_arnq_epilogue(row, reinterpret_cast<const int4 *>(C), my_base, res, nw, q, scale, res_out, peer_flags,
                     my_flags, seq_ctrs, k16, slot_stride16, eps, drain, acq, had_t);
}

#define IU8F_ARNQ(name, W8)                                                                                     \
  extern "C" __global__ __launch_bounds__(256) void name(                                                       \
      const unsigned char *__restrict__ a, const unsigned char *__restrict__ w, const float *__restrict__ as,   \
      const float *__restrict__ ws, int *__restrict__ decode_partial, int *__restrict__ decode_counter,          \
      __bf16 *__restrict__ c, int m, int n, int k, int4 *ar_peer_scratch, const int4 *ar_scratch,               \
      const __hip_bfloat16 *__restrict__ residual, const __hip_bfloat16 *__restrict__ norm_w,                    \
      unsigned char *__restrict__ q_out, float *__restrict__ scale_out, __hip_bfloat16 *__restrict__ res_out,    \
      unsigned int *ar_peer_flags, unsigned int *ar_flags, unsigned int *ar_seq, unsigned long long *ar_tiles,   \
      int k16, int slot_stride16, float eps, int drain, int acq, int ep_rows, const float *__restrict__ had_t) { \
    iu8f_arnq_impl<W8>(a, w, as, ws, decode_partial, decode_counter, c, m, n, k, ar_peer_scratch, ar_scratch,   \
                       residual, norm_w, q_out, scale_out, res_out, ar_peer_flags, ar_flags, ar_seq, ar_tiles,  \
                       k16, slot_stride16, eps, drain, acq, ep_rows, had_t);                                    \
  }
IU8F_ARNQ(macaq_iu8f_arnq_hadi8_w4_tm1, false)
IU8F_ARNQ(macaq_iu8f_arnq_hadi8_w8_tm1, true)
#undef IU8F_ARNQ

// ============================================================================ (c) the ba-first pair
// Problem 1's grid (the ba half: nb1 x ks1 blocks) FIRST, then problem 0's; otherwise (a).
template <int DTM>
__device__ __forceinline__ void iu8f_pairb_impl(const unsigned char *__restrict__ a, const float *__restrict__ as,
                                                const unsigned char *__restrict__ w, const float *__restrict__ ws,
                                                int *__restrict__ P, int *__restrict__ cnt, __bf16 *__restrict__ c,
                                                const unsigned char *__restrict__ w_b, const float *__restrict__ ws_b,
                                                int *__restrict__ P_b, int *__restrict__ cnt_b,
                                                __bf16 *__restrict__ c_b, int M, int K, int N0, int ks0, int nb0,
                                                int N1, int ks1, int nb1) {
  const int b1 = nb1 * ks1;
  const bool p1 = (int)blockIdx.x < b1;
  const int bl = p1 ? (int)blockIdx.x : (int)blockIdx.x - b1;
  const int nb = p1 ? nb1 : nb0;
  (void)iu8f_dec_impl<DTM, false>(bl % nb, bl / nb, p1 ? ks1 : ks0, a, p1 ? w_b : w, as, p1 ? ws_b : ws,
                                  p1 ? P_b : P, p1 ? cnt_b : cnt, p1 ? c_b : c, M, p1 ? N1 : N0, K);
}

#define IU8F_PAIRB(name, DTM)                                                                                  \
  extern "C" __global__ __launch_bounds__(256) void name(                                                     \
      const unsigned char *__restrict__ a, const float *__restrict__ as, const unsigned char *__restrict__ w, \
      const float *__restrict__ ws, int *__restrict__ decode_partial, int *__restrict__ decode_counter,        \
      __bf16 *__restrict__ c, const unsigned char *__restrict__ w_b, const float *__restrict__ ws_b,           \
      int *__restrict__ decode_partial_b, int *__restrict__ decode_counter_b, __bf16 *__restrict__ c_b,        \
      int m, int k, int n, int ks, int nb, int n_b, int ks_b, int nb_b) {                                     \
    iu8f_pairb_impl<DTM>(a, as, w, ws, decode_partial, decode_counter, c, w_b, ws_b, decode_partial_b,         \
                         decode_counter_b, c_b, m, k, n, ks, nb, n_b, ks_b, nb_b);                             \
  }
IU8F_PAIRB(macaq_iu8f_pairb_w4_tm1, 1)
IU8F_PAIRB(macaq_iu8f_pairb_w4_tm2, 2)
IU8F_PAIRB(macaq_iu8f_pairb_w4_tm3, 3)
IU8F_PAIRB(macaq_iu8f_pairb_w4_tm4, 4)
#undef IU8F_PAIRB

// ============================================================================ (d) the mid decode band
// M 65..128 (DTM = ceil(M/16) 5..8) on the decode body; grid (nb, 1, ks) as `macaq_iu8_dec_*`.
#define IU8F_DEC(name, DTM, W8)                                                                                \
  extern "C" __global__ __launch_bounds__(256) void name(                                                     \
      const unsigned char *__restrict__ a, const unsigned char *__restrict__ w, const float *__restrict__ as, \
      const float *__restrict__ ws, int *__restrict__ decode_partial, int *__restrict__ decode_counter,       \
      __bf16 *__restrict__ c, int m, int n, int k) {                                                           \
    (void)iu8f_dec_impl<DTM, W8>((int)blockIdx.x, (int)blockIdx.z, (int)gridDim.z, a, w, as, ws, decode_partial, \
                                 decode_counter, c, m, n, k);                                                 \
  }
IU8F_DEC(macaq_iu8f_dec_w4_tm5, 5, false)
IU8F_DEC(macaq_iu8f_dec_w4_tm6, 6, false)
IU8F_DEC(macaq_iu8f_dec_w4_tm7, 7, false)
IU8F_DEC(macaq_iu8f_dec_w4_tm8, 8, false)
IU8F_DEC(macaq_iu8f_dec_w8_tm5, 5, true)
IU8F_DEC(macaq_iu8f_dec_w8_tm6, 6, true)
IU8F_DEC(macaq_iu8f_dec_w8_tm7, 7, true)
IU8F_DEC(macaq_iu8f_dec_w8_tm8, 8, true)
#undef IU8F_DEC

// ============================================================================ (e) the small prefill tiles
// `iu8_pf_impl` with PTM m-fragments a wave: BM = 4 * PTM * 16; grid (nb, ceil(M / BM), 1) as `macaq_iu8_pf_*`.
template <bool W8, int PTM>
__device__ __forceinline__ void iu8f_pf_impl(const unsigned char *__restrict__ AT, const unsigned char *__restrict__ W,
                                            const float *__restrict__ as, const float *__restrict__ ws,
                                            __bf16 *__restrict__ C, int M, int N, int K) {
  constexpr int TN = 4, LBK = 64, PWM = 4, PWN = 2, NS = LBK / 16, NT = PWM * PWN * 32;
  constexpr int BM = PWM * PTM * 16, BN = PWN * TN * 16;
  constexpr int WFB = W8 ? 256 : 128;
  constexpr int PSLAB = BN / 16 * NS * WFB;  // bytes of W a slab
  constexpr int PIECES = PSLAB / (NT * 16);
  static_assert(PSLAB % (NT * 16) == 0, "whole pieces");
  __shared__ unsigned char sW[BN / 16 * NS * 256];
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int wm = wave / PWN, wn = wave % PWN;
  const int col = lane & 15, kb8 = (lane >> 4) * 8;
  const int m0 = blockIdx.y * BM, n0 = blockIdx.x * BN;
  const int ksg = K >> 4;
  const int mtiles = (M + 15) >> 4, ntiles = N >> 4;
  const unsigned aoff = lane * 8;
  const unsigned char *abase[PTM];
#pragma unroll
  for (int i = 0; i < PTM; ++i) {
    const int mt = min(m0 / 16 + wm * PTM + i, mtiles - 1);  // past the last tile: re-read it, store nothing
    abase[i] = AT + (size_t)__builtin_amdgcn_readfirstlane(mt * ksg * 256);
  }
  int nj[TN];
#pragma unroll
  for (int j = 0; j < TN; ++j) nj[j] = n0 + wn * TN * 16 + j * 16 + col;
  iu8_intx8 acc[PTM][TN];
#pragma unroll
  for (int i = 0; i < PTM; ++i)
#pragma unroll
    for (int j = 0; j < TN; ++j)
#pragma unroll
      for (int e = 0; e < 8; ++e) acc[i][j][e] = 0;
  for (int k0 = 0; k0 < K; k0 += LBK) {
    const int kk0 = k0 >> 4;
    iu8_int2 af[PTM][NS];
#pragma unroll
    for (int i = 0; i < PTM; ++i)
#pragma unroll
      for (int st = 0; st < NS; ++st)
        af[i][st] = *(const iu8_int2 *)(abase[i] + (aoff + (unsigned)(kk0 * 256) + (unsigned)(st * 256)));
    iu8_uint4 v[PIECES];
    int vdst[PIECES];
#pragma unroll
    for (int p = 0; p < PIECES; ++p) {
      const int o = (p * NT + tid) * 16;
      const int ntl = o / (NS * WFB), rem = o % (NS * WFB);
      const int ntg = min(n0 / 16 + ntl, ntiles - 1);  // a tile past N re-reads the last one (stored nowhere)
      v[p] = *(const iu8_uint4 *)(W + (size_t)ntg * ksg * WFB + (unsigned)(kk0 * WFB + rem));
      vdst[p] = ntl * NS * 256 + (rem / WFB) * 256 + (rem % WFB) * (W8 ? 1 : 2);
    }
#pragma unroll
    for (int p = 0; p < PIECES; ++p) {
      unsigned char *dst = &sW[vdst[p]];
      if constexpr (W8) {
        *(iu8_uint4 *)dst = v[p];
      } else {
        unsigned lo[4], hi[4];
#pragma unroll
        for (int q = 0; q < 4; ++q) {
          lo[q] = (v[p][q] << 4) & 0xF0F0F0F0u;
          hi[q] = v[p][q] & 0xF0F0F0F0u;
        }
        *(iu8_uint4 *)dst = iu8_uint4{lo[0], hi[0], lo[1], hi[1]};
        *(iu8_uint4 *)(dst + 16) = iu8_uint4{lo[2], hi[2], lo[3], hi[3]};
      }
    }
    iu8_bar();
#pragma unroll
    for (int st = 0; st < NS; ++st) {
      iu8_int2 wf[TN];
#pragma unroll
      for (int j = 0; j < TN; ++j) wf[j] = *(const iu8_int2 *)&sW[(wn * TN + j) * NS * 256 + st * 256 + lane * 8];
      __builtin_amdgcn_sched_barrier(0);
#pragma unroll
      for (int i = 0; i < PTM; ++i)
#pragma unroll
        for (int j = 0; j < TN; ++j) acc[i][j] = iu8_wmma(af[i][st], wf[j], acc[i][j]);
    }
    iu8_bar();
  }
  float wsu[TN];
#pragma unroll
  for (int j = 0; j < TN; ++j) wsu[j] = nj[j] < N ? iu8_wsu<W8>(ws, nj[j]) : 0.f;
#pragma unroll
  for (int i = 0; i < PTM; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) {
      const int m = m0 + wm * PTM * 16 + i * 16 + kb8 + e;
      if (m >= M) continue;
      const float am = as[m];
#pragma unroll
      for (int j = 0; j < TN; ++j)
        if (nj[j] < N) C[(size_t)m * N + nj[j]] = (__bf16)iu8_epi(acc[i][j][e], am, wsu[j]);
    }
}


#define IU8F_PF(name, W8, PTM)                                                                                 \
  extern "C" __global__ __launch_bounds__(256) void name(                                                     \
      const unsigned char *__restrict__ a, const unsigned char *__restrict__ w, const float *__restrict__ as, \
      const float *__restrict__ ws, __bf16 *__restrict__ c, int m, int n, int k) {                             \
    iu8f_pf_impl<W8, PTM>(a, w, as, ws, c, m, n, k);                                                           \
  }
IU8F_PF(macaq_iu8f_pf_w4_bm128, false, 2)
IU8F_PF(macaq_iu8f_pf_w4_bm64, false, 1)
IU8F_PF(macaq_iu8f_pf_w8_bm128, true, 2)
IU8F_PF(macaq_iu8f_pf_w8_bm64, true, 1)
#undef IU8F_PF
template <bool W8, int PTM, int PWM, int TN, int LBK, bool PIPE>
__device__ __forceinline__ void iu8f_pfx_impl(const unsigned char *__restrict__ AT, const unsigned char *__restrict__ W,
                                            const float *__restrict__ as, const float *__restrict__ ws,
                                            __bf16 *__restrict__ C, int M, int N, int K) {
  constexpr int PWN = 2, NS = LBK / 16, NT = PWM * PWN * 32;
  constexpr int BM = PWM * PTM * 16, BN = PWN * TN * 16;
  constexpr int WFB = W8 ? 256 : 128;
  constexpr int PSLAB = BN / 16 * NS * WFB;  // bytes of W a slab
  constexpr int PIECES = PSLAB / (NT * 16);
  static_assert(PSLAB % (NT * 16) == 0, "whole pieces");
  constexpr int WBUF = BN / 16 * NS * 256;
  __shared__ unsigned char sW[(PIPE ? 2 : 1) * WBUF];
  const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
  const int wm = wave / PWN, wn = wave % PWN;
  const int col = lane & 15, kb8 = (lane >> 4) * 8;
  const int m0 = blockIdx.y * BM, n0 = blockIdx.x * BN;
  const int ksg = K >> 4;
  const int mtiles = (M + 15) >> 4, ntiles = N >> 4;
  const unsigned aoff = lane * 8;
  const unsigned char *abase[PTM];
#pragma unroll
  for (int i = 0; i < PTM; ++i) {
    const int mt = min(m0 / 16 + wm * PTM + i, mtiles - 1);  // past the last tile: re-read it, store nothing
    abase[i] = AT + (size_t)__builtin_amdgcn_readfirstlane(mt * ksg * 256);
  }
  int nj[TN];
#pragma unroll
  for (int j = 0; j < TN; ++j) nj[j] = n0 + wn * TN * 16 + j * 16 + col;
  iu8_intx8 acc[PTM][TN];
#pragma unroll
  for (int i = 0; i < PTM; ++i)
#pragma unroll
    for (int j = 0; j < TN; ++j)
#pragma unroll
      for (int e = 0; e < 8; ++e) acc[i][j][e] = 0;
  if constexpr (PIPE) {
    iu8_uint4 v[PIECES];
    int vdst[PIECES];
    auto wload = [&](const int kk0) {
#pragma unroll
    for (int p = 0; p < PIECES; ++p) {
      const int o = (p * NT + tid) * 16;
      const int ntl = o / (NS * WFB), rem = o % (NS * WFB);
      const int ntg = min(n0 / 16 + ntl, ntiles - 1);  // a tile past N re-reads the last one (stored nowhere)
      v[p] = *(const iu8_uint4 *)(W + (size_t)ntg * ksg * WFB + (unsigned)(kk0 * WFB + rem));
      vdst[p] = ntl * NS * 256 + (rem / WFB) * 256 + (rem % WFB) * (W8 ? 1 : 2);
    }
    };
    wload(0);
    int buf = 0;
    for (int k0 = 0; k0 < K; k0 += LBK) {
      const int kk0 = k0 >> 4;
      unsigned char *sWb = sW + buf * WBUF;
#pragma unroll
    for (int p = 0; p < PIECES; ++p) {
      unsigned char *dst = &sWb[vdst[p]];
      if constexpr (W8) {
        *(iu8_uint4 *)dst = v[p];
      } else {
        unsigned lo[4], hi[4];
#pragma unroll
        for (int q = 0; q < 4; ++q) {
          lo[q] = (v[p][q] << 4) & 0xF0F0F0F0u;
          hi[q] = v[p][q] & 0xF0F0F0F0u;
        }
        *(iu8_uint4 *)dst = iu8_uint4{lo[0], hi[0], lo[1], hi[1]};
        *(iu8_uint4 *)(dst + 16) = iu8_uint4{lo[2], hi[2], lo[3], hi[3]};
      }
    }
    iu8_int2 af[PTM][NS];
#pragma unroll
    for (int i = 0; i < PTM; ++i)
#pragma unroll
      for (int st = 0; st < NS; ++st)
        af[i][st] = *(const iu8_int2 *)(abase[i] + (aoff + (unsigned)(kk0 * 256) + (unsigned)(st * 256)));
      if (k0 + LBK < K) wload(kk0 + (LBK >> 4));
      iu8_bar();
#pragma unroll
    for (int st = 0; st < NS; ++st) {
      iu8_int2 wf[TN];
#pragma unroll
      for (int j = 0; j < TN; ++j) wf[j] = *(const iu8_int2 *)&sWb[(wn * TN + j) * NS * 256 + st * 256 + lane * 8];
      __builtin_amdgcn_sched_barrier(0);
#pragma unroll
      for (int i = 0; i < PTM; ++i)
#pragma unroll
        for (int j = 0; j < TN; ++j) acc[i][j] = iu8_wmma(af[i][st], wf[j], acc[i][j]);
    }
      buf ^= 1;
    }
  } else {
  for (int k0 = 0; k0 < K; k0 += LBK) {
    const int kk0 = k0 >> 4;
    iu8_int2 af[PTM][NS];
#pragma unroll
    for (int i = 0; i < PTM; ++i)
#pragma unroll
      for (int st = 0; st < NS; ++st)
        af[i][st] = *(const iu8_int2 *)(abase[i] + (aoff + (unsigned)(kk0 * 256) + (unsigned)(st * 256)));
    iu8_uint4 v[PIECES];
    int vdst[PIECES];
#pragma unroll
    for (int p = 0; p < PIECES; ++p) {
      const int o = (p * NT + tid) * 16;
      const int ntl = o / (NS * WFB), rem = o % (NS * WFB);
      const int ntg = min(n0 / 16 + ntl, ntiles - 1);  // a tile past N re-reads the last one (stored nowhere)
      v[p] = *(const iu8_uint4 *)(W + (size_t)ntg * ksg * WFB + (unsigned)(kk0 * WFB + rem));
      vdst[p] = ntl * NS * 256 + (rem / WFB) * 256 + (rem % WFB) * (W8 ? 1 : 2);
    }
#pragma unroll
    for (int p = 0; p < PIECES; ++p) {
      unsigned char *dst = &sW[vdst[p]];
      if constexpr (W8) {
        *(iu8_uint4 *)dst = v[p];
      } else {
        unsigned lo[4], hi[4];
#pragma unroll
        for (int q = 0; q < 4; ++q) {
          lo[q] = (v[p][q] << 4) & 0xF0F0F0F0u;
          hi[q] = v[p][q] & 0xF0F0F0F0u;
        }
        *(iu8_uint4 *)dst = iu8_uint4{lo[0], hi[0], lo[1], hi[1]};
        *(iu8_uint4 *)(dst + 16) = iu8_uint4{lo[2], hi[2], lo[3], hi[3]};
      }
    }
    iu8_bar();
#pragma unroll
    for (int st = 0; st < NS; ++st) {
      iu8_int2 wf[TN];
#pragma unroll
      for (int j = 0; j < TN; ++j) wf[j] = *(const iu8_int2 *)&sW[(wn * TN + j) * NS * 256 + st * 256 + lane * 8];
      __builtin_amdgcn_sched_barrier(0);
#pragma unroll
      for (int i = 0; i < PTM; ++i)
#pragma unroll
        for (int j = 0; j < TN; ++j) acc[i][j] = iu8_wmma(af[i][st], wf[j], acc[i][j]);
    }
    iu8_bar();
  }
  }
  float wsu[TN];
#pragma unroll
  for (int j = 0; j < TN; ++j) wsu[j] = nj[j] < N ? iu8_wsu<W8>(ws, nj[j]) : 0.f;
#pragma unroll
  for (int i = 0; i < PTM; ++i)
#pragma unroll
    for (int e = 0; e < 8; ++e) {
      const int m = m0 + wm * PTM * 16 + i * 16 + kb8 + e;
      if (m >= M) continue;
      const float am = as[m];
#pragma unroll
      for (int j = 0; j < TN; ++j)
        if (nj[j] < N) C[(size_t)m * N + nj[j]] = (__bf16)iu8_epi(acc[i][j][e], am, wsu[j]);
    }
}


// ============================================================================ (f) the parametric prefill tiles
// `iu8_pf_impl` with the tile free: PTM m-fragments x PWM waves down M (BM = PWM * PTM * 16), TN n-fragments x 2
// waves across N (BN = 2 * TN * 16), K slab LBK; `p` = PIPE (the next slab's W in registers during this slab's
// WMMAs, the W stage double-buffered). Grid (ceil(N / BN), ceil(M / BM), 1), PWM * 64 threads.
#define IU8F_PFX(name, W8, PTM, PWM, TN, LBK, PIPE)                                                             \
  extern "C" __global__ __launch_bounds__(PWM * 64) void name(                                                  \
      const unsigned char *__restrict__ a, const unsigned char *__restrict__ w, const float *__restrict__ as, \
      const float *__restrict__ ws, __bf16 *__restrict__ c, int m, int n, int k) {                             \
    iu8f_pfx_impl<W8, PTM, PWM, TN, LBK, PIPE>(a, w, as, ws, c, m, n, k);                                       \
  }
IU8F_PFX(macaq_iu8f_pf_w4_t1w4n2k128p, false, 1, 4, 2, 128, true)
IU8F_PFX(macaq_iu8f_pf_w4_t3w4n4k64p, false, 3, 4, 4, 64, true)
IU8F_PFX(macaq_iu8f_pf_w4_t4w4n4k64p, false, 4, 4, 4, 64, true)
IU8F_PFX(macaq_iu8f_pf_w4_t5w4n4k64p, false, 5, 4, 4, 64, true)
IU8F_PFX(macaq_iu8f_pf_w4_t4w4n2k128p, false, 4, 4, 2, 128, true)
IU8F_PFX(macaq_iu8f_pf_w4_t5w2n2k64p, false, 5, 2, 2, 64, true)
IU8F_PFX(macaq_iu8f_pf_w8_t1w4n2k128, true, 1, 4, 2, 128, false)
IU8F_PFX(macaq_iu8f_pf_w4_t3w2n2k128p, false, 3, 2, 2, 128, true)
IU8F_PFX(macaq_iu8f_pf_w4_t3w2n4k64p, false, 3, 2, 4, 64, true)
IU8F_PFX(macaq_iu8f_pf_w4_t2w2n2k128p, false, 2, 2, 2, 128, true)
IU8F_PFX(macaq_iu8f_pf_w4_t2w4n4k128p, false, 2, 4, 4, 128, true)
IU8F_PFX(macaq_iu8f_pf_w8_t3w4n2k64p, true, 3, 4, 2, 64, true)
IU8F_PFX(macaq_iu8f_pf_w4_t3w8n4k128p, false, 3, 8, 4, 128, true)
#undef IU8F_PFX
