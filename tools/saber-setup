#!/usr/bin/env python3
"""Guided setup for Saber: check the machine, pick a model, toggle the common options, then install
the missing pieces and launch the server.

    tools/saber-setup                 # the terminal UI
    tools/saber-setup --print         # no UI: print the plan for the saved (or default) settings
    tools/saber-setup --model flashnext --print

Python 3 standard library only (curses). The UI never decides anything the launchers do not: every
option maps to an environment variable or a flag that tools/serve_27b.sh / tools/serve_flashnext.sh
already take (README "Flags and options"). Settings are saved to ~/.config/saber/setup.json and a
re-runnable ~/.config/saber/launch-<model>.sh.
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONF_DIR = os.environ.get("SABER_SETUP_DIR", os.path.expanduser("~/.config/saber"))
CONF = os.path.join(CONF_DIR, "setup.json")

GIB = 1024**3

# name, launcher, container name, packs the launcher needs (under SABER_PACKS), download size (GB), model id
MODELS = {
    "27b": dict(
        title="Qwen3.8-27B (dense, DFlash2 drafter)",
        launcher="tools/serve_27b.sh",
        container="saber-27b-serve",
        packs=["qwen38-27b-nvfp4-devfinal-fp8head", "qwen38-dflash2-drafter-fp8head"],
        extra_files=[".cache/template_corpus.tokenizer.json", ".cache/template_corpus.jinja"],
        download_gb=26,
        note="about 26 GB of packs",
    ),
    "flashnext": dict(
        title="Qwen3.8 Flash-Next (MoE)",
        launcher="tools/serve_flashnext.sh",
        container="saber-flashnext-serve",
        packs=["qwen38-flashnext-quark-trunk8"],
        extra_files=[],
        download_gb=240,
        note="about 70 GB of packs plus the 170 GB original checkpoint it reads in place",
    ),
}

# --------------------------------------------------------------------------------------------
# Options. kind: choice | toggle | text.  `default` is Saber's recommended setting; the UI starts
# there and `d` puts every row back.  `emit(value, cfg)` returns (env dict, flag list).
# --------------------------------------------------------------------------------------------


def _none(_v, _c):
    return {}, []


def opt(key, label, kind, default, help, emit=_none, choices=None, models=("27b", "flashnext")):
    return dict(key=key, label=label, kind=kind, default=default, help=help, emit=emit,
                choices=choices or [], models=models)


def _ctx_flag_27b(v, c):
    return {"MAX_CTX": str(v)}, []


def _ctx_flag_fn(v, c):
    return ({}, [] if str(v) == "262144" else ["--fn-max-ctx", str(v)])


OPTIONS = [
    opt("gpus", "GPU pair (HIP devices)", "choice", "0,1",
        "Which two GPUs serve. Saber runs tensor-parallel over exactly two cards (TP=2).",
        emit=lambda v, c: ({"HIP_DEVICES": str(v)}, []), choices=["0,1"]),
    # 27B
    opt("prefix", "Prefix caching", "toggle", True,
        "Cache finished prompts so a returning conversation only prefills its new tail.",
        emit=lambda v, c: ({}, ["--enable-prefix-caching", "on"] if v else []), models=("27b",)),
