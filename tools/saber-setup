CONF = os.path.join(CONF_DIR, "setup.json")  # the pre-console settings file (migrated)
CONSOLE_CONF = os.environ.get("SABER_CONSOLE_CONFIG", os.path.join(CONF_DIR, "config.toml"))
CATALOG = os.path.join(REPO, "tools", "models.json")
CONSOLE_CONFIG_VERSION = 5  # saber_console::config::CONFIG_VERSION (5: engine.tp / engine.device)

GIB = 1024**3


def load_models(path=CATALOG):
    """The models the launchers serve, from the shared catalog (tools/models.json): id -> entry with
    title, launcher, container, packs, extra_files, download_gb, note (+ the console's fields)."""
    with open(path) as f:
        cat = json.load(f)
    return {m["id"]: m for m in cat["models"] if m.get("launcher")}


MODELS = load_models()

