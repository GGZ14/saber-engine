def _none(_v, _c):
    return {}, []


def opt(key, label, kind, default, help, emit=_none, choices=None, models=("27b", "flashnext"), tps=("1", "2")):
    return dict(key=key, label=label, kind=kind, default=default, help=help, emit=emit,
                choices=choices or [], models=models, tps=tps)


