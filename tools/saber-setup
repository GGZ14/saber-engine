FN_NVME = "/mnt/nvme"  # Flash-Next: the pack's manifest names the checkpoint under /mnt/nvme/models


def packs_dir(cfg):
    return cfg["packs"] if cfg["model"] == "27b" else FN_NVME + "/saber-packs"

FN_TP1_REFUSAL = "Flash-Next serves TP=2 only: no single-card (TP=1) Flash-Next pack is hosted"


def tp_rows(model):
    """The Parallelism rows: [(tp or None, label, enabled, why)]."""
    one = (True, "") if model == "27b" else (False, FN_TP1_REFUSAL)
    return [
        ("2", "TP=2   two GPUs   (the default)", True, ""),
        ("1", "TP=1   one GPU" + ("" if model == "27b" else "   (27B only; Flash-Next is TP=2)"), *one),
        (None, "TP=3 / TP=4", False, "not supported: the engine is built for TP=1 and TP=2 and refuses any other value"),
    ]


def options_for(model, tp="2"):
    return [o for o in OPTIONS if model in o["models"] and tp in o["tps"]]


def choices_for(o, cfg):
    if cfg.get("tp") == "1" and o["key"] == "ctx27":
        return TP1_CTX_CHOICES
    if cfg.get("tp") == "1" and o["key"] == "seqs":
        return TP1_SEQS_CHOICES
    if cfg.get("tp") == "1" and o["key"] == "vision27":
        return TP1_VISION
    return o["choices"]


def default_of(o, cfg):
    if cfg.get("tp") == "1" and o["key"] == "ctx27":
        return TP1_CTX_DEFAULT
    if cfg.get("tp") == "1" and o["key"] == "seqs":
        return TP1_SEQS_DEFAULT
    return o["default"]


def set_tp(cfg, tp):
    """Switch TP: a context / sequence count / vision mode left at the old TP's default, or one the new TP
    does not offer, goes to the new TP's default."""
    keys = ("ctx27", "seqs", "vision27")
    old = {o["key"]: default_of(o, cfg) for o in OPTIONS if o["key"] in keys}
    cfg["tp"] = tp
    for o in OPTIONS:
        if o["key"] in keys and (cfg[o["key"]] == old[o["key"]] or cfg[o["key"]] not in choices_for(o, cfg)):
            cfg[o["key"]] = default_of(o, cfg)


def model_info(cfg):
    """MODELS[model], with the TP=1 form's packs / container / download folded in."""
    m = dict(MODELS[cfg["model"]])
    if cfg.get("tp") == "1" and "tp1" in m:
        m.update(m["tp1"])
    m.setdefault("fetch", cfg["model"])
    return m


def default_cfg(model="27b"):
    cfg = {"model": model, "tp": "2"}
    for o in OPTIONS:
        cfg[o["key"]] = o["default"]
    return cfg


# --------------------------------------------------------------------------------------------
# The shared config (~/.config/saber/config.toml, the console's store)
# --------------------------------------------------------------------------------------------

PRESET_OF = {"27b": "qwen27b", "flashnext": "flashnext"}
MODEL_OF = {v: k for k, v in PRESET_OF.items()}
DEFAULT_NVME = "/mnt/nvme"


def _off(f):
    """An on/off flag's option value: off is the string "off" or a bare false (a toggle)."""
    return f is False or str(f) == "off"


def _flag_rules():
    """(option key, flag, to_flag(value, cfg) -> flag value or None = no override,
    from_flag(flag value) -> option value). Only these flags are owned (read and written) by this
    tool. An absent flag is the preset's own value: the option's default (at TP=1, the single-card
    default, which the console's TP=1 preset carries itself)."""
    def at_default(key):
        def to(v, c):
            o = next(o for o in OPTIONS if o["key"] == key)
            return None if str(v) == str(default_of(o, c)) else int(v)
        return to
    return [
        # the engine's prefix caching is ON by default: off must be written, on needs nothing
        ("prefix", "--enable-prefix-caching", lambda v, c: None if v else "off", lambda f: not _off(f)),
        ("vision27", "--vision", lambda v, c: None if v == "off" else v, str),
        ("ctx27", "--engine-max-ctx", at_default("ctx27"), str),
        ("seqs", "--engine-max-seqs", at_default("seqs"), str),
        ("visionfn", "--fn-vision", lambda v, c: None if v == "lazy" else v, str),
        ("thinking", "--fn-thinking", lambda v, c: None if v else "off", lambda f: not _off(f)),
        ("ptree", "--fn-prefix-tree", lambda v, c: None if v else "off", lambda f: not _off(f)),
        ("ctxfn", "--fn-max-ctx", lambda v, c: None if str(v) == "262144" else int(v), str),
    ]


# Config version 4 wrote the 27B on one card as flag overrides of the TP=2 preset (these, plus the
# -tp1 packs). Version 5 has `engine.tp` / `engine.device`: the console's TP=1 preset carries the
# launcher's single-card boot itself, so a save drops these overrides (the console migrates them
# the same way when it reads a version-4 file).
TP1_LEGACY = ("--engine-tp", "--engine-device", "--engine-peer-device", "--engine-decode-batches")


def _legacy_tp1(flags):
    return str(flags.get("--engine-tp", "2")) == "1"


def tp_of(doc):
    """(tp, device) of a parsed config.toml: engine.tp (version 5), else a version-4 file's
    `--engine-tp 1` overrides."""
    eng = doc.get("engine", {})
    flags = eng.get("flags", {})
    if eng.get("preset", "flashnext") != "qwen27b":
        return "2", "0"
    if "tp" in eng:
        return str(eng["tp"]), str(eng.get("device", 0))
    if _legacy_tp1(flags):
        return "1", str(flags.get("--engine-device", 0))
    return "2", "0"


def cfg_from_console(doc, base=None):
    """The wizard's settings from a parsed config.toml (the console's)."""
    cfg = dict(base or default_cfg())
    eng = doc.get("engine", {})
    setup = doc.get("setup", {})
    model = setup.get("model") if setup.get("model") in MODELS else MODEL_OF.get(eng.get("preset", "flashnext"))
    if model:
        cfg["model"] = model
    flags = eng.get("flags", {})
    tp, dev = tp_of(doc)
    cfg["tp"] = tp if cfg["model"] == "27b" else "2"
    if cfg["tp"] == "1":
        cfg["gpu1"] = dev
    for key, flag, _to, frm in _flag_rules():
        o = next(o for o in OPTIONS if o["key"] == key)
        if cfg["model"] not in o["models"]:
            continue
        cfg[key] = frm(flags[flag]) if flag in flags else default_of(o, cfg)
    cfg["routes"] = "--fn-route-record" in flags
    if "port" in eng:
        cfg["port"] = str(eng["port"])
    nvme = eng.get("paths", {}).get("nvme")
    if nvme:
        cfg["packs"] = nvme.rstrip("/") + "/saber-packs"
    return cfg


def console_from_cfg(cfg, doc=None):
    """Write the wizard's settings into a config.toml document (a dict), touching only the keys
    this tool owns. Returns (doc, notes)."""
    doc = json.loads(json.dumps(doc or {}))  # a deep copy
    notes = []
    doc["version"] = max(int(doc.get("version", CONSOLE_CONFIG_VERSION)), CONSOLE_CONFIG_VERSION)
    eng = doc.setdefault("engine", {})
    preset = PRESET_OF[cfg["model"]]
    if eng.get("preset", "flashnext") != preset:
        # another subcommand: the old overrides belong to the other flag set (the console does the same)
        eng["flags"] = {}
        eng["extra_args"] = []
    eng["preset"] = preset
    eng["runtime"] = "container"
    eng["port"] = int(cfg["port"])
    flags = eng.setdefault("flags", {})
    tp1 = cfg["model"] == "27b" and cfg.get("tp") == "1"
    legacy = cfg["model"] == "27b" and "tp" not in eng and _legacy_tp1(flags)
    if cfg["model"] == "27b":
        eng["tp"] = 1 if tp1 else 2
        eng["device"] = int(cfg.get("gpu1", "0")) if tp1 else 0
    else:
        eng["tp"] = 2
        eng.pop("device", None)
    if legacy or (cfg["model"] == "27b" and not tp1):
        # a version-4 file's single-card overrides, or a switch back to TP=2: the TP's preset
        # names its own packs, batches and cards (a pack the console picked for this TP stays)
        if legacy:
            for f in TP1_LEGACY:
                flags.pop(f, None)
        for f in ("--pack", "--engine-draft-pack"):
            if str(flags.get(f, "")).endswith("-tp1") and (legacy or not tp1):
                flags.pop(f)
    for key, flag, to, _frm in _flag_rules():
        o = next(o for o in OPTIONS if o["key"] == key)
        if cfg["model"] not in o["models"]:
            continue
        v = to(cfg[key], cfg)
        if v is None:
            flags.pop(flag, None)
        else:
            flags[flag] = v
    paths = eng.setdefault("paths", {})
    if cfg["model"] == "27b":
        packs = str(cfg["packs"]).rstrip("/")
        if os.path.basename(packs) == "saber-packs":
            nvme = os.path.dirname(packs)
            if nvme != DEFAULT_NVME or "nvme" in paths:
                paths["nvme"] = nvme
        else:
            notes.append(f"the console reads packs from <nvme>/saber-packs; {packs} is not named saber-packs, "
                         "so the console keeps its NVMe path (the launcher still uses SABER_PACKS)")
    nvme = paths.get("nvme", DEFAULT_NVME)
    if cfg["model"] == "flashnext" and cfg.get("routes"):
        flags["--fn-route-record"] = nvme.rstrip("/") + "/saber-kv/routes"
    else:
        flags.pop("--fn-route-record", None)
    if not flags:
        eng.pop("flags", None)
    if not paths:
        eng.pop("paths", None)
    setup = doc.setdefault("setup", {})
    setup["model"] = cfg["model"]
    setup["completed"] = True
    setup["step"] = "done"
    return doc, notes


def _toml_key(k):
    import re
    return k if re.fullmatch(r"[A-Za-z0-9_-]+", k) else json.dumps(k)


def _toml_val(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, list):
        return "[" + ", ".join(_toml_val(x) for x in v) + "]"
    raise TypeError(f"cannot write {type(v).__name__} to TOML")


def dump_toml(doc):
    """A small TOML writer for the console's config shape: scalars, arrays of scalars, tables and
    arrays of tables."""
    out = []

    def is_aot(v):
        return isinstance(v, list) and v and all(isinstance(x, dict) for x in v)

    def table(d, path):
        scal = [(k, v) for k, v in d.items() if not isinstance(v, dict) and not is_aot(v)]
        subs = [(k, v) for k, v in d.items() if isinstance(v, dict)]
        aots = [(k, v) for k, v in d.items() if is_aot(v)]
        if path and (scal or not (subs or aots)):
            out.append(f"\n[{'.'.join(_toml_key(p) for p in path)}]")
        for k, v in scal:
            out.append(f"{_toml_key(k)} = {_toml_val(v)}")
        for k, v in subs:
            table(v, path + [k])
        for k, v in aots:
            for item in v:
                out.append(f"\n[[{'.'.join(_toml_key(p) for p in path + [k])}]]")
                for k2, v2 in item.items():
                    out.append(f"{_toml_key(k2)} = {_toml_val(v2)}")

    table(doc, [])
    return "\n".join(out).lstrip("\n") + "\n"


def read_console(path=None):
    """The parsed config.toml, or None when there is none."""
    import tomllib
    path = path or CONSOLE_CONF
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        return None


def write_console(doc, path=None):
    """Atomic, owner-only (the file can hold the console's admin token and API keys); the previous
    file is kept as config.toml.prev, like the console's own save."""
    path = path or CONSOLE_CONF
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(dump_toml(doc))
    if os.path.exists(path):
        shutil.copyfile(path, path[: -len(".toml")] + ".toml.prev" if path.endswith(".toml") else path + ".prev")
    os.replace(tmp, path)


def load_legacy(path=None):
    """The pre-console setup.json, as wizard settings (or None)."""
    cfg = default_cfg()
    try:
        with open(path or CONF) as f:
            saved = json.load(f)
    except (OSError, ValueError):
        return None
    for k, v in saved.items():
        if (k == "model" and v in MODELS) or (k == "tp" and v in ("1", "2")) or (k not in ("model", "tp") and k in cfg):
            cfg[k] = v
    if cfg["model"] != "27b":
        cfg["tp"] = "2"
    return cfg


def load_cfg():
    """config.toml when it exists, else a legacy setup.json, else the defaults."""
    doc = read_console()
    if doc is not None:
        return cfg_from_console(doc)
    return load_legacy() or default_cfg()


def save_cfg(cfg):
    """Write the shared config.toml (migrating setup.json the first time: its settings ARE cfg)."""
    doc, notes = console_from_cfg(cfg, read_console())
    write_console(doc)
    for n in notes:
        print("note: " + n)
    return CONSOLE_CONF


