From: Saber <noreply@invalid>
Date: Wed, 7 Oct 2026 17:25:00 -0500
Subject: [PATCH] drm/amdgpu: register a reserved VRAM range as a PCI P2PDMA provider (amdgpu.p2pmem_mb)

Local patch for a 7.1.3-p2p kernel (Saber), not for upstream as is.

amdgpu.p2pmem_mb=N (default 0 = off, no behaviour change) reserves N MiB of CPU-visible VRAM
per dGPU at init as one pinned, contiguous device BO (2 MiB aligned), registers that BAR 0 range
with pci_p2pdma_add_resource() and publishes it (pci_p2pmem_publish). User space:
  * the peer side: mmap /sys/bus/pci/devices/<bdf>/p2pmem/allocate (the WHOLE pool, MAP_SHARED,
    offset 0) -> P2PDMA struct pages; an O_DIRECT read into that mapping pins them with
    FOLL_PCI_P2PDMA and the NVMe controller DMAs straight into VRAM through the BAR;
  * the GPU side: DRM_IOCTL_AMDGPU_GEM_CREATE with in.domain_flags = AMDGPU_GEM_CREATE_P2PMEM_LOCAL
    (1 << 48) and in.bo_size 0 (or the pool size) returns a handle to the same BO (nothing is
    allocated) -> DRM_IOCTL_PRIME_HANDLE_TO_FD -> KFD import (hsa_amd_interop_map_buffer,
    hipImportExternalMemory).
One whole-pool mapping takes the pool's single genalloc chunk from its start, so mapping
offset x is BO offset x. APUs, app-APUs and SR-IOV VFs are skipped (the 9900X iGPU stays off).
KFD's VRAM limit already subtracts pinned VRAM (vram_pin_size), so ROCr reports N MiB less.

Files: amdgpu_drv.c (param + DOC), amdgpu.h (extern), amdgpu_ttm.h (mman field, prototype),
amdgpu_ttm.c (init/fini/handle), amdgpu_gem.h (flag), amdgpu_gem.c (ioctl hook).
---
diff -urN a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c	2026-07-04 06:45:09.000000000 -0500
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c	2026-10-07 17:22:22.839910418 -0500
@@ -285,6 +285,19 @@
 module_param_named(vis_vramlimit, amdgpu_vis_vram_limit, int, 0444);
 
 /**
+ * DOC: p2pmem_mb (uint)
+ * Local patch (Saber FN71, not upstream). Reserve this many MiB of CPU-visible VRAM per dGPU at
+ * init (one pinned, contiguous BO that TTM never hands out), register it as a PCI P2PDMA provider
+ * (pci_p2pdma_add_resource + pci_p2pmem_publish) so a peer (an NVMe O_DIRECT read) can DMA into
+ * it through /sys/bus/pci/devices/<bdf>/p2pmem/allocate, and give user space a GEM handle to the
+ * same BO (AMDGPU_GEM_CREATE_P2PMEM_LOCAL) for the GPU side (PRIME export -> KFD import).
+ * The default 0 is off: no reservation, no registration, no behaviour change.
+ */
+unsigned int amdgpu_p2pmem_mb;
+MODULE_PARM_DESC(p2pmem_mb, "VRAM in MiB per dGPU registered as a PCI P2PDMA provider (0 = off, default)");
+module_param_named(p2pmem_mb, amdgpu_p2pmem_mb, uint, 0444);
+
+/**
  * DOC: gartsize (uint)
  * Restrict the size of GART (for kernel use) in Mib (32, 64, etc.) for testing.
  * The default is -1 (The size depends on asic).
diff -urN a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c	2026-07-04 06:45:09.000000000 -0500
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c	2026-10-07 17:22:22.870910298 -0500
@@ -413,6 +413,18 @@
 	uint32_t handle, initial_domain;
 	int r;
 
+	/* FN71 (local): a handle to the p2pmem BO, nothing allocated */
+	if (flags & AMDGPU_GEM_CREATE_P2PMEM_LOCAL) {
+		if (flags != AMDGPU_GEM_CREATE_P2PMEM_LOCAL)
+			return -EINVAL;
+		r = amdgpu_ttm_p2pmem_gem_handle(adev, filp, args->in.bo_size, &handle);
+		if (r)
+			return r;
+		memset(args, 0, sizeof(*args));
+		args->out.handle = handle;
+		return 0;
+	}
+
 	/* reject invalid gem flags */
 	if (flags & ~AMDGPU_GEM_CREATE_SETTABLE_MASK)
 		return -EINVAL;
diff -urN a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.h
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.h	2026-07-04 06:45:09.000000000 -0500
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.h	2026-10-07 17:22:22.865910317 -0500
@@ -73,6 +73,15 @@
 int amdgpu_gem_metadata_ioctl(struct drm_device *dev, void *data,
 				struct drm_file *filp);
 
+/*
+ * FN71 (local patch, not upstream uapi): GEM_CREATE with this domain flag creates nothing; it
+ * returns a handle to the device's p2pmem BO (amdgpu.p2pmem_mb), whose VRAM is the PCI P2PDMA
+ * pool behind /sys/bus/pci/devices/<bdf>/p2pmem/allocate. in.bo_size must be 0 or the pool's
+ * size; -ENODEV when the parameter is 0. Not in the settable mask: an ordinary create with this
+ * bit never reaches the allocator.
+ */
+#define AMDGPU_GEM_CREATE_P2PMEM_LOCAL	(1ULL << 48)
+
 #define AMDGPU_GEM_CREATE_SETTABLE_MASK	(AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED | \
 	AMDGPU_GEM_CREATE_NO_CPU_ACCESS | \
 	AMDGPU_GEM_CREATE_CPU_GTT_USWC | \
diff -urN a/drivers/gpu/drm/amd/amdgpu/amdgpu.h b/drivers/gpu/drm/amd/amdgpu/amdgpu.h
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu.h	2026-07-04 06:45:09.000000000 -0500
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu.h	2026-10-07 17:22:22.848910383 -0500
@@ -161,6 +161,7 @@
 extern int amdgpu_modeset;
 extern unsigned int amdgpu_vram_limit;
 extern int amdgpu_vis_vram_limit;
+extern unsigned int amdgpu_p2pmem_mb;
 extern int amdgpu_gart_size;
 extern int amdgpu_gtt_size;
 extern int amdgpu_moverate;
diff -urN a/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c	2026-07-04 06:45:09.000000000 -0500
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.c	2026-10-07 17:23:13.299814336 -0500
@@ -41,6 +41,7 @@
 #include <linux/dma-buf.h>
 #include <linux/sizes.h>
 #include <linux/module.h>
+#include <linux/pci-p2pdma.h>
 
 #include <drm/drm_drv.h>
 #include <drm/ttm/ttm_bo.h>
@@ -2063,6 +2064,149 @@
  * VRAM (on-board memory), and on-chip memories (GDS, GWS, OA) which
  * can be mapped per VMID.
  */
+/*
+ * FN71 (local patch, not upstream): VRAM as a PCI P2PDMA provider.
+ *
+ * amdgpu.p2pmem_mb=N reserves N MiB (rounded up to 2 MiB) of CPU-visible VRAM as ONE pinned,
+ * contiguous device BO that TTM never moves or hands out, then registers exactly that BAR 0 range
+ * with the PCI P2PDMA core (ZONE_DEVICE MEMORY_DEVICE_PCI_P2PDMA struct pages, a genalloc pool)
+ * and publishes it. User space gets P2PDMA pages by mmapping
+ * /sys/bus/pci/devices/<bdf>/p2pmem/allocate (an O_DIRECT read into that mapping pins them with
+ * FOLL_PCI_P2PDMA and the NVMe controller writes VRAM through the BAR), and the GPU side through
+ * GEM_CREATE(AMDGPU_GEM_CREATE_P2PMEM_LOCAL) -> PRIME export -> KFD import of the same BO. A
+ * single mmap of the WHOLE pool takes the pool's only chunk from its start, so mapping offset x
+ * is BO offset x. 0 (the default) = nothing happens.
+ *
+ * Teardown: the BO is unpinned in amdgpu_ttm_fini, before the devres-managed pages go; unbinding
+ * the driver while a process still maps the pool is unsupported (the pool's sysfs file is
+ * removed, which zaps user mappings, only at devres release).
+ */
+static void amdgpu_ttm_p2pmem_init(struct amdgpu_device *adev)
+{
+	struct amdgpu_res_cursor cursor;
+	struct amdgpu_bo_param bp;
+	struct amdgpu_bo_user *ubo;
+	struct amdgpu_bo *bo = NULL;
+	u64 size, vram_off, bar_off;
+	int r;
+
+	if (!amdgpu_p2pmem_mb)
+		return;
+
+	if (!IS_ENABLED(CONFIG_PCI_P2PDMA) || !adev->pdev || (adev->flags & AMD_IS_APU) ||
+	    adev->gmc.is_app_apu || amdgpu_sriov_vf(adev)) {
+		dev_info(adev->dev, "p2pmem: %u MiB asked, not a supported dGPU; off\n",
+			 amdgpu_p2pmem_mb);
+		return;
+	}
+
+	size = ALIGN((u64)amdgpu_p2pmem_mb << 20, SZ_2M);
+	if (size > adev->gmc.visible_vram_size / 2) {
+		dev_warn(adev->dev,
+			 "p2pmem: %llu MiB asked, more than half of the %llu MiB CPU-visible VRAM; off\n",
+			 size >> 20, adev->gmc.visible_vram_size >> 20);
+		return;
+	}
+
+	memset(&bp, 0, sizeof(bp));
+	bp.size = size;
+	bp.byte_align = SZ_2M;	/* memremap_pages works in 2 MiB subsections */
+	bp.domain = AMDGPU_GEM_DOMAIN_VRAM;
+	bp.flags = AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED | AMDGPU_GEM_CREATE_VRAM_CONTIGUOUS;
+	bp.type = ttm_bo_type_device;	/* gets an mmap offset: KFD import + ROCr CPU map */
+	bp.resv = NULL;
+
+	/* a USER bo: a GEM handle reaches the user-BO ioctls (metadata, tiling) */
+	r = amdgpu_bo_create_user(adev, &bp, &ubo);
+	if (r)
+		goto fail;
+	bo = &ubo->bo;
+	r = amdgpu_bo_reserve(bo, false);
+	if (r)
+		goto fail_unref;
+	r = amdgpu_bo_pin(bo, AMDGPU_GEM_DOMAIN_VRAM);
+	amdgpu_bo_unreserve(bo);
+	if (r)
+		goto fail_unref;
+
+	r = -EINVAL;
+	if (bo->tbo.resource->mem_type != TTM_PL_VRAM)
+		goto fail_unpin;
+	/* contiguous in fact, not only by flag: every block follows the previous one */
+	amdgpu_res_first(bo->tbo.resource, 0, size, &cursor);
+	vram_off = cursor.start;
+	while (cursor.remaining) {
+		if (cursor.start != vram_off + (size - cursor.remaining))
+			goto fail_unpin;
+		amdgpu_res_next(&cursor, cursor.size);
+	}
+	if (!IS_ALIGNED(vram_off, SZ_2M) || vram_off + size > adev->gmc.visible_vram_size)
+		goto fail_unpin;
+
+	/* the BAR maps VRAM linearly from aper_base (amdgpu_ttm_io_mem_reserve) */
+	bar_off = adev->gmc.aper_base + vram_off - pci_resource_start(adev->pdev, 0);
+	if (bar_off + size > pci_resource_len(adev->pdev, 0))
+		goto fail_unpin;
+
+	r = pci_p2pdma_add_resource(adev->pdev, 0, size, bar_off);
+	if (r)
+		goto fail_unpin;
+	pci_p2pmem_publish(adev->pdev, true);
+	adev->mman.p2pmem_bo = bo;
+
+	dev_info(adev->dev,
+		 "p2pmem: %llu MiB of VRAM at 0x%llx (BAR0 + 0x%llx) is a PCI P2PDMA provider, published\n",
+		 size >> 20, vram_off, bar_off);
+	return;
+
+fail_unpin:
+	if (!amdgpu_bo_reserve(bo, true)) {
+		amdgpu_bo_unpin(bo);
+		amdgpu_bo_unreserve(bo);
+	}
+fail_unref:
+	amdgpu_bo_unref(&bo);
+fail:
+	dev_warn(adev->dev, "p2pmem: %u MiB asked, registration failed (%d); off\n",
+		 amdgpu_p2pmem_mb, r);
+}
+
+static void amdgpu_ttm_p2pmem_fini(struct amdgpu_device *adev)
+{
+	struct amdgpu_bo *bo = adev->mman.p2pmem_bo;
+
+	if (!bo)
+		return;
+	pci_p2pmem_publish(adev->pdev, false);
+	if (!amdgpu_bo_reserve(bo, true)) {
+		amdgpu_bo_unpin(bo);
+		amdgpu_bo_unreserve(bo);
+	}
+	amdgpu_bo_unref(&adev->mman.p2pmem_bo);
+}
+
+/**
+ * amdgpu_ttm_p2pmem_gem_handle - a GEM handle to the p2pmem BO (FN71, local)
+ * @adev: amdgpu device
+ * @filp: the caller's DRM file
+ * @bo_size: 0, or the pool's size (a check, nothing is allocated)
+ * @handle: the new handle
+ *
+ * Returns 0, -ENODEV when amdgpu.p2pmem_mb is 0 (or registration failed), -EINVAL on a size
+ * mismatch.
+ */
+int amdgpu_ttm_p2pmem_gem_handle(struct amdgpu_device *adev, struct drm_file *filp,
+				 u64 bo_size, u32 *handle)
+{
+	struct amdgpu_bo *bo = adev->mman.p2pmem_bo;
+
+	if (!bo)
+		return -ENODEV;
+	if (bo_size && bo_size != amdgpu_bo_size(bo))
+		return -EINVAL;
+	return drm_gem_handle_create(filp, &bo->tbo.base, handle);
+}
+
 int amdgpu_ttm_init(struct amdgpu_device *adev)
 {
 	uint64_t gtt_size;
@@ -2223,6 +2367,8 @@
 		drm_warn(adev_to_drm(adev),
 				"Debug VRAM access will use slowpath MM access\n");
 
+	amdgpu_ttm_p2pmem_init(adev);
+
 	return 0;
 }
 
@@ -2236,6 +2382,7 @@
 	if (!adev->mman.initialized)
 		return;
 
+	amdgpu_ttm_p2pmem_fini(adev);
 	amdgpu_ttm_pools_fini(adev);
 
 	amdgpu_ttm_training_reserve_vram_fini(adev);
diff -urN a/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.h
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.h	2026-07-04 06:45:09.000000000 -0500
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_ttm.h	2026-10-07 17:22:49.529303836 -0500
@@ -110,6 +110,11 @@
 	/* PAGE_SIZE'd BO for process memory r/w over SDMA. */
 	struct amdgpu_bo	*sdma_access_bo;
 	void			*sdma_access_ptr;
+
+	/* FN71 (local): the pinned VRAM range registered as a PCI P2PDMA provider
+	 * (amdgpu.p2pmem_mb); NULL when off.
+	 */
+	struct amdgpu_bo	*p2pmem_bo;
 };
 
 struct amdgpu_copy_mem {
@@ -184,6 +189,9 @@
 
 int amdgpu_ttm_init(struct amdgpu_device *adev);
 void amdgpu_ttm_fini(struct amdgpu_device *adev);
+struct drm_file;
+int amdgpu_ttm_p2pmem_gem_handle(struct amdgpu_device *adev, struct drm_file *filp,
+				 u64 bo_size, u32 *handle);
 void amdgpu_ttm_set_buffer_funcs_status(struct amdgpu_device *adev,
 					bool enable);
 int amdgpu_copy_buffer(struct amdgpu_device *adev,
